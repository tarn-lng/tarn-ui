// Tarn UI session on the Tarn GTK backend (backends/linux/gtk/native.tarn).
// Same public API as the C-bridge core/session.tarn; build scripts copy this
// file as core/session.tarn when TARN_UI_BACKEND=tarn.
import "ffi"
import "string"
import "gtk/native"
import "gtk/devtools"

/// A failed UI operation. `code` is the bridge status (bridge.h); `context`
/// names the operation and key, e.g. `add_label "details-text"`.
pub struct Error { pub code i32
    pub context string }

/// An error with context; apps use it for their own failures too.
pub fn fail(code i32, context string) Error { return Error { code: code, context: context } }

/// What the bridge status means.
pub fn Error.reason(&self) string {
    if self.code == 1 { return "invalid input (unknown key, duplicate key, bad parent or value out of range)" }
    if self.code == 2 { return "called off the main thread" }
    if self.code == 3 { return "another UI session is already active" }
    if self.code == 4 { return "no display available" }
    if self.code == 5 { return "native allocation or creation failed" }
    if self.code == 6 { return "the window is closed" }
    if self.code == 7 { return "the native bridge has a different ABI version; rebuild the bridge and the app together" }
    if self.code == 8 { return "the event queue is full" }
    if self.code == 10 { return "limit reached" }
    return "application error " + string.from_i64(i64(self.code))
}

/// `context: reason`, or the reason alone.
pub fn Error.message(&self) string {
    if self.context.is_empty() { return self.reason() }
    return self.context.clone() + ": " + self.reason()
}
pub enum Event {
    Opened
    Closed
    Increment
}
pub enum Action { Opened
    Closed
    Activate(u32)
    /// Background mode only: the user closed the window and it was hidden.
    Hidden
    /// A watched descriptor became ready (coalesced); see watch_fd.
    Wake }
pub struct Session { native native.Native
    dev devtools.Devtools
    watches Vec<u32> }

extern "C" fn g_unix_fd_add_full(priority i32, fd i32, condition u32, function *u8, data *mut u8, notify *mut u8) u32
extern "C" fn g_source_remove(id u32) i32

// Requires the process main thread and no nested UI session. Native allocation
// failure, ordinary return and body errors all clean up. Abort/exit do not unwind.
pub unsafe fn run(title string, heading string,
    body mut fn(&mut Session) Result<void, Error>) Result<void, Error> {
    if native.abi() != 14 { return Err(fail(7, "backend ABI " + native.abi().to_string() + ", expected 14")) }
    if ffi.CString.new(&title).is_none() || ffi.CString.new(&heading).is_none() { return Err(fail(1, "text contains a NUL byte")) }
    ui := match native.create(&title, &heading) {
        Ok(value) => value
        Err(status) => { return Err(fail(status, "create window")) }
    }
    var session = Session { native: ui, dev: devtools.new(), watches: Vec.new() }
    result := body(&mut session)
    // Watches carry the native block; remove them before it is freed.
    session.unwatch_all()
    var code: i32 = 0
    match &result {
        Ok(_) => {}
        Err(error) => { code = error.code }
    }
    window_closed := session.native.is_closed()
    status := session.native.finish()
    session.dev.dispose(&mut session.native, window_closed, code)
    if status != 0 { return Err(fail(status, "finish")) }
    return result
}

// The next native event, serving the devtools channel while waiting.
fn Session.next(&mut self) i32 {
    for true {
        if self.dev.pump(&mut self.native) { continue }
        event := self.native.poll()
        if event == 4 { self.dev.hidden() }
        if event != 0 { return event }
        self.native.iterate()
    }
    return -1
}

pub fn Session.next_event(&mut self) Result<Event, Error> {
    var event = self.next()
    // Hidden and Wake only exist for apps that opt in through Action.
    for event == 4 || event == 5 { event = self.next() }
    if event == 1 { return Ok(Event.Opened) }
    if event == 2 { return Ok(Event.Closed) }
    if event == 3 { return Ok(Event.Increment) }
    if event > 0 { return Err(fail(1, "next_event")) }
    return Err(fail(-event, "next_event"))
}

pub fn Session.next_action(&mut self) Result<Action, Error> {
    event := self.next()
    if event == 1 { return Ok(Action.Opened) }
    if event == 2 { return Ok(Action.Closed) }
    if event == 4 { return Ok(Action.Hidden) }
    if event == 5 { return Ok(Action.Wake) }
    if event >= 1001 && event <= 2024 { return Ok(Action.Activate(u32(event - 1000))) }
    if event > 0 { return Err(fail(1, "next_action")) }
    return Err(fail(-event, "next_action"))
}

// Names the failed operation and its key in the error (`set_text "summary"`).
fn checked_at(status i32, op &string, key &string) Result<void, Error> {
    if status == 0 { return Ok(()) }
    if key.is_empty() { return Err(fail(status, op.clone())) }
    return Err(fail(status, op.clone() + " \"" + key + "\""))
}
fn checked(status i32, op &string) Result<void, Error> { return checked_at(status, op, &"") }

pub fn Session.add_page(&mut self, key string) Result<void, Error> { return checked_at(self.native.add_page(&key), &"add_page", &key) }
pub fn Session.add_label(&mut self, page string, key string, text string) Result<void, Error> {
    return checked_at(self.native.add_label(&page, &key, &text), &"add_label", &key)
}
pub fn Session.add_button(&mut self, page string, key string, text string, action u32) Result<void, Error> {
    return checked_at(self.native.add_button(&page, &key, &text, action), &"add_button", &key)
}
pub fn Session.set_text(&mut self, key string, text string) Result<void, Error> {
    return checked_at(self.native.set_text(&key, &text), &"set_text", &key)
}
// The first presentation starts the devtools channel in dev builds.
pub fn Session.show_page(&mut self, key string) Result<void, Error> {
    first := !self.native.pages_presented()
    try checked_at(self.native.show_page(&key), &"show_page", &key)
    if first { return checked(self.dev.start(&self.native), &"show_page") }
    return Ok(())
}
pub fn Session.add_box(&mut self, parent string, key string, horizontal bool, spacing u32) Result<void, Error> {
    return checked_at(self.native.add_box(&parent, &key, horizontal, spacing), &"add_box", &key)
}
pub fn Session.add_text(&mut self, parent string, key string, text string, style u32) Result<void, Error> {
    return checked_at(self.native.add_text(&parent, &key, &text, style), &"add_text", &key)
}
pub fn Session.set_primary(&mut self, key string, primary bool) Result<void, Error> {
    return checked_at(self.native.set_primary(&key, primary), &"set_primary", &key)
}
pub fn Session.set_accessible(&mut self, key string, label string, description string) Result<void, Error> {
    return checked_at(self.native.set_accessible(&key, &label, &description), &"set_accessible", &key)
}
pub fn Session.focus(&mut self, key string) Result<void, Error> { return checked_at(self.native.focus(&key), &"focus", &key) }
pub fn Session.enable_counter(&mut self, value i64) Result<void, Error> {
    try checked(self.native.enable_counter(value), &"enable_counter")
    return checked(self.dev.start(&self.native), &"enable_counter")
}
pub fn Session.set_counter(&mut self, value i64) Result<void, Error> { return checked(self.native.set_counter(value), &"set_counter") }
pub fn Session.set_heading(&mut self, text string) Result<void, Error> { return checked(self.native.set_heading(&text), &"set_heading") }
pub fn Session.request_close(&mut self) Result<void, Error> { return checked(self.native.request_close(), &"request_close") }

// Acknowledge only after the application handler has applied its owned state.
pub fn Session.complete_event(&mut self) Result<void, Error> {
    token := self.native.dispatched_token()
    status := self.native.complete_event(0)
    self.dev.complete(token, status)
    return checked(status, &"complete_event")
}

pub fn Session.add_entry(&mut self, parent string, key string, text string, action u32) Result<void, Error> {
    return checked_at(self.native.add_entry(&parent, &key, &text, action), &"add_entry", &key)
}
pub fn Session.event_text(&self) Result<string, Error> { return self.native.event_text().ok_or(fail(6, "event_text")) }
pub fn Session.set_enabled(&mut self, key string, enabled bool) Result<void, Error> {
    return checked_at(self.native.set_enabled(&key, enabled), &"set_enabled", &key)
}
pub fn Session.set_input(&mut self, key string, text string) Result<void, Error> {
    return checked_at(self.native.set_input(&key, &text), &"set_input", &key)
}
pub fn Session.list_begin(&mut self, parent string, count u32) Result<void, Error> {
    return checked_at(self.native.list_begin(&parent, count), &"list_begin", &parent)
}
pub fn Session.list_item(&mut self, key string, text string, action u32) Result<void, Error> {
    return checked_at(self.native.list_item(&key, &text, action), &"list_item", &key)
}
pub fn Session.list_end(&mut self) Result<void, Error> { return checked(self.native.list_end(), &"list_end") }
pub fn Session.tree_begin(&mut self, key string, count u32) Result<void, Error> {
    return checked_at(self.native.tree_begin(&key, count), &"tree_begin", &key)
}
pub fn Session.tree_node(&mut self, parent string, key string, kind u32, text string, action u32, spacing u32) Result<void, Error> {
    return checked_at(self.native.tree_node(&parent, &key, kind, &text, action, spacing), &"tree_node", &key)
}
pub fn Session.tree_end(&mut self) Result<void, Error> { return checked(self.native.tree_end(), &"tree_end") }
// Form controls: switch=0, check=1, scale=2, spin=3, dropdown=4. Changes carry
// the new value as decimal event text; set_input writes a decimal model value.
pub fn Session.add_control(&mut self, parent string, key string, kind u32, text string,
    action u32, value i64, min i64, max i64) Result<void, Error> {
    return checked_at(self.native.add_control(&parent, &key, kind, &text, action, value, min, max), &"add_control", &key)
}

/// Background mode: closing the window hides it (Action.Hidden) instead of
/// ending the session. request_close still ends it. Enable it only when the
/// app stays reachable, for example through a tray icon.
pub fn Session.set_background(&mut self, enabled bool) Result<void, Error> {
    return checked(self.native.set_background(enabled), &"set_background")
}
/// Shows and raises the window, also after it was hidden.
pub fn Session.present(&mut self) Result<void, Error> { return checked(self.native.present(), &"present") }
/// Hides the window without ending the session or queuing Hidden.
pub fn Session.hide(&mut self) Result<void, Error> { return checked(self.native.hide(), &"hide") }
pub fn Session.is_visible(&self) Result<bool, Error> {
    status := self.native.is_visible()
    if status < 0 { return Err(fail(-status, "is_visible")) }
    return Ok(status == 1)
}

// GLib calls this on the main thread while next_action iterates the loop. It
// only sets the session's coalesced wake flag; the app reads the descriptor.
fn descriptor_ready(fd i32, condition u32, data *mut u8) i32 {
    native.wake(data)
    return 1
}

/// Queues Action.Wake whenever `fd` is readable, has hung up or failed. The
/// app then reads it without blocking (for D-Bus: Connection.dispatch). The
/// watch ends with unwatch_fd or when run returns; `fd` must stay open until
/// then.
pub fn Session.watch_fd(&mut self, fd i32) Result<u32, Error> {
    if fd < 0 { return Err(fail(1, "watch_fd: negative descriptor")) }
    // G_IO_IN | G_IO_ERR | G_IO_HUP
    var id: u32 = 0
    unsafe { id = g_unix_fd_add_full(0, fd, u32(1 | 8 | 16), ffi.callback(descriptor_ready), self.native.wake_data(), ffi.null()) }
    if id == 0 { return Err(fail(5, "watch_fd")) }
    self.watches.push(id)
    return Ok(id)
}

pub fn Session.unwatch_fd(&mut self, id u32) Result<void, Error> {
    var index: usize = 0
    for index < self.watches.len() {
        if self.watches.get(index) == id {
            self.watches.swap_remove(index)
            unsafe { removed := g_source_remove(id) }
            return Ok(())
        }
        index = index + 1
    }
    return Err(fail(1, "unwatch_fd: not a watch of this session"))
}

fn Session.unwatch_all(&mut self) {
    for id in &self.watches {
        unsafe { removed := g_source_remove(id) }
    }
    self.watches = Vec.new()
}

pub fn Session.add_container(&mut self, parent string, key string, kind u32, title string, action u32, value i64) Result<void, Error> {
    return checked_at(self.native.add_container(&parent, &key, kind, &title, action, value), &"add_container", &key)
}
/// Multiline text: each edit arrives as the action with the full text.
pub fn Session.add_text_area(&mut self, parent string, key string, text string, action u32, lines u32) Result<void, Error> {
    return checked_at(self.native.add_text_area(&parent, &key, &text, action, lines), &"add_text_area", &key)
}
/// Replaces the title bar with a header bar; an empty subtitle shows only the title.
pub fn Session.set_header(&mut self, subtitle string) Result<void, Error> { return checked(self.native.set_header(&subtitle), &"set_header") }
/// A header button; with an icon name the text becomes its tooltip and accessible name.
pub fn Session.add_header_button(&mut self, key string, text string, icon string, action u32, end bool) Result<void, Error> {
    return checked_at(self.native.add_header_button(&key, &text, &icon, action, end), &"add_header_button", &key)
}
/// An entry in the header's main menu. Keys use ASCII letters, digits and '-'.
pub fn Session.add_menu_item(&mut self, key string, text string, action u32) Result<void, Error> {
    return checked_at(self.native.add_menu_item(&key, &text, action), &"add_menu_item", &key)
}
pub fn Session.tree_control(&mut self, parent string, key string, kind u32, text string, action u32,
    value i64, min i64, max i64) Result<void, Error> {
    return checked_at(self.native.tree_control(&parent, &key, kind, &text, action, value, min, max), &"tree_control", &key)
}
pub fn Session.tree_container(&mut self, parent string, key string, kind u32, title string, action u32, value i64) Result<void, Error> {
    return checked_at(self.native.tree_container(&parent, &key, kind, &title, action, value), &"tree_container", &key)
}
pub fn Session.tree_text_area(&mut self, parent string, key string, text string, action u32, lines u32) Result<void, Error> {
    return checked_at(self.native.tree_text_area(&parent, &key, &text, action, lines), &"tree_text_area", &key)
}
