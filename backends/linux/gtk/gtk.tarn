// GTK 4, GObject and GLib declarations used by the Tarn backend. No logic.
// Every pointer is opaque; GObject instances are all `*mut Widget` because
// the backend only passes them back to the functions that created them.
// Link with: --link gtk-4 --link gobject-2.0 --link gio-2.0 --link glib-2.0

pub struct Widget {}
pub struct Queue {}

// Enum values from the GTK 4 headers (checked against GTK 4.20).
pub const ROLE_HEADING i32 = 19
pub const PROPERTY_DESCRIPTION i32 = 1
pub const PROPERTY_LABEL i32 = 4
pub const PROPERTY_LEVEL i32 = 5
pub const TYPE_INT usize = 24
pub const TYPE_STRING usize = 64
pub const GVALUE_SIZE usize = 24
pub const WRAP_WORD_CHAR i32 = 2
pub const POLICY_AUTOMATIC i32 = 1
pub const POLICY_NEVER i32 = 2
pub const TRANSITION_NONE i32 = 0
pub const ORIENTATION_HORIZONTAL i32 = 0
pub const ORIENTATION_VERTICAL i32 = 1
pub const ALIGN_CENTER i32 = 3
pub const LEVEL_BAR_MODE_CONTINUOUS i32 = 0
// GtkWrapMode (text views), unlike WRAP_WORD_CHAR (PangoWrapMode, labels).
pub const TEXT_WRAP_WORD_CHAR i32 = 3
pub const RELATION_LABELLED_BY i32 = 10
pub const TEXT_ITER_SIZE usize = 80

