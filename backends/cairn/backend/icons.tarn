// Pure-Tarn Vector Icon & Cairn Brand Mark Rasterizer (`icons.tarn`) — Milestone B2:
// - Analytical signed-distance-field (SDF) rasterizer for the Lucide vector icons
//   (`24×24` viewBox, round caps & joins, cached in `text.GlyphAtlas` under `font_id = 2`).
//   Lucide icons are licensed under the ISC License (see `backends/cairn/icons/Lucide-ISC.txt`).
// - Cairn Brand Marks (`cairn/desktop/prototype/assets/cairn-mark.svg`, `cairn-icon.svg`,
//   `src/brand.mjs`):
//   * `draw_cairn_mark`: 3 balanced stones (with `-3°` and `+5°` rotated SDF rounded
//     rectangles, vertical gradients, and `0.6px` inset specular strokes) + sun dot.
//   * `draw_cairn_icon`: `96×96` (`rx=21.5`) app squircle with 3-stop diagonal gradient,
//     clipped mountain ridge silhouette, radial glow, inner `CairnMark`, and `1.5px`
//     gradient border stroke.
//   * `draw_cairn_logo`: `CairnMark` + baseline-aligned `CAIRN OS` display lockup.
//   * `draw_app_icon`: `.app-icon` (`border-radius: 23%`) squircle with 165° gradient,
//     top 48% gloss, inner highlight/shadow, and drop-shadowed Lucide glyph.
import "ffi"
import "collections"
import "backend/damage"
import "backend/render"
import "backend/text"

