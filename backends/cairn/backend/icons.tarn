const PI f64 = 3.14159265358979323846

// Pure-Tarn trigonometric helpers (minimax Taylor series on [-pi, pi])
pub fn sin_rad(rad f64) f64 {
    var x = rad
    two_pi := PI * 2.0
    for x > PI { x = x - two_pi }
    for x < 0.0 - PI { x = x + two_pi }
    x2 := x * x
    x3 := x2 * x
    x5 := x3 * x2
    x7 := x5 * x2
    x9 := x7 * x2
    return x - (x3 / 6.0) + (x5 / 120.0) - (x7 / 5040.0) + (x9 / 362880.0)
}

pub fn cos_rad(rad f64) f64 {
    return sin_rad(rad + PI * 0.5)
}

// ---- Vector Primitives (`24×24` viewBox) ----
const PRIM_SEG u32 = 0
const PRIM_CIRCLE u32 = 1
const PRIM_DOT u32 = 2
const PRIM_RRECT u32 = 3

copy struct VPrim {
    kind u32
    a f64
    b f64
    c f64
    d f64
    r f64
}

fn add_seg(out &mut Vec<VPrim>, x0 f64, y0 f64, x1 f64, y1 f64) {
    out.push(VPrim { kind: PRIM_SEG, a: x0, b: y0, c: x1, d: y1, r: 0.0 })
}

fn add_circle(out &mut Vec<VPrim>, cx f64, cy f64, r f64) {
    out.push(VPrim { kind: PRIM_CIRCLE, a: cx, b: cy, c: 0.0, d: 0.0, r: r })
}

fn add_dot(out &mut Vec<VPrim>, cx f64, cy f64, r f64) {
    out.push(VPrim { kind: PRIM_DOT, a: cx, b: cy, c: 0.0, d: 0.0, r: r })
}

fn add_rrect(out &mut Vec<VPrim>, x f64, y f64, w f64, h f64, rx f64) {
    out.push(VPrim { kind: PRIM_RRECT, a: x, b: y, c: w, d: h, r: rx })
}

fn add_quad(out &mut Vec<VPrim>, x0 f64, y0 f64, cx f64, cy f64, x1 f64, y1 f64) {
    var px = x0
    var py = y0
    var s: i32 = 1
    for s <= 6 {
        t := f64(s) / 6.0
        mt := 1.0 - t
        nx := mt * mt * x0 + 2.0 * mt * t * cx + t * t * x1
        ny := mt * mt * y0 + 2.0 * mt * t * cy + t * t * y1
        add_seg(out, px, py, nx, ny)
        px = nx
        py = ny
        s = s + 1
    }
}

fn add_cubic(out &mut Vec<VPrim>, x0 f64, y0 f64, c1x f64, c1y f64, c2x f64, c2y f64, x1 f64, y1 f64) {
    var px = x0
    var py = y0
    var s: i32 = 1
    for s <= 8 {
        t := f64(s) / 8.0
        mt := 1.0 - t
        b0 := mt * mt * mt
        b1 := 3.0 * mt * mt * t
        b2 := 3.0 * mt * t * t
        b3 := t * t * t
        nx := b0 * x0 + b1 * c1x + b2 * c2x + b3 * x1
        ny := b0 * y0 + b1 * c1y + b2 * c2y + b3 * y1
        add_seg(out, px, py, nx, ny)
        px = nx
        py = ny
        s = s + 1
    }
}

fn add_arc(out &mut Vec<VPrim>, cx f64, cy f64, r f64, deg0 f64, deg1 f64, steps i32) {
    var n = steps
    if n < 4 { n = 4 }
    a0 := deg0 * PI / 180.0
    a1 := deg1 * PI / 180.0
    var px = cx + r * cos_rad(a0)
    var py = cy + r * sin_rad(a0)
    var i: i32 = 1
    for i <= n {
        t := f64(i) / f64(n)
        ang := a0 + (a1 - a0) * t
        nx := cx + r * cos_rad(ang)
        ny := cy + r * sin_rad(ang)
        add_seg(out, px, py, nx, ny)
        px = nx
        py = ny
        i = i + 1
    }
}

// Emits the `24×24` vector path primitives for each Lucide icon ID.
fn build_icon_prims(icon_id u32) Vec<VPrim> {
    var p: Vec<VPrim> = Vec.new()
    if icon_id == ICON_BOX {
        // Lucide `Box`: 3D isometric hexagon cube
        add_seg(&mut p, 12.0, 2.2, 20.5, 7.0)
        add_seg(&mut p, 20.5, 7.0, 20.5, 17.0)
        add_seg(&mut p, 20.5, 17.0, 12.0, 21.8)
        add_seg(&mut p, 12.0, 21.8, 3.5, 17.0)
        add_seg(&mut p, 3.5, 17.0, 3.5, 7.0)
        add_seg(&mut p, 3.5, 7.0, 12.0, 2.2)
        add_seg(&mut p, 3.5, 7.0, 12.0, 12.0)
        add_seg(&mut p, 12.0, 12.0, 20.5, 7.0)
        add_seg(&mut p, 12.0, 12.0, 12.0, 21.8)
        return p
    }
    if icon_id == ICON_SHIELD_CHECK {
        // Lucide `ShieldCheck`: shield outline + inner checkmark
        add_seg(&mut p, 12.0, 2.2, 19.5, 5.5)
        add_seg(&mut p, 19.5, 5.5, 19.5, 11.5)
        add_quad(&mut p, 19.5, 11.5, 19.5, 18.0, 12.0, 21.8)
        add_quad(&mut p, 12.0, 21.8, 4.5, 18.0, 4.5, 11.5)
        add_seg(&mut p, 4.5, 11.5, 4.5, 5.5)
        add_seg(&mut p, 4.5, 5.5, 12.0, 2.2)
        add_seg(&mut p, 9.0, 12.2, 11.2, 14.4)
        add_seg(&mut p, 11.2, 14.4, 15.5, 9.8)
        return p
    }
    if icon_id == ICON_PALETTE {
        // Lucide `Palette`: artist palette with thumb notch + 4 paint dots
        add_arc(&mut p, 12.0, 12.0, 9.6, 115.0, 365.0, 14)
        add_quad(&mut p, 21.5, 12.8, 21.2, 16.5, 17.5, 16.5)
        add_seg(&mut p, 17.5, 16.5, 15.6, 16.5)
        add_quad(&mut p, 15.6, 16.5, 13.5, 16.5, 13.5, 18.6)
        add_quad(&mut p, 13.5, 18.6, 13.5, 21.4, 8.0, 20.8)
        add_dot(&mut p, 13.5, 6.5, 0.9)
        add_dot(&mut p, 17.5, 10.5, 0.9)
        add_dot(&mut p, 8.5, 7.5, 0.9)
        add_dot(&mut p, 6.5, 12.5, 0.9)
        return p
    }
    if icon_id == ICON_ARROW_RIGHT {
        add_seg(&mut p, 5.0, 12.0, 19.0, 12.0)
        add_seg(&mut p, 12.0, 5.0, 19.0, 12.0)
        add_seg(&mut p, 12.0, 19.0, 19.0, 12.0)
        return p
    }
    if icon_id == ICON_ARROW_LEFT {
        add_seg(&mut p, 19.0, 12.0, 5.0, 12.0)
        add_seg(&mut p, 12.0, 19.0, 5.0, 12.0)
        add_seg(&mut p, 12.0, 5.0, 5.0, 12.0)
        return p
    }
    if icon_id == ICON_SHAPES {
        // Lucide `Shapes`: triangle + square + circle
        add_seg(&mut p, 8.0, 3.0, 2.5, 11.0)
        add_seg(&mut p, 2.5, 11.0, 13.5, 11.0)
        add_seg(&mut p, 13.5, 11.0, 8.0, 3.0)
        add_rrect(&mut p, 14.0, 3.5, 7.0, 7.0, 1.2)
        add_rrect(&mut p, 3.0, 14.0, 7.0, 7.0, 1.2)
        add_circle(&mut p, 17.5, 17.5, 3.5)
        return p
    }
    if icon_id == ICON_ROTATE_CCW {
        add_arc(&mut p, 12.0, 12.0, 8.5, -145.0, 140.0, 14)
        add_seg(&mut p, 3.2, 4.2, 3.2, 9.2)
        add_seg(&mut p, 3.2, 9.2, 8.2, 9.2)
        return p
    }
    if icon_id == ICON_SMARTPHONE {
        add_rrect(&mut p, 5.5, 2.2, 13.0, 19.6, 2.2)
        add_seg(&mut p, 11.5, 18.0, 12.5, 18.0)
        return p
    }
    if icon_id == ICON_CHECK {
        add_seg(&mut p, 20.0, 6.0, 9.0, 17.0)
        add_seg(&mut p, 4.0, 12.0, 9.0, 17.0)
        return p
    }
    if icon_id == ICON_COPY {
        add_rrect(&mut p, 8.5, 8.5, 12.5, 12.5, 2.0)
        add_seg(&mut p, 5.0, 15.0, 4.0, 15.0)
        add_quad(&mut p, 4.0, 15.0, 2.5, 15.0, 2.5, 13.0)
        add_seg(&mut p, 2.5, 13.0, 2.5, 4.5)
        add_quad(&mut p, 2.5, 4.5, 2.5, 2.5, 4.5, 2.5)
        add_seg(&mut p, 4.5, 2.5, 13.0, 2.5)
        add_quad(&mut p, 13.0, 2.5, 15.0, 2.5, 15.0, 4.5)
        return p
    }
    if icon_id == ICON_X {
        add_seg(&mut p, 18.0, 6.0, 6.0, 18.0)
        add_seg(&mut p, 6.0, 6.0, 18.0, 18.0)
        return p
    }
    if icon_id == ICON_SEARCH {
        add_circle(&mut p, 11.0, 11.0, 7.5)
        add_seg(&mut p, 16.5, 16.5, 21.0, 21.0)
        return p
    }
    if icon_id == ICON_SPARKLES {
        add_quad(&mut p, 12.0, 3.0, 12.5, 9.5, 19.0, 10.0)
        add_quad(&mut p, 19.0, 10.0, 12.5, 10.5, 12.0, 17.0)
        add_quad(&mut p, 12.0, 17.0, 11.5, 10.5, 5.0, 10.0)
        add_quad(&mut p, 5.0, 10.0, 11.5, 9.5, 12.0, 3.0)
        add_seg(&mut p, 19.0, 16.0, 19.0, 21.0)
        add_seg(&mut p, 16.5, 18.5, 21.5, 18.5)
        return p
    }
    if icon_id == ICON_SETTINGS {
        add_circle(&mut p, 12.0, 12.0, 3.2)
        add_circle(&mut p, 12.0, 12.0, 7.8)
        add_seg(&mut p, 12.0, 2.0, 12.0, 4.2)
        add_seg(&mut p, 12.0, 19.8, 12.0, 22.0)
        add_seg(&mut p, 2.0, 12.0, 4.2, 12.0)
        add_seg(&mut p, 19.8, 12.0, 22.0, 12.0)
        add_seg(&mut p, 4.9, 4.9, 6.5, 6.5)
        add_seg(&mut p, 17.5, 17.5, 19.1, 19.1)
        add_seg(&mut p, 19.1, 4.9, 17.5, 6.5)
        add_seg(&mut p, 6.5, 17.5, 4.9, 19.1)
        return p
    }
    if icon_id == ICON_FOLDER {
        add_seg(&mut p, 3.0, 6.0, 9.5, 6.0)
        add_seg(&mut p, 9.5, 6.0, 11.5, 8.5)
        add_seg(&mut p, 11.5, 8.5, 21.0, 8.5)
        add_seg(&mut p, 21.0, 8.5, 21.0, 19.5)
        add_seg(&mut p, 21.0, 19.5, 3.0, 19.5)
        add_seg(&mut p, 3.0, 19.5, 3.0, 6.0)
        return p
    }
    if icon_id == ICON_GLOBE {
        add_circle(&mut p, 12.0, 12.0, 9.5)
        add_seg(&mut p, 2.5, 12.0, 21.5, 12.0)
        add_quad(&mut p, 12.0, 2.5, 16.5, 12.0, 12.0, 21.5)
        add_quad(&mut p, 12.0, 2.5, 7.5, 12.0, 12.0, 21.5)
        return p
    }
    if icon_id == ICON_TERMINAL {
        add_seg(&mut p, 4.0, 17.0, 10.0, 11.0)
        add_seg(&mut p, 10.0, 11.0, 4.0, 5.0)
        add_seg(&mut p, 12.0, 19.0, 20.0, 19.0)
        return p
    }
    if icon_id == ICON_WIFI || icon_id == ICON_WIFI_OFF {
        add_arc(&mut p, 12.0, 19.5, 13.0, -135.0, -45.0, 10)
        add_arc(&mut p, 12.0, 19.5, 8.5, -135.0, -45.0, 8)
        add_arc(&mut p, 12.0, 19.5, 4.2, -135.0, -45.0, 6)
        add_dot(&mut p, 12.0, 19.5, 0.8)
        if icon_id == ICON_WIFI_OFF {
            add_seg(&mut p, 3.0, 3.0, 21.0, 21.0)
        }
        return p
    }
    if icon_id == ICON_BATTERY_FULL {
        add_rrect(&mut p, 2.0, 6.5, 17.0, 11.0, 2.0)
        add_seg(&mut p, 22.0, 10.5, 22.0, 13.5)
        add_seg(&mut p, 6.0, 10.0, 6.0, 14.0)
        add_seg(&mut p, 10.0, 10.0, 10.0, 14.0)
        add_seg(&mut p, 14.0, 10.0, 14.0, 14.0)
        return p
    }
    if icon_id == ICON_SLIDERS_HORIZONTAL {
        add_seg(&mut p, 3.0, 6.0, 21.0, 6.0)
        add_seg(&mut p, 3.0, 12.0, 21.0, 12.0)
        add_seg(&mut p, 3.0, 18.0, 21.0, 18.0)
        add_circle(&mut p, 9.0, 6.0, 2.0)
        add_circle(&mut p, 16.0, 12.0, 2.0)
        add_circle(&mut p, 8.0, 18.0, 2.0)
        return p
    }
    if icon_id == ICON_SUN || icon_id == ICON_SUN_MOON {
        add_circle(&mut p, 12.0, 12.0, 4.0)
        add_seg(&mut p, 12.0, 2.0, 12.0, 4.0)
        add_seg(&mut p, 12.0, 20.0, 12.0, 22.0)
        add_seg(&mut p, 2.0, 12.0, 4.0, 12.0)
        add_seg(&mut p, 20.0, 12.0, 22.0, 12.0)
        add_seg(&mut p, 4.9, 4.9, 6.3, 6.3)
        add_seg(&mut p, 17.7, 17.7, 19.1, 19.1)
        add_seg(&mut p, 19.1, 4.9, 17.7, 6.3)
        add_seg(&mut p, 6.3, 17.7, 4.9, 19.1)
        return p
    }
    if icon_id == ICON_MOON {
        add_arc(&mut p, 12.0, 12.0, 8.5, 40.0, 230.0, 12)
        add_arc(&mut p, 15.5, 8.5, 6.8, 195.0, 85.0, 10)
        return p
    }
    if icon_id == ICON_LANGUAGES {
        add_seg(&mut p, 5.0, 8.0, 13.0, 8.0)
        add_seg(&mut p, 9.0, 5.0, 9.0, 8.0)
        add_quad(&mut p, 11.5, 8.0, 10.5, 14.0, 5.0, 17.0)
        add_quad(&mut p, 7.0, 11.0, 9.5, 14.5, 13.0, 17.0)
        add_seg(&mut p, 13.0, 20.0, 17.0, 11.0)
        add_seg(&mut p, 17.0, 11.0, 21.0, 20.0)
        add_seg(&mut p, 14.5, 17.5, 19.5, 17.5)
        return p
    }
    if icon_id == ICON_MAP_PIN {
        add_arc(&mut p, 12.0, 10.0, 7.5, -195.0, 15.0, 12)
        add_quad(&mut p, 19.2, 11.9, 17.5, 16.8, 12.0, 21.5)
        add_quad(&mut p, 4.8, 11.9, 6.5, 16.8, 12.0, 21.5)
        add_circle(&mut p, 12.0, 10.0, 2.8)
        return p
    }
    if icon_id == ICON_KEYBOARD {
        add_rrect(&mut p, 2.0, 5.0, 20.0, 14.0, 2.0)
        add_seg(&mut p, 6.0, 9.0, 7.0, 9.0)
        add_seg(&mut p, 10.0, 9.0, 11.0, 9.0)
        add_seg(&mut p, 14.0, 9.0, 15.0, 9.0)
        add_seg(&mut p, 18.0, 9.0, 18.5, 9.0)
        add_seg(&mut p, 8.0, 15.0, 16.0, 15.0)
        return p
    }
    if icon_id == ICON_CLOCK {
        add_circle(&mut p, 12.0, 12.0, 9.5)
        add_seg(&mut p, 12.0, 6.5, 12.0, 12.0)
        add_seg(&mut p, 12.0, 12.0, 16.0, 14.0)
        return p
    }
    if icon_id == ICON_USER {
        add_circle(&mut p, 12.0, 8.0, 4.0)
        add_arc(&mut p, 12.0, 20.5, 7.0, -165.0, -15.0, 10)
        return p
    }
    if icon_id == ICON_LOCK {
        add_rrect(&mut p, 4.0, 11.0, 16.0, 10.0, 2.0)
        add_arc(&mut p, 12.0, 8.0, 4.5, -180.0, 0.0, 10)
        add_seg(&mut p, 7.5, 8.0, 7.5, 11.0)
        add_seg(&mut p, 16.5, 8.0, 16.5, 11.0)
        return p
    }
    if icon_id == ICON_KEY_ROUND {
        add_circle(&mut p, 7.5, 15.5, 4.5)
        add_seg(&mut p, 10.8, 12.2, 20.5, 2.5)
        add_seg(&mut p, 16.5, 6.5, 19.5, 9.5)
        add_seg(&mut p, 19.0, 4.0, 21.5, 6.5)
        return p
    }
    if icon_id == ICON_REFRESH_CW {
        add_arc(&mut p, 12.0, 12.0, 8.5, -140.0, 140.0, 14)
        add_seg(&mut p, 20.5, 4.5, 20.5, 9.5)
        add_seg(&mut p, 20.5, 9.5, 15.5, 9.5)
        return p
    }
    if icon_id == ICON_ACTIVITY {
        add_seg(&mut p, 2.0, 12.0, 6.5, 12.0)
        add_seg(&mut p, 6.5, 12.0, 9.5, 4.0)
        add_seg(&mut p, 9.5, 4.0, 14.5, 20.0)
        add_seg(&mut p, 14.5, 20.0, 17.5, 12.0)
        add_seg(&mut p, 17.5, 12.0, 22.0, 12.0)
        return p
    }
    if icon_id == ICON_EYE || icon_id == ICON_EYE_OFF {
        add_quad(&mut p, 2.0, 12.0, 12.0, 4.0, 22.0, 12.0)
        add_quad(&mut p, 2.0, 12.0, 12.0, 20.0, 22.0, 12.0)
        add_circle(&mut p, 12.0, 12.0, 3.0)
        if icon_id == ICON_EYE_OFF {
            add_seg(&mut p, 3.0, 3.0, 21.0, 21.0)
        }
        return p
    }
    if icon_id == ICON_CHEVRON_DOWN {
        add_seg(&mut p, 6.0, 9.0, 12.0, 15.0)
        add_seg(&mut p, 12.0, 15.0, 18.0, 9.0)
        return p
    }
    if icon_id == ICON_CHEVRON_LEFT {
        add_seg(&mut p, 15.0, 18.0, 9.0, 12.0)
        add_seg(&mut p, 9.0, 12.0, 15.0, 6.0)
        return p
    }
    if icon_id == ICON_CHEVRON_RIGHT {
        add_seg(&mut p, 9.0, 18.0, 15.0, 12.0)
        add_seg(&mut p, 15.0, 12.0, 9.0, 6.0)
        return p
    }
    if icon_id == ICON_PLUS {
        add_seg(&mut p, 12.0, 5.0, 12.0, 19.0)
        add_seg(&mut p, 5.0, 12.0, 19.0, 12.0)
        return p
    }
    if icon_id == ICON_MINUS {
        add_seg(&mut p, 5.0, 12.0, 19.0, 12.0)
        return p
    }
    if icon_id == ICON_LAYOUT_GRID {
        add_rrect(&mut p, 3.0, 3.0, 7.0, 7.0, 1.5)
        add_rrect(&mut p, 14.0, 3.0, 7.0, 7.0, 1.5)
        add_rrect(&mut p, 14.0, 14.0, 7.0, 7.0, 1.5)
        add_rrect(&mut p, 3.0, 14.0, 7.0, 7.0, 1.5)
        return p
    }
    if icon_id == ICON_LIST {
        add_seg(&mut p, 8.0, 6.0, 21.0, 6.0)
        add_seg(&mut p, 8.0, 12.0, 21.0, 12.0)
        add_seg(&mut p, 8.0, 18.0, 21.0, 18.0)
        add_dot(&mut p, 4.0, 6.0, 0.8)
        add_dot(&mut p, 4.0, 12.0, 0.8)
        add_dot(&mut p, 4.0, 18.0, 0.8)
        return p
    }
    if icon_id == ICON_VOLUME2 || icon_id == ICON_VOLUME_X {
        add_seg(&mut p, 11.0, 5.0, 6.0, 9.0)
        add_seg(&mut p, 6.0, 9.0, 2.5, 9.0)
        add_seg(&mut p, 2.5, 9.0, 2.5, 15.0)
        add_seg(&mut p, 2.5, 15.0, 6.0, 15.0)
        add_seg(&mut p, 6.0, 15.0, 11.0, 19.0)
        add_seg(&mut p, 11.0, 19.0, 11.0, 5.0)
        if icon_id == ICON_VOLUME2 {
            add_arc(&mut p, 12.0, 12.0, 4.5, -45.0, 45.0, 6)
            add_arc(&mut p, 12.0, 12.0, 8.0, -45.0, 45.0, 8)
        } else {
            add_seg(&mut p, 16.0, 9.0, 22.0, 15.0)
            add_seg(&mut p, 22.0, 9.0, 16.0, 15.0)
        }
        return p
    }
    if icon_id == ICON_MONITOR {
        add_rrect(&mut p, 2.0, 3.0, 20.0, 14.0, 2.0)
        add_seg(&mut p, 8.0, 21.0, 16.0, 21.0)
        add_seg(&mut p, 12.0, 17.0, 12.0, 21.0)
        return p
    }
    if icon_id == ICON_INFO {
        add_circle(&mut p, 12.0, 12.0, 9.5)
        add_seg(&mut p, 12.0, 11.5, 12.0, 16.5)
        add_dot(&mut p, 12.0, 8.0, 0.8)
        return p
    }
    // Fallback for any other catalog/file icon: clean rounded document/tile frame + center mark
    add_rrect(&mut p, 4.0, 3.0, 16.0, 18.0, 2.5)
    add_seg(&mut p, 8.0, 9.0, 16.0, 9.0)
    add_seg(&mut p, 8.0, 13.0, 16.0, 13.0)
    add_seg(&mut p, 8.0, 17.0, 13.0, 17.0)
    return p
}

// Analytical unsigned distance from point `(px, py)` to a vector primitive in `24×24` space.
fn dist_to_prim(px f64, py f64, prim VPrim) f64 {
    if prim.kind == PRIM_SEG {
        vx := prim.c - prim.a
        vy := prim.d - prim.b
        wx := px - prim.a
        wy := py - prim.b
        len2 := vx * vx + vy * vy
        var t = 0.0
        if len2 > 0.000001 {
            t = (wx * vx + wy * vy) / len2
            if t < 0.0 { t = 0.0 }
            if t > 1.0 { t = 1.0 }
        }
        dx := px - (prim.a + t * vx)
        dy := py - (prim.b + t * vy)
        return (dx * dx + dy * dy).sqrt()
    }
    if prim.kind == PRIM_CIRCLE {
        dx := px - prim.a
        dy := py - prim.b
        return ((dx * dx + dy * dy).sqrt() - prim.r).abs()
    }
    if prim.kind == PRIM_DOT {
        dx := px - prim.a
        dy := py - prim.b
        d := (dx * dx + dy * dy).sqrt() - prim.r
        if d <= 0.0 { return 0.0 }
        return d
    }
    // PRIM_RRECT
    hx := prim.c * 0.5
    hy := prim.d * 0.5
    cx := prim.a + hx
    cy := prim.b + hy
    d_rr := render.sdf_rrect(px - cx, py - cy, hx, hy, render.uniform_radii(prim.r))
    return d_rr.abs()
}

fn icon_cache_key(icon_id u32, size_q4 u32, stroke_q4 u32) u64 {
    return (u64(2) << 48) | (u64(stroke_q4 & 255) << 40) | (u64(size_q4) << 20) | u64(icon_id)
}

// Rasterizes a Lucide icon into `atlas` (or returns the cached `AtlasGlyph` on hit: 0 allocations).
pub fn get_or_rasterize_icon(atlas &mut text.GlyphAtlas, icon_id u32, size_px f64, stroke_width f64) text.AtlasGlyph {
    size_q4 := u32(size_px * 16.0 + 0.5)
    stroke_q4 := u32(stroke_width * 16.0 + 0.5)
    key := icon_cache_key(icon_id, size_q4, stroke_q4)
    slot := usize((key ^ (key >> 15) ^ (key >> 23)) & 2047)
    if atlas.fast_keys.as_slice()[slot] == key && key != 0 {
        return atlas.fast_vals.as_slice()[slot]
    }
    match collections.get_copy(&atlas.cache, &key) {
        Some(found) => {
            atlas.fast_keys.as_mut_slice()[slot] = key
            atlas.fast_vals.as_mut_slice()[slot] = found
            return found
        }
        None => {}
    }

    gw := i32(size_px + 2.5)
    gh := gw
    if gw <= 0 || gw > 256 {
        return text.AtlasGlyph { atlas_x: 0, atlas_y: 0, width: 0, height: 0, bearing_x: 0, bearing_y: 0 }
    }

    if atlas.cursor_x + gw + 1 >= atlas.width {
        atlas.cursor_x = 1
        atlas.cursor_y = atlas.cursor_y + atlas.shelf_h + 1
        atlas.shelf_h = 0
    }
    if atlas.cursor_y + gh + 1 >= atlas.height {
        atlas.cursor_x = 1
        atlas.cursor_y = 1
        atlas.shelf_h = 0
    }
    ax := atlas.cursor_x
    ay := atlas.cursor_y
    atlas.cursor_x = atlas.cursor_x + gw + 1
    if gh > atlas.shelf_h { atlas.shelf_h = gh }

    prims := build_icon_prims(icon_id)
    p_slice := prims.as_slice()
    inv_scale := 24.0 / size_px
    scale := size_px / 24.0
    half_stroke_px := (stroke_width * scale) * 0.5
    atlas_pixels := atlas.pixels.as_mut_slice()

    var py: i32 = 0
    for py < gh {
        vy := (f64(py) + 0.5) * inv_scale
        dst_row := usize((ay + py) * atlas.width + ax)
        var px: i32 = 0
        for px < gw {
            vx := (f64(px) + 0.5) * inv_scale
            var min_d_vb = 999.0
            var i: usize = 0
            for i < p_slice.len() {
                d_vb := dist_to_prim(vx, vy, p_slice[i])
                if d_vb < min_d_vb { min_d_vb = d_vb }
                i = i + 1
            }
            sdf_px := min_d_vb * scale - half_stroke_px
            if sdf_px < 0.5 {
                var cov = 0.5 - sdf_px
                if cov > 1.0 { cov = 1.0 }
                if cov > 0.0 {
                    atlas_pixels[dst_row + usize(px)] = u8(cov * 255.0 + 0.5)
                }
            }
            px = px + 1
        }
        py = py + 1
    }

    entry := text.AtlasGlyph {
        atlas_x: ax,
        atlas_y: ay,
        width: gw,
        height: gh,
        bearing_x: 0,
        bearing_y: 0,
    }
    prev := atlas.cache.insert(key, entry)
    atlas.fast_keys.as_mut_slice()[slot] = key
    atlas.fast_vals.as_mut_slice()[slot] = entry
    atlas.rasterized_count = atlas.rasterized_count + 1
    return entry
}

// Draws a Lucide vector icon at `(x, y)` with `size_px` and `color` using the cached atlas entry.
pub fn draw_icon(canvas &mut render.Canvas, atlas &mut text.GlyphAtlas,
    icon_id u32, x i32, y i32, size_px f64, stroke_width f64, color render.Color, clip damage.Rect) u32 {
    if color.a == 0 { return 0 }
    ag := get_or_rasterize_icon(atlas, icon_id, size_px, stroke_width)
    if ag.width <= 0 || ag.height <= 0 { return 0 }
    g_rect := damage.rect(x, y, ag.width, ag.height)
    work := g_rect.intersect(&clip).clamp(canvas.width, canvas.height)
    if work.is_empty() { return 0 }

    src_b := u32(color.b)
    src_g := u32(color.g)
    src_r := u32(color.r)
    src_a := u32(color.a)
    packed_opaque := src_b | (src_g << 8) | (src_r << 16) | 4278190080

    dst_base := ffi.vec_mut(&mut canvas.pixels)
    var dst_p32: *mut u32 = ffi.from_address(ffi.address(ffi.to_const(dst_base)))
    atlas_base := ffi.vec(&atlas.pixels)
    w_stride := usize(canvas.width)
    a_stride := usize(atlas.width)

    ax_off := ag.atlas_x - x
    var atlas_row = usize(ag.atlas_y + (work.y - y)) * a_stride + usize(work.x + ax_off)
    var dst_row = usize(work.y) * w_stride + usize(work.x)
    row_w := usize(work.w)
    var py = work.y
    y_end := work.y + work.h
    for py < y_end {
        var col: usize = 0
        for col < row_w {
            var cov: u32 = 0
            unsafe { cov = u32(ffi.read(ffi.offset(atlas_base, atlas_row + col))) }
            if cov > 0 {
                var sa = cov
                if src_a != 255 {
                    t_a := src_a * cov + 127
                    sa = (t_a + 1 + (t_a >> 8)) >> 8
                }
                if sa >= 255 {
                    unsafe { ffi.write(ffi.offset_mut(dst_p32, dst_row + col), packed_opaque) }
                } else if sa > 0 {
                    inv := 255 - sa
                    t_r := src_r * sa + 127
                    t_g := src_g * sa + 127
                    t_b := src_b * sa + 127
                    sr := (t_r + 1 + (t_r >> 8)) >> 8
                    sg := (t_g + 1 + (t_g >> 8)) >> 8
                    sb := (t_b + 1 + (t_b >> 8)) >> 8
                    src32 := sb | (sg << 8) | (sr << 16) | (sa << 24)
                    unsafe {
                        p_px := ffi.offset_mut(dst_p32, dst_row + col)
                        d32 := ffi.read(ffi.to_const(p_px))
                        rb := (((d32 & 16711935) * inv + 8388736) >> 8) & 16711935
                        ga := (((d32 >> 8) & 16711935) * inv + 8388736) & 4278255360
                        ffi.write(p_px, src32 + (rb | ga))
                    }
                }
            }
            col = col + 1
        }
        atlas_row = atlas_row + a_stride
        dst_row = dst_row + w_stride
        py = py + 1
    }
    return 1
}

// ---- Cairn Brand Marks (`cairn-mark.svg`, `cairn-icon.svg`, `brand.mjs`) ----

// Draws one stone of `CairnMark` in `64×64` mark coordinates, supporting exact rotation `deg`
// around `(rot_cx, rot_cy)`, vertical linear gradient `c_top -> c_bot`, and inset `0.6px`
// `1.2px`-wide white highlight stroke fading from `0.8` at `0%` to `0.0` at `55%`.
fn draw_mark_stone(canvas &mut render.Canvas, ox f64, oy f64, scale f64,
    sx f64, sy f64, sw f64, sh f64, srx f64, deg f64, rot_cx f64, rot_cy f64,
    c_top render.Color, c_bot render.Color, clip damage.Rect) {
    hx := sw * 0.5
    hy := sh * 0.5
    cx := sx + hx
    cy := sy + hy
    rad := deg * PI / 180.0
    cos_a := cos_rad(rad)
    sin_a := sin_rad(rad)

    // Conservative screen-space bounding box around the rotated stone
    pad := 3.0
    b_x0 := i32(ox + (sx - pad) * scale)
    b_y0 := i32(oy + (sy - pad) * scale)
    b_x1 := i32(ox + (sx + sw + pad * 2.0) * scale) + 1
    b_y1 := i32(oy + (sy + sh + pad * 2.0) * scale) + 1
    work := damage.rect(b_x0, b_y0, b_x1 - b_x0, b_y1 - b_y0).intersect(&clip).clamp(canvas.width, canvas.height)
    if work.is_empty() { return }

    inv_scale := 1.0 / scale
    radii := render.uniform_radii(srx)
    pixels := canvas.pixels.as_mut_slice()

    var py = work.y
    for py < work.bottom() {
        vy := (f64(py) + 0.5 - oy) * inv_scale
        dy_r := vy - rot_cy
        var px = work.x
        for px < work.right() {
            vx := (f64(px) + 0.5 - ox) * inv_scale
            dx_r := vx - rot_cx
            // Inverse rotate around `(rot_cx, rot_cy)` into stone-local coordinates
            ux := rot_cx + dx_r * cos_a + dy_r * sin_a
            uy := rot_cy - dx_r * sin_a + dy_r * cos_a
            lx := ux - cx
            ly := uy - cy
            d_mark := render.sdf_rrect(lx, ly, hx, hy, radii)
            d_px := d_mark * scale
            if d_px < 0.5 {
                var cov_f = 0.5 - d_px
                if cov_f > 1.0 { cov_f = 1.0 }
                cov := u32(cov_f * 255.0 + 0.5)
                var t_grad = (ly + hy) / sh
                if t_grad < 0.0 { t_grad = 0.0 }
                if t_grad > 1.0 { t_grad = 1.0 }
                fill := render.lerp_color(c_top, c_bot, u32(t_grad * 256.0))
                idx := usize(py * canvas.stride + px * 4)
                render.blend_at(pixels, idx, fill, cov)

                // Inset highlight stroke (`x+0.6, w-1.2, stroke-width=1.2`, gradient stop 0: 0.8 -> stop 0.55: 0.0)
                if t_grad < 0.55 {
                    d_stroke_px := ((d_mark + 0.6).abs() - 0.6) * scale
                    if d_stroke_px < 0.5 {
                        var scov = 0.5 - d_stroke_px
                        if scov > 1.0 { scov = 1.0 }
                        fade := (1.0 - t_grad / 0.55) * 0.80
                        hi_cov := u32(scov * fade * f64(cov) + 0.5)
                        if hi_cov > 0 {
                            render.blend_at(pixels, idx, render.rgb(255, 255, 255), hi_cov)
                        }
                    }
                }
            }
            px = px + 1
        }
        py = py + 1
    }
}

// Renders `cairn-mark.svg` (`viewBox="0 0 64 64"`) at `(x, y)` with width/height `size_px`.
pub fn draw_cairn_mark(canvas &mut render.Canvas, x f64, y f64, size_px f64, clip damage.Rect) {
    if size_px <= 1.0 { return }
    scale := size_px / 64.0
    // Stone a (bottom): x=5, y=40, w=54, h=17, rx=8.5, #9aa0ff -> #4a43df
    draw_mark_stone(canvas, x, y, scale, 5.0, 40.0, 54.0, 17.0, 8.5, 0.0, 32.0, 48.5,
        render.hex_rgb(0x9aa0ff), render.hex_rgb(0x4a43df), clip)
    // Stone b (middle): x=13, y=25.5, w=36, h=13.5, rx=6.75, rotate(-3 31 32.25), #b4b9ff -> #5f58ec
    draw_mark_stone(canvas, x, y, scale, 13.0, 25.5, 36.0, 13.5, 6.75, -3.0, 31.0, 32.25,
        render.hex_rgb(0xb4b9ff), render.hex_rgb(0x5f58ec), clip)
    // Stone c (top): x=22, y=13, w=20, h=11, rx=5.5, rotate(5 32 18.5), #d2d4ff -> #8a85f6
    draw_mark_stone(canvas, x, y, scale, 22.0, 13.0, 20.0, 11.0, 5.5, 5.0, 32.0, 18.5,
        render.hex_rgb(0xd2d4ff), render.hex_rgb(0x8a85f6), clip)

    // Sun dot: cx=47.5, cy=9.5, r=4, linearGradient (0,0)->(1,1) #ffe2b8 -> #ff9a55
    scx := x + 47.5 * scale
    scy := y + 9.5 * scale
    sr := 4.0 * scale
    s_rect := damage.rect(i32(scx - sr - 2.0), i32(scy - sr - 2.0), i32(sr * 2.0 + 5.0), i32(sr * 2.0 + 5.0))
    work := s_rect.intersect(&clip).clamp(canvas.width, canvas.height)
    if !work.is_empty() {
        c0 := render.hex_rgb(0xffe2b8)
        c1 := render.hex_rgb(0xff9a55)
        pixels := canvas.pixels.as_mut_slice()
        var py = work.y
        for py < work.bottom() {
            dy := (f64(py) + 0.5) - scy
            var px = work.x
            for px < work.right() {
                dx := (f64(px) + 0.5) - scx
                d := (dx * dx + dy * dy).sqrt() - sr
                if d < 0.5 {
                    var cov_f = 0.5 - d
                    if cov_f > 1.0 { cov_f = 1.0 }
                    var t = ((dx + dy) / (sr * 2.828)) + 0.5
                    if t < 0.0 { t = 0.0 }
                    if t > 1.0 { t = 1.0 }
                    col := render.lerp_color(c0, c1, u32(t * 256.0))
                    render.blend_at(pixels, usize(py * canvas.stride + px * 4), col, u32(cov_f * 255.0 + 0.5))
                }
                px = px + 1
            }
            py = py + 1
        }
    }
}

// Mountain ridge height at `ux` in `0..96` for `cairn-icon.svg`:
// `M0 80 L28 50 L44 66 L64 40 L96 76 V96 H0Z`
fn icon_mountain_y(ux f64) f64 {
    if ux <= 28.0 {
        return 80.0 + (50.0 - 80.0) * (ux / 28.0)
    }
    if ux <= 44.0 {
        return 50.0 + (66.0 - 50.0) * ((ux - 28.0) / 16.0)
    }
    if ux <= 64.0 {
        return 66.0 + (40.0 - 66.0) * ((ux - 44.0) / 20.0)
    }
    return 40.0 + (76.0 - 40.0) * ((ux - 64.0) / 32.0)
}

// Renders `cairn-icon.svg` (`viewBox="0 0 96 96"`) at `(x, y)` with width/height `size_px`.
pub fn draw_cairn_icon(canvas &mut render.Canvas, x f64, y f64, size_px f64, clip damage.Rect) {
    if size_px <= 1.0 { return }
    bounds := damage.rect(i32(x), i32(y), i32(size_px + 1.5), i32(size_px + 1.5))
    work := bounds.intersect(&clip).clamp(canvas.width, canvas.height)
    if work.is_empty() { return }

    scale := size_px / 96.0
    inv_scale := 96.0 / size_px
    radii := render.uniform_radii(21.5)
    g0 := render.hex_rgb(0x3b40ad)
    g1 := render.hex_rgb(0x232662)
    g2 := render.hex_rgb(0x14163f)
    white := render.rgb(255, 255, 255)
    pixels := canvas.pixels.as_mut_slice()

    // 1. Background squircle + mountain silhouette + radial glow
    var py = work.y
    for py < work.bottom() {
        uy := (f64(py) + 0.5 - y) * inv_scale
        var px = work.x
        for px < work.right() {
            ux := (f64(px) + 0.5 - x) * inv_scale
            d_px := render.sdf_rrect(ux - 48.0, uy - 48.0, 48.0, 48.0, radii) * scale
            if d_px < 0.5 {
                var cov_f = 0.5 - d_px
                if cov_f > 1.0 { cov_f = 1.0 }
                cov := u32(cov_f * 255.0 + 0.5)

                // Diagonal 3-stop gradient (0 -> 0.55 -> 1.0)
                var td = (ux + uy) / 192.0
                if td < 0.0 { td = 0.0 }
                if td > 1.0 { td = 1.0 }
                var bg = g0
                if td < 0.55 {
                    bg = render.lerp_color(g0, g1, u32((td / 0.55) * 256.0))
                } else {
                    bg = render.lerp_color(g1, g2, u32(((td - 0.55) / 0.45) * 256.0))
                }

                // Mountain silhouette (`opacity=".06"`)
                mtn_y := icon_mountain_y(ux)
                if uy >= mtn_y {
                    bg = render.lerp_color(bg, white, 15)
                }

                // Radial glow `cx=.25, cy=.12, r=.9` (stop 0: 0.32 -> stop 0.6: 0)
                rx := (ux - 24.0) / 86.4
                ry := (uy - 11.52) / 86.4
                rd := (rx * rx + ry * ry).sqrt()
                if rd < 0.6 {
                    glow_t := (1.0 - rd / 0.6) * 0.32
                    bg = render.lerp_color(bg, white, u32(glow_t * 256.0))
                }

                idx := usize(py * canvas.stride + px * 4)
                render.blend_at(pixels, idx, bg, cov)
            }
            px = px + 1
        }
        py = py + 1
    }

    // 2. Inner CairnMark: `transform="translate(18.5 18.5) scale(.92)"`
    draw_cairn_mark(canvas, x + 18.5 * scale, y + 18.5 * scale, 64.0 * 0.92 * scale, clip)

    // 3. Outer border stroke: `x=".75" y=".75" w="94.5" h="94.5" rx="20.8" stroke-width="1.5"`
    edge_pixels := canvas.pixels.as_mut_slice()
    var by = work.y
    for by < work.bottom() {
        uy := (f64(by) + 0.5 - y) * inv_scale
        var tv = uy / 96.0
        if tv < 0.0 { tv = 0.0 }
        if tv > 1.0 { tv = 1.0 }
        var edge_op = 0.55
        if tv < 0.5 {
            edge_op = 0.55 + (0.05 - 0.55) * (tv * 2.0)
        } else {
            edge_op = 0.05 + (0.18 - 0.05) * ((tv - 0.5) * 2.0)
        }
        var bx = work.x
        for bx < work.right() {
            ux := (f64(bx) + 0.5 - x) * inv_scale
            d_ring := (render.sdf_rrect(ux - 48.0, uy - 48.0, 47.25, 47.25, render.uniform_radii(20.8)).abs() - 0.75) * scale
            if d_ring < 0.5 {
                var rcov = 0.5 - d_ring
                if rcov > 1.0 { rcov = 1.0 }
                a_cov := u32(rcov * edge_op * 255.0 + 0.5)
                if a_cov > 0 {
                    render.blend_at(edge_pixels, usize(by * canvas.stride + bx * 4), white, a_cov)
                }
            }
            bx = bx + 1
        }
        by = by + 1
    }
}

// Draws `CairnLogo`: `CairnMark(mark_size)` + baseline-aligned `CAIRN` (`letter-spacing: 0.22em`)
// + `OS` (`letter-spacing: 0.16em`). Returns total width drawn.
pub fn draw_cairn_logo(canvas &mut render.Canvas, atlas &mut text.GlyphAtlas, display_font &text.Font,
    x f64, y f64, mark_size f64, cairn_size f64, os_size f64, ink render.Color, os_ink render.Color, clip damage.Rect) f64 {
    draw_cairn_mark(canvas, x, y, mark_size, clip)
    gap := mark_size * 0.30
    text_x := x + mark_size + gap
    // Center `CAIRN` vertically against `mark_size` and align `OS` to the exact same typographic baseline
    cairn_asc := display_font.ascent_px(cairn_size)
    cairn_desc := display_font.descent_px(cairn_size)
    baseline_y := y + (mark_size + (cairn_asc - cairn_desc)) * 0.5

    cairn_style := text.TextStyle {
        font_id: 1,
        size_px: cairn_size,
        line_height: 1.0,
        tracking_em: 0.22,
        color: ink,
        bold: false,
        tabular_nums: false,
        balance: false,
    }
    os_style := text.TextStyle {
        font_id: 1,
        size_px: os_size,
        line_height: 1.0,
        tracking_em: 0.16,
        color: os_ink,
        bold: false,
        tabular_nums: false,
        balance: false,
    }
    w1 := text.draw_text_baseline(canvas, atlas, display_font, &"CAIRN", text_x, baseline_y, cairn_style, clip)
    w2 := text.draw_text_baseline(canvas, atlas, display_font, &"OS", text_x + w1 + cairn_size * 0.28, baseline_y, os_style, clip)
    return mark_size + gap + w1 + cairn_size * 0.28 + w2
}

// Draws `.app-icon` (`border-radius: 23%` squircle with 3-stop gradient, top 48% white gloss,
// inner specular highlight, and drop-shadowed Lucide vector icon).
pub fn draw_app_icon(canvas &mut render.Canvas, atlas &mut text.GlyphAtlas,
    x i32, y i32, size i32, hue render.Color, icon_id u32, clip damage.Rect) {
    bounds := damage.rect(x, y, size, size)
    if !bounds.intersects(&clip) { return }
    rx := f64(size) * 0.23
    top_col := render.color_mix(hue, 62, render.rgb(255, 255, 255))
    bot_col := render.color_mix(hue, 78, render.rgb(0, 0, 0))
    canvas.draw_rrect(bounds, render.RRectStyle {
        radii: render.uniform_radii(rx),
        fill_top: top_col,
        fill_bottom: bot_col,
        border_color: render.rgba(255, 255, 255, 90),
        border_width: 1.0,
        inner_hi: render.rgba(255, 255, 255, 140),
    }, clip)

    // Top 48% white gloss overlay
    gloss_h := (size * 48) / 100
    gloss_bounds := damage.rect(x + 1, y + 1, size - 2, gloss_h)
    canvas.draw_rrect(gloss_bounds, render.RRectStyle {
        radii: render.Radii { tl: rx - 1.0, tr: rx - 1.0, br: 2.0, bl: 2.0 },
        fill_top: render.rgba(255, 255, 255, 72),
        fill_bottom: render.rgba(255, 255, 255, 0),
        border_color: render.rgba(0, 0, 0, 0),
        border_width: 0.0,
        inner_hi: render.rgba(0, 0, 0, 0),
    }, clip)

    // Centered 52% Lucide glyph with 1px drop shadow
    ico_sz := f64(size) * 0.52
    ix := x + i32((f64(size) - ico_sz) * 0.5)
    iy := y + i32((f64(size) - ico_sz) * 0.5)
    sh := draw_icon(canvas, atlas, icon_id, ix, iy + 1, ico_sz, 2.0, render.rgba(0, 0, 0, 64), clip)
    fg := draw_icon(canvas, atlas, icon_id, ix, iy, ico_sz, 2.0, render.rgb(255, 255, 255), clip)
}
