// Tests for the Cairn self-drawn backend (Milestone B1):
// 1. DamageRegion unit tests (32x32 tile alignment, coalescing, 0 redraws when empty)
// 2. Deterministic headless PNG snapshot verification + SHA-256 check
// 3. 1080p hover damage redraw benchmark against the B1 budget gate (< 1.5 ms)
// 4. Live macOS host window lifecycle, first-frame budget (< 50 ms), idle 0 redraws,
//    and ABI 14 component/region reconciliation contract.
import "testing"
import "fs"
import "backend/damage"
import "backend/scene_b1"
import "backend/native"
import "backend/objc"

// Expected deterministic SHA-256 of the 960x600 initial B1 scene PNG.
const EXPECTED_B1_960X600_SHA256 string = "685fdc263df05dc73a8abb9e50c69744e17ef2ecfdc73f32cee0e11fce34aa59"

fn test_damage_region_and_idle_zero_work(t &mut testing.T) {
    var dmg = damage.DamageRegion.new()
    t.require(dmg.is_empty(), &"initial damage region is empty")

    // Add a small rect (100, 100, 20, 20); it aligns outward to (96, 96, 32, 32).
    dmg.add(damage.rect(100, 100, 20, 20), 1920, 1080)
    t.require(dmg.len() == 1, &"one tile-aligned rect")
    r0 := dmg.at(0)
    t.require(r0.x == 96 && r0.y == 96 && r0.w == 32 && r0.h == 32, &"aligned to 32x32 tile")

    // Contained rect is coalesced without increasing count.
    dmg.add(damage.rect(102, 102, 10, 10), 1920, 1080)
    t.require(dmg.len() == 1, &"contained rect coalesced")

    // Overlapping rect merges into a single bounding rect.
    dmg.add(damage.rect(120, 100, 30, 20), 1920, 1080)
    t.require(dmg.len() == 1, &"overlapping rect merged")
    r1 := dmg.at(0)
    t.require(r1.x == 96 && r1.w == 64, &"merged width is 64")

    // Disjoint rect stays separate so unchanged area between them is not redrawn.
    dmg.add(damage.rect(640, 320, 32, 32), 1920, 1080)
    t.require(dmg.len() == 2, &"disjoint rects stay separate")

    dmg.clear()
    t.require(dmg.is_empty(), &"cleared damage is empty")
}

fn test_headless_snapshot_and_1080p_budget(t &mut testing.T) {
    // 1. Render initial 960x600 scene headlessly and verify deterministic PNG hash.
    t0 := objc.monotonic_ns()
    var scene = scene_b1.SceneB1.new(960, 600, 1)
    t1 := objc.monotonic_ns()
    first_960_us := (t1 - t0) / 1000
    print("B1 headless 960x600 first frame: " + first_960_us.to_string() + " us (< 50000 us budget)")
    t.require(first_960_us < 50000, &"960x600 first frame under 50 ms (50000 us) budget")

    // Clear initial damage; verify idle render does 0 work.
    scene.damage.clear()
    frames_before := scene.frames_rendered
    t.require(scene.render_damaged() == 0, &"idle render_damaged returns 0")
    t.require(scene.frames_rendered == frames_before, &"0 frames rendered when idle")

    path := "/tmp/tarn-ui-cairn-b1-headless.png"
    hash1 := match scene.snapshot_png(&path) {
        Ok(h) => h
        Err(code) => { panic("snapshot_png failed: " + code.to_string()) }
    }
    print("B1 960x600 PNG SHA-256: " + hash1)

    // Render a second independent instance and verify bit-identical determinism.
    scene2 := scene_b1.SceneB1.new(960, 600, 1)
    path2 := "/tmp/tarn-ui-cairn-b1-headless-2.png"
    hash2 := match scene2.snapshot_png(&path2) {
        Ok(h) => h
        Err(code) => { panic("snapshot_png 2 failed: " + code.to_string()) }
    }
    t.require(hash1.eq(&hash2), &"deterministic PNG SHA-256 across runs")
    if !EXPECTED_B1_960X600_SHA256.is_empty() {
        t.require(hash1.eq(&EXPECTED_B1_960X600_SHA256), &"matches golden B1 PNG SHA-256")
    }
    removed1 := fs.remove_file(&path)
    removed2 := fs.remove_file(&path2)

    // 2. Benchmark 1080p (1920x1080) first frame and localized single-card hover damage.
    var scene_1080 = scene_b1.SceneB1.new(1920, 1080, 1)
    var first_1080_us: u64 = 999999999
    var f_rep: u32 = 0
    for f_rep < 3 {
        t_wp0 := objc.monotonic_ns()
        scene_1080 = scene_b1.SceneB1.new(1920, 1080, 1)
        t_wp1 := objc.monotonic_ns()
        dt_1080 := (t_wp1 - t_wp0) / 1000
        if dt_1080 < first_1080_us { first_1080_us = dt_1080 }
        f_rep = f_rep + 1
    }
    scene_1080.damage.clear()
    print("B1 1080p first frame: " + first_1080_us.to_string() + " us (< 100000 us ADR 0009 cold start budget)")
    t.require(first_1080_us < 100000, &"1080p cold first frame under 100 ms (100000 us) budget")

    // Hover onto card 1 (right card) at 1080p and measure localized damage redraw
    // (best of 5 transitions to guard against nice -n 10 OS scheduling jitter).
    cx := scene_1080.card1_bounds.x + scene_1080.card1_bounds.w / 2
    cy := scene_1080.card1_bounds.y + scene_1080.card1_bounds.h / 2
    var hover_us: u64 = 999999999
    var rects: u32 = 0
    var changed = false
    var rep: u32 = 0
    for rep < 5 {
        scene_1080.hovered_id = scene_b1.CARD_NONE
        scene_1080.damage.clear()
        th0 := objc.monotonic_ns()
        changed = scene_1080.on_pointer_move(cx, cy)
        rects = scene_1080.render_damaged()
        scene_1080.damage.clear()
        th1 := objc.monotonic_ns()
        dt := (th1 - th0) / 1000
        if dt < hover_us { hover_us = dt }
        rep = rep + 1
    }
    print("B1 1080p single-card hover damage redraw: " + hover_us.to_string() + " us (" + rects.to_string() + " damage rect)")
    t.require(changed && rects == 1, &"hover damages only the hovered card rect")
    t.require(hover_us < 1500, &"1080p single-card hover redraw under 1.5 ms (1500 us) budget")

    // Moving pointer inside the same card causes 0 damage and 0 redraws.
    t.require(!scene_1080.on_pointer_move(cx + 5, cy + 5), &"pointer move within same card queues 0 damage")
    t.require(scene_1080.render_damaged() == 0, &"0 redraws when hover target unchanged")
}

fn test_host_window_and_abi14_contract(t &mut testing.T) {
    if !native.display_available() {
        t.skip(&"no window server")
        return
    }
    var ui = match native.create(&"Cairn B1 Test", &"Hola desde Cairn") {
        Ok(value) => value
        Err(code) => { panic("create failed: " + code.to_string()) }
    }
    first_win_us := ui.first_frame_nanos() / 1000
    print("B1 macOS host surface + first frame: " + first_win_us.to_string() + " us")
    t.require(first_win_us < 50000, &"macOS first frame render + CALayer present under 50 ms budget")

    t.require(native.create(&"Second", &"Second").is_err(), &"second session refused")
    t.require(ui.next() == 1, &"opened event")

    // Verify 0 redraws when pointer does not change hover target.
    presents_initial := ui.presents_count()
    t.require(ui.inject_pointer_move(10, 10) == 0, &"outside cards: 0 damage")
    t.require(ui.presents_count() == presents_initial, &"0 CALayer presents when idle")

    // Hover and click card 1 in the live host window.
    c1x := ui.scene.card1_bounds.x + 20
    c1y := ui.scene.card1_bounds.y + 20
    t.require(ui.inject_pointer_move(c1x, c1y) == 1, &"hover card 1 damages 1 rect")
    t.require(ui.presents_count() == presents_initial + 1, &"1 CALayer present on hover change")
    t.require(ui.inject_pointer_move(c1x + 2, c1y + 2) == 0, &"moving within card 1 causes 0 redraws")
    t.require(ui.presents_count() == presents_initial + 1, &"still 0 extra presents")

    // Test ABI 14 pages, components, lists and trees.
    t.require(ui.add_page(&"home") == 0, &"add_page")
    t.require(ui.add_box(&"home", &"items", false, 4) == 0, &"list host")
    t.require(ui.add_box(&"home", &"form", false, 4) == 0, &"tree host")
    t.require(ui.add_label(&"home", &"status", &"listo") == 0, &"add_label")
    t.require(ui.add_button(&"home", &"save", &"Guardar", 7) == 0, &"add_button")
    t.require(ui.add_entry(&"home", &"name", &"Ana", 9) == 0, &"add_entry")
    t.require(ui.set_submit(&"name", 10) == 0, &"set_submit")
    t.require(ui.show_page(&"home") == 0, &"show_page")

    t.require(ui.trigger_key(&"save") == 0, &"trigger button")
    t.require(ui.next() == 1007, &"button action")
    t.require(ui.complete_event(0) == 0, &"complete_event")

    // Dynamic list reconciliation.
    t.require(ui.list_begin(&"items", 2) == 0, &"list begin")
    t.require(ui.list_item(&"a", &"Uno", 11) == 0, &"item a")
    t.require(ui.list_item(&"b", &"Dos", 12) == 0, &"item b")
    t.require(ui.list_end() == 0, &"list end")
    t.require(ui.first_child_key(&"items").eq(&"a"), &"order a, b")

    t.require(ui.list_begin(&"items", 1) == 0, &"list reorder")
    t.require(ui.list_item(&"b", &"Dos!", 12) == 0, &"keep b")
    t.require(ui.list_end() == 0, &"list end 2")
    t.require(!ui.has_widget(&"a") && ui.has_widget(&"b"), &"a pruned, b kept")
    t.require(ui.first_child_key(&"items").eq(&"b"), &"b is first")

    // Snapshot from live window session.
    snap_path := "/tmp/tarn-ui-cairn-window-snapshot.png"
    t.require(ui.snapshot_png(&snap_path) == 0, &"snapshot_png from session")
    removed := fs.remove_file(&snap_path)

    t.require(ui.request_close() == 0, &"request_close")
    t.require(ui.next() == 2, &"closed")
    t.require(ui.release() == 0, &"release")
}
