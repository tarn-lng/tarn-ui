// Retained Desktop Shell Scene for Milestone B6 (`scene_b6.tarn`):
// Pure-Tarn CPU tile renderer for the Cairn Desktop Environment (`desktop-spec.md` §2.2–§2.4):
// - Cached `Wallpaper("lago")` + `.glass` Topbar pills + Floating Dock with live mouse
//   magnification (`mass: 0.1, stiffness: 170, damping: 14`)
// - Desktop Widgets (`ClockWidget`, `StorageWidget` when `w >= 1000`)
// - Multi-window manager (`welcome`, `archivos`, `ajustes`, `terminal`) with traffic lights,
//   z-order stacking, minimize/maximize/close, and window drag
// - Integrated `Archivos` (`FileManager` + `b6_vfs` + `DetailsPane` `420/40` spring + `QuickLook` + Toast)
// - Integrated `Ajustes` (`SettingsApp` with 9 sections + live theme/accent/transparency)
// - Desktop Popovers (`System Menu`, `CalendarPop`, `ControlCenter`, `Launcher Ctrl+K`)
import "backend/damage"
import "backend/render"
import "backend/text"
import "backend/icons"
import "backend/anim"
import "backend/theme"
import "backend/b6_vfs"
import "backend/png"
import "backend/objc"

pub const PANEL_NONE i32 = 0
pub const PANEL_SYS i32 = 1
pub const PANEL_CAL i32 = 2
pub const PANEL_CC i32 = 3
pub const PANEL_SEARCH i32 = 4

pub const DOCK_COUNT usize = 5

fn draw_solid(c &mut render.Canvas, bounds damage.Rect, fill render.Color, border render.Color, hi render.Color, r f64, bw f64, clip damage.Rect) {
    c.draw_rrect(bounds, render.RRectStyle {
        fill_top: fill,
        fill_bottom: fill,
        border_color: border,
        inner_hi: hi,
        radii: render.uniform_radii(r),
        border_width: bw,
    }, clip)
}

fn pt_in(r damage.Rect, x i32, y i32) bool {
    return x >= r.x && x < r.x + r.w && y >= r.y && y < r.y + r.h
}

pub struct DesktopWin {
    pub id string
    pub title string
    pub open bool
    pub minimized bool
    pub maximized bool
    pub bare bool
    pub z u32
    pub rect damage.Rect
    pub saved_rect damage.Rect
}

pub struct SceneB6 {
    pub width i32
    pub height i32
    pub scale i32
    pub th theme.Theme
    pub frame render.Canvas
    pub wallpaper render.Canvas
    pub damage damage.DamageRegion
    pub fonts text.FontPair
    pub atlas text.GlyphAtlas

    // Desktop state
    pub time_24h bool
    pub wifi_on bool
    pub sound_on bool
    pub mode_idx i32
    pub panel i32
    pub cal_month_offset i32
    pub cal_selected_day i32
    pub search_query string
    pub search_sel i32

    // Dock magnification (`mass: 0.1, stiffness: 170, damping: 14`)
    pub dock_base i32
    pub dock_sizes [5]anim.Spring
    pub dock_mouse_x i32
    pub dock_mouse_y i32
    pub dock_capsule damage.Rect

    // Windows (`0=welcome`, `1=archivos`, `2=ajustes`, `3=terminal`)
    pub wins [4]DesktopWin
    pub z_counter u32
    pub focused_win i32
    pub drag_win i32
    pub drag_off_x i32
    pub drag_off_y i32

    // File Manager (`Archivos`) state
    pub vfs b6_vfs.Vfs
    pub fm_view string      // "home", "recent", "trash", "tag:1".."tag:4", or folder id
    pub fm_grid bool
    pub fm_selected_id string
    pub fm_details_open bool
    pub fm_details_w anim.Spring
    pub fm_quicklook_id string
    pub fm_toast_msg string
    pub fm_toast_undo_id string

    // Settings (`Ajustes`) state
    pub set_section i32     // 0..8

    // Telemetry
    pub first_frame_ns u64
    pub frames_rendered u64
    pub tiles_rendered u64
}

fn dock_app_id(i usize) string {
    if i == 0 { return "archivos" }
    if i == 1 { return "navegador" }
    if i == 2 { return "terminal" }
    if i == 3 { return "ajustes" }
    return "welcome"
}

fn dock_app_title(i usize) string {
    if i == 0 { return "Archivos" }
    if i == 1 { return "Navegador" }
    if i == 2 { return "Terminal" }
    if i == 3 { return "Ajustes" }
    return "Bienvenida"
}

fn dock_app_icon(i usize) u32 {
    if i == 0 { return icons.ICON_FOLDER }
    if i == 1 { return icons.ICON_GLOBE }
    if i == 2 { return icons.ICON_TERMINAL }
    if i == 3 { return icons.ICON_SETTINGS }
    return icons.ICON_SPARKLES
}

fn dock_app_color(i usize) render.Color {
    if i == 0 { return render.hex_rgb(5999093) }  // #5b8df5
    if i == 1 { return render.hex_rgb(2864035) }  // #2bb3a3
    if i == 2 { return render.hex_rgb(9080757) }  // #8a8fb5
    if i == 3 { return render.hex_rgb(10124784) } // #9a7df0
    return render.hex_rgb(8023282)                // #7a6cf2
}

fn compute_dock_base(w i32) i32 {
    var b = (w - 120) / 6
    if b < 30 { b = 30 }
    if b > 46 { b = 46 }
    return b
}

pub fn SceneB6.new(width i32, height i32, scale i32) SceneB6 {
    t0 := objc.monotonic_ns()
    th := theme.Theme.default_dark()
    fonts := match text.load_cairn_fonts() {
        Ok(fp) => fp
        Err(code) => { panic("SceneB6 load_cairn_fonts failed: " + code.to_string()) }
    }
    var atlas = text.GlyphAtlas.new(512, 512)
    var wp = render.Canvas.new(width, height, scale)
    wp.render_wallpaper_lago()

    var frame = render.Canvas.new(width, height, scale)
    frame.blit_from(&wp, damage.rect(0, 0, width, height))

    db := compute_dock_base(width)
    dbf := f64(db)
    dock_cap := damage.rect((width - (db * 5 + 64)) / 2, height - db - 28, db * 5 + 64, db + 16)

    var fw_w = 740
    if fw_w > width - 80 { fw_w = width - 80 }
    var fw_h = 440
    if fw_h > height - 130 { fw_h = height - 130 }

    var sw_w = 700
    if sw_w > width - 80 { sw_w = width - 80 }
    var sw_h = 440
    if sw_h > height - 130 { sw_h = height - 130 }

    w0_r := damage.rect((width - 440) / 2, (height - 300) / 2 - 20, 440, 300)
    w1_r := damage.rect(60, 58, fw_w, fw_h)
    w2_r := damage.rect(96, 82, sw_w, sw_h)
    w3_r := damage.rect(140, 108, 460, 300)

    wins := [4]DesktopWin {
        DesktopWin { id: "welcome", title: "Bienvenida", open: true, minimized: false, maximized: false, bare: false, z: 1, rect: w0_r, saved_rect: w0_r },
        DesktopWin { id: "archivos", title: "Archivos", open: false, minimized: false, maximized: false, bare: true, z: 0, rect: w1_r, saved_rect: w1_r },
        DesktopWin { id: "ajustes", title: "Ajustes", open: false, minimized: false, maximized: false, bare: true, z: 0, rect: w2_r, saved_rect: w2_r },
        DesktopWin { id: "terminal", title: "Terminal", open: false, minimized: false, maximized: false, bare: false, z: 0, rect: w3_r, saved_rect: w3_r },
    }

    var dmg = damage.DamageRegion.new()
    dmg.add_full(width, height)

    var sc = SceneB6 {
        width: width,
        height: height,
        scale: scale,
        th: th,
        frame: frame,
        wallpaper: wp,
        damage: dmg,
        fonts: fonts,
        atlas: atlas,
        time_24h: true,
        wifi_on: true,
        sound_on: true,
        mode_idx: 1,
        panel: PANEL_NONE,
        cal_month_offset: 0,
        cal_selected_day: 16,
        search_query: "",
        search_sel: 0,
        dock_base: db,
        dock_sizes: [5]anim.Spring {
            anim.spring_dock(dbf),
            anim.spring_dock(dbf),
            anim.spring_dock(dbf),
            anim.spring_dock(dbf),
            anim.spring_dock(dbf),
        },
        dock_mouse_x: -9999,
        dock_mouse_y: -9999,
        dock_capsule: dock_cap,
        wins: wins,
        z_counter: 1,
        focused_win: 0,
        drag_win: -1,
        drag_off_x: 0,
        drag_off_y: 0,
        vfs: b6_vfs.Vfs.seed(),
        fm_view: "documentos",
        fm_grid: true,
        fm_selected_id: "",
        fm_details_open: false,
        fm_details_w: anim.Spring.new(0.0, 420.0, 40.0, 1.0, 0.5),
        fm_quicklook_id: "",
        fm_toast_msg: "",
        fm_toast_undo_id: "",
        set_section: 2,
        first_frame_ns: 0,
        frames_rendered: 0,
        tiles_rendered: 0,
    }
    rd := sc.render_damaged()
    t1 := objc.monotonic_ns()
    sc.first_frame_ns = t1 - t0
    return sc
}

pub fn SceneB6.has_active_animations(&self) bool {
    if self.fm_details_w.active { return true }
    var i: usize = 0
    for i < DOCK_COUNT {
        if self.dock_sizes[i].active { return true }
        i = i + 1
    }
    return false
}

fn dock_dirty_bounds(sc &SceneB6) damage.Rect {
    max_sz := i32(f64(sc.dock_base) * 1.65) + 16
    w := sc.dock_base * 5 + 140
    x := (sc.width - w) / 2
    var y = sc.height - max_sz - 28
    if y < 0 { y = 0 }
    return damage.rect(x, y, w, max_sz + 24)
}

pub fn SceneB6.step_animations(&mut self, dt_s f64) bool {
    var any = false
    var dock_changed = false
    var i: usize = 0
    for i < DOCK_COUNT {
        if self.dock_sizes[i].advance(dt_s, false) {
            dock_changed = true
            any = true
        }
        i = i + 1
    }
    if dock_changed {
        self.damage.add(dock_dirty_bounds(self), self.width, self.height)
    }
    if self.fm_details_w.advance(dt_s, false) {
        if self.wins[1].open && !self.wins[1].minimized {
            self.damage.add(self.wins[1].rect, self.width, self.height)
        }
        any = true
    }
    return any
}

pub fn SceneB6.open_app(&mut self, idx i32) {
    if idx < 0 || idx >= 4 { return }
    self.z_counter = self.z_counter + 1
    self.wins[usize(idx)].open = true
    self.wins[usize(idx)].minimized = false
    self.wins[usize(idx)].z = self.z_counter
    self.focused_win = idx
    self.panel = PANEL_NONE
    self.damage.add(self.wins[usize(idx)].rect, self.width, self.height)
    self.damage.add(damage.rect(0, 0, self.width, 46), self.width, self.height)
    self.damage.add(dock_dirty_bounds(self), self.width, self.height)
}

pub fn SceneB6.close_win(&mut self, idx i32) {
    if idx < 0 || idx >= 4 { return }
    r := self.wins[usize(idx)].rect
    self.wins[usize(idx)].open = false
    self.wins[usize(idx)].minimized = false
    if self.focused_win == idx { self.focused_win = -1 }
    self.damage.add(r, self.width, self.height)
    self.damage.add(damage.rect(0, 0, self.width, 46), self.width, self.height)
    self.damage.add(dock_dirty_bounds(self), self.width, self.height)
}

pub fn SceneB6.toggle_maximize(&mut self, idx i32) {
    if idx < 0 || idx >= 4 { return }
    old_r := self.wins[usize(idx)].rect
    if self.wins[usize(idx)].maximized {
        self.wins[usize(idx)].maximized = false
        self.wins[usize(idx)].rect = self.wins[usize(idx)].saved_rect
    } else {
        self.wins[usize(idx)].saved_rect = old_r
        self.wins[usize(idx)].maximized = true
        self.wins[usize(idx)].rect = damage.rect(8, 48, self.width - 16, self.height - self.dock_base - 84)
    }
    self.damage.add(old_r.union(&self.wins[usize(idx)].rect), self.width, self.height)
}

pub fn SceneB6.apply_theme(&mut self, dark bool, accent_idx u32, transparency u32) {
    c0 := self.th.set_dark(dark)
    c1 := self.th.set_accent(accent_idx)
    c2 := self.th.set_transparency(transparency)
    if c0 || c1 || c2 {
        self.damage.add_full(self.width, self.height)
    }
}

// ---- Rendering ----

fn topbar_left_rect() damage.Rect { return damage.rect(12, 7, 176, 34) }
fn topbar_center_rect(w i32) damage.Rect { return damage.rect((w - 188) / 2, 7, 188, 34) }
fn topbar_right_rect(w i32) damage.Rect { return damage.rect(w - 124, 7, 112, 34) }

pub fn SceneB6.draw_tile(&mut self, tile damage.Rect) {
    self.frame.blit_from(&self.wallpaper, tile)
    s := f64(self.scale)
    pal := self.th.palette

    // 1. Desktop Widgets (`w >= 1000` on right)
    if self.width >= 1000 {
        clk_r := damage.rect(self.width - 216, 54, 200, 126)
        if tile.intersects(&clk_r) {
            draw_solid(&mut self.frame, clk_r, pal.surface, pal.edge, pal.hi, 22.0 * s, 1.0, tile)
            d_wd := text.draw_text_line(&mut self.frame, &mut self.atlas, &self.fonts.body, &"Lunes", f64(clk_r.x + 16), f64(clk_r.y + 14), 168.0, 0, text.body_style(12.0 * s, pal.accent_text, true), tile)
            var t_str = "21:17"
            if !self.time_24h { t_str = "9:17 PM" }
            var st_clk = text.display_style(32.0 * s, pal.text)
            st_clk.tabular_nums = true
            d_tm := text.draw_text_line(&mut self.frame, &mut self.atlas, &self.fonts.display, &t_str, f64(clk_r.x + 16), f64(clk_r.y + 42), 168.0, 0, st_clk, tile)
            d_dt := text.draw_text_line(&mut self.frame, &mut self.atlas, &self.fonts.body, &"16 de noviembre", f64(clk_r.x + 16), f64(clk_r.y + 92), 168.0, 0, text.body_style(12.0 * s, pal.muted, false), tile)
        }
        sto_r := damage.rect(self.width - 216, 192, 200, 126)
        if tile.intersects(&sto_r) {
            draw_solid(&mut self.frame, sto_r, pal.surface, pal.edge, pal.hi, 22.0 * s, 1.0, tile)
            d_st0 := text.draw_text_line(&mut self.frame, &mut self.atlas, &self.fonts.body, &"Almacenamiento", f64(sto_r.x + 16), f64(sto_r.y + 14), 168.0, 0, text.body_style(12.0 * s, pal.text, true), tile)
            d_st1 := text.draw_text_line(&mut self.frame, &mut self.atlas, &self.fonts.display, &"9.4 GB", f64(sto_r.x + 16), f64(sto_r.y + 44), 168.0, 0, text.display_style(24.0 * s, pal.accent_text), tile)
            draw_solid(&mut self.frame, damage.rect(sto_r.x + 16, sto_r.y + 82, 168, 6), pal.track, render.rgba(0, 0, 0, 0), render.rgba(0, 0, 0, 0), 3.0, 0.0, tile)
            draw_solid(&mut self.frame, damage.rect(sto_r.x + 16, sto_r.y + 82, 62, 6), pal.accent, render.rgba(0, 0, 0, 0), render.rgba(0, 0, 0, 0), 3.0, 0.0, tile)
            d_st2 := text.draw_text_line(&mut self.frame, &mut self.atlas, &self.fonts.body, &"5.2 GB sist · 4.2 GB apps", f64(sto_r.x + 16), f64(sto_r.y + 98), 168.0, 0, text.body_style(10.5 * s, pal.muted, false), tile)
        }
    }

    // 2. Windows sorted by z-order ascending
    var order = [4]i32{0, 1, 2, 3}
    var a: usize = 0
    for a < 4 {
        var b = a + 1
        for b < 4 {
            if self.wins[usize(order[b])].z < self.wins[usize(order[a])].z {
                tmp := order[a]
                order[a] = order[b]
                order[b] = tmp
            }
            b = b + 1
        }
        a = a + 1
    }
    var wi: usize = 0
    for wi < 4 {
        idx := usize(order[wi])
        if self.wins[idx].open && !self.wins[idx].minimized && tile.intersects(&self.wins[idx].rect) {
            self.draw_window(idx, tile)
        }
        wi = wi + 1
    }

    // 3. Topbar 3 floating `.glass` pills
    if tile.y < 48 {
        l_r := topbar_left_rect()
        if tile.intersects(&l_r) {
            draw_solid(&mut self.frame, l_r, pal.surface, pal.edge, pal.hi, 17.0 * s, 1.0, tile)
            icons.draw_cairn_mark(&mut self.frame, f64(l_r.x + 10), f64(l_r.y + 8), 18.0, tile)
            var t_lbl = "Escritorio"
            if self.focused_win >= 0 && self.wins[usize(self.focused_win)].open {
                t_lbl = self.wins[usize(self.focused_win)].title.clone()
            }
            dt := text.draw_text_truncated(&mut self.frame, &mut self.atlas, &self.fonts.body, &t_lbl, f64(l_r.x + 34), f64(l_r.y + 9), f64(l_r.w - 44), 0, text.body_style(12.5 * s, pal.text, true), tile)
        }
        c_r := topbar_center_rect(self.width)
        if tile.intersects(&c_r) {
            draw_solid(&mut self.frame, c_r, pal.surface, pal.edge, pal.hi, 17.0 * s, 1.0, tile)
            var clk_txt = "21:17 · Lun 16 nov"
            if !self.time_24h { clk_txt = "9:17 PM · Lun 16 nov" }
            dc := text.draw_text_line(&mut self.frame, &mut self.atlas, &self.fonts.body, &clk_txt, f64(c_r.x), f64(c_r.y + 9), f64(c_r.w), 1, text.body_style(12.0 * s, pal.text, true), tile)
        }
        r_r := topbar_right_rect(self.width)
        if tile.intersects(&r_r) {
            draw_solid(&mut self.frame, r_r, pal.surface, pal.edge, pal.hi, 17.0 * s, 1.0, tile)
            i_src := icons.draw_icon(&mut self.frame, &mut self.atlas, icons.ICON_SEARCH, r_r.x + 14, r_r.y + 9, 15.0 * s, 2.0, pal.text, tile)
            i_wif := icons.draw_icon(&mut self.frame, &mut self.atlas, icons.ICON_WIFI, r_r.x + 48, r_r.y + 9, 15.0 * s, 2.0, pal.text, tile)
            i_sl := icons.draw_icon(&mut self.frame, &mut self.atlas, icons.ICON_SLIDERS_HORIZONTAL, r_r.x + 80, r_r.y + 9, 15.0 * s, 2.0, pal.text, tile)
        }
    }

    // 4. Floating Dock with live mouse magnification
    dock_b := dock_dirty_bounds(self)
    if tile.intersects(&dock_b) {
        self.draw_dock(tile)
    }

    // 5. Desktop Popovers (`sys`, `cal`, `cc`, `search`)
    if self.panel != PANEL_NONE {
        self.draw_panel(tile)
    }

    // 6. Quick Look modal & Toast
    if !self.fm_quicklook_id.is_empty() {
        self.draw_quicklook(tile)
    }
    if !self.fm_toast_msg.is_empty() {
        toast_r := damage.rect((self.width - 340) / 2, self.height - self.dock_base - 76, 340, 38)
        if tile.intersects(&toast_r) {
            draw_solid(&mut self.frame, toast_r, pal.pop, pal.edge, pal.hi, 19.0, 1.0, tile)
            dt := text.draw_text_truncated(&mut self.frame, &mut self.atlas, &self.fonts.body, &self.fm_toast_msg, f64(toast_r.x + 14), f64(toast_r.y + 11), 220.0, 0, text.body_style(12.0 * s, pal.text, false), tile)
            if !self.fm_toast_undo_id.is_empty() {
                du := text.draw_text_line(&mut self.frame, &mut self.atlas, &self.fonts.body, &"Deshacer", f64(toast_r.right() - 86), f64(toast_r.y + 11), 72.0, 2, text.body_style(12.0 * s, pal.accent_text, true), tile)
            }
        }
    }
}

fn SceneB6.draw_dock(&mut self, tile damage.Rect) {
    pal := self.th.palette
    var sum_w: i32 = 16
    var i: usize = 0
    for i < DOCK_COUNT {
        sum_w = sum_w + i32(self.dock_sizes[i].pos + 0.5) + 10
        i = i + 1
    }
    cap_x := (self.width - sum_w) / 2
    cap_h := self.dock_base + 16
    cap_y := self.height - cap_h - 12
    self.dock_capsule = damage.rect(cap_x, cap_y, sum_w, cap_h)
    draw_solid(&mut self.frame, self.dock_capsule, pal.surface, pal.edge, pal.hi, 22.0, 1.0, tile)

    var cur_x = cap_x + 12
    base_y := cap_y + cap_h - 8
    i = 0
    for i < DOCK_COUNT {
        sz := i32(self.dock_sizes[i].pos + 0.5)
        iy := base_y - sz
        ir := damage.rect(cur_x, iy, sz, sz)
        if tile.intersects(&ir) {
            icons.draw_app_icon(&mut self.frame, &mut self.atlas, cur_x, iy, sz, dock_app_color(i), dock_app_icon(i), tile)
        }
        // Running dot
        if i < 4 && self.wins[i].open {
            dot_r := damage.rect(cur_x + (sz - 5) / 2, cap_y + cap_h - 6, 5, 4)
            draw_solid(&mut self.frame, dot_r, pal.text, render.rgba(0, 0, 0, 0), render.rgba(0, 0, 0, 0), 2.0, 0.0, tile)
        }
        cur_x = cur_x + sz + 10
        i = i + 1
    }
}

fn draw_traffic_lights(c &mut render.Canvas, x i32, y i32, th &theme.Theme, clip damage.Rect) {
    tl_b := render.rgba(0, 0, 0, 56)
    tl_h := render.rgba(0, 0, 0, 0)
    draw_solid(c, damage.rect(x, y, 11, 11), th.semantic.tl_close, tl_b, tl_h, 5.5, 1.0, clip)
    draw_solid(c, damage.rect(x + 18, y, 11, 11), th.semantic.tl_min, tl_b, tl_h, 5.5, 1.0, clip)
    draw_solid(c, damage.rect(x + 36, y, 11, 11), th.semantic.tl_max, tl_b, tl_h, 5.5, 1.0, clip)
}

fn SceneB6.draw_window(&mut self, idx usize, tile damage.Rect) {
    s := f64(self.scale)
    pal := self.th.palette
    r := self.wins[idx].rect
    var bcol = pal.edge
    if i32(idx) == self.focused_win { bcol = pal.line_strong }
    draw_solid(&mut self.frame, r, pal.surface, bcol, pal.hi, 22.0 * s, 1.0, tile)

    if !self.wins[idx].bare {
        draw_traffic_lights(&mut self.frame, r.x + 16, r.y + 16, &self.th, tile)
        draw_solid(&mut self.frame, damage.rect(r.x + 1, r.y + 42, r.w - 2, 1), pal.line, render.rgba(0, 0, 0, 0), render.rgba(0, 0, 0, 0), 0.0, 0.0, tile)
        title := self.wins[idx].title.clone()
        dt := text.draw_text_line(&mut self.frame, &mut self.atlas, &self.fonts.body, &title, f64(r.x + 80), f64(r.y + 14), f64(r.w - 160), 1, text.body_style(13.0 * s, pal.text, true), tile)
        if idx == 0 {
            // Welcome window
            icons.draw_cairn_mark(&mut self.frame, f64(r.x + (r.w - 56) / 2), f64(r.y + 70), 56.0, tile)
            d0 := text.draw_text_line(&mut self.frame, &mut self.atlas, &self.fonts.display, &"Bienvenido a Cairn", f64(r.x + 24), f64(r.y + 144), f64(r.w - 48), 1, text.display_style(24.0 * s, pal.text), tile)
            d1 := text.draw_text_line(&mut self.frame, &mut self.atlas, &self.fonts.body, &"Tu sistema. Tus reglas.", f64(r.x + 24), f64(r.y + 180), f64(r.w - 48), 1, text.body_style(13.5 * s, pal.accent_text, true), tile)
        } else {
            // Terminal window
            d0 := text.draw_text_line(&mut self.frame, &mut self.atlas, &self.fonts.body, &"cairn@desktop:~$ uname -a", f64(r.x + 20), f64(r.y + 62), f64(r.w - 40), 0, text.body_style(12.5 * s, pal.accent_text, true), tile)
            d1 := text.draw_text_line(&mut self.frame, &mut self.atlas, &self.fonts.body, &"Cairn OS 0.1 microkernel (Tarn puro)", f64(r.x + 20), f64(r.y + 88), f64(r.w - 40), 0, text.body_style(12.5 * s, pal.text, false), tile)
        }
        return
    }

    if idx == 1 {
        self.draw_files_window(r, tile)
    } else if idx == 2 {
        self.draw_settings_window(r, tile)
    }
}

fn SceneB6.draw_files_window(&mut self, r damage.Rect, tile damage.Rect) {
    s := f64(self.scale)
    pal := self.th.palette
    side_w := 184
    draw_solid(&mut self.frame, damage.rect(r.x + 1, r.y + 1, side_w, r.h - 2), pal.side, render.rgba(0, 0, 0, 0), render.rgba(0, 0, 0, 0), 20.0, 0.0, tile)
    draw_solid(&mut self.frame, damage.rect(r.x + side_w, r.y + 1, 1, r.h - 2), pal.line, render.rgba(0, 0, 0, 0), render.rgba(0, 0, 0, 0), 0.0, 0.0, tile)
    draw_traffic_lights(&mut self.frame, r.x + 16, r.y + 16, &self.th, tile)

    // Sidebar items
    s_ids := [8]string{"recent", "home", "escritorio", "documentos", "descargas", "imagenes", "tag:1", "trash"}
    s_lbls := [8]string{"Recientes", "Inicio", "Escritorio", "Documentos", "Descargas", "Imágenes", "Importante", "Papelera"}
    var si: usize = 0
    for si < 8 {
        sr := damage.rect(r.x + 10, r.y + 48 + i32(si) * 30, side_w - 20, 26)
        if self.fm_view.eq(&s_ids[si]) {
            draw_solid(&mut self.frame, sr, pal.accent_soft, pal.line, render.rgba(0, 0, 0, 0), 8.0, 1.0, tile)
        }
        var lbl = s_lbls[si].clone()
        if si == 7 {
            tc := self.vfs.trash_count()
            if tc > 0 { lbl = lbl + " (" + tc.to_string() + ")" }
        }
        ds := text.draw_text_truncated(&mut self.frame, &mut self.atlas, &self.fonts.body, &lbl, f64(sr.x + 10), f64(sr.y + 6), f64(sr.w - 16), 0, text.body_style(12.0 * s, pal.text, self.fm_view.eq(&s_ids[si])), tile)
        si = si + 1
    }

    // Toolbar
    main_x := r.x + side_w + 1
    main_w := r.w - side_w - 1
    draw_solid(&mut self.frame, damage.rect(main_x, r.y + 48, main_w, 1), pal.line, render.rgba(0, 0, 0, 0), render.rgba(0, 0, 0, 0), 0.0, 0.0, tile)
    dt_v := text.draw_text_line(&mut self.frame, &mut self.atlas, &self.fonts.display, &("Archivos · " + self.fm_view.clone()), f64(main_x + 16), f64(r.y + 14), 240.0, 0, text.display_style(15.0 * s, pal.text), tile)
    btn_new := damage.rect(r.right() - 190, r.y + 10, 84, 28)
    draw_solid(&mut self.frame, btn_new, pal.accent, render.rgba(255, 255, 255, 45), pal.hi, 8.0, 1.0, tile)
    dn := text.draw_text_line(&mut self.frame, &mut self.atlas, &self.fonts.body, &"+ Nueva", f64(btn_new.x), f64(btn_new.y + 7), f64(btn_new.w), 1, text.body_style(11.5 * s, render.rgb(255, 255, 255), true), tile)
    btn_det := damage.rect(r.right() - 96, r.y + 10, 80, 28)
    draw_solid(&mut self.frame, btn_det, pal.card, pal.line, render.rgba(0, 0, 0, 0), 8.0, 1.0, tile)
    dd := text.draw_text_line(&mut self.frame, &mut self.atlas, &self.fonts.body, &"Detalles", f64(btn_det.x), f64(btn_det.y + 7), f64(btn_det.w), 1, text.body_style(11.5 * s, pal.text, true), tile)

    // DetailsPane (`420/40` spring width)
    det_w := i32(self.fm_details_w.pos + 0.5)
    body_w := main_w - det_w
    if det_w > 12 {
        det_r := damage.rect(r.right() - det_w, r.y + 49, det_w - 1, r.h - 50)
        draw_solid(&mut self.frame, det_r, pal.side, pal.line, render.rgba(0, 0, 0, 0), 0.0, 1.0, tile)
        var d_title = "Sin selección"
        if !self.fm_selected_id.is_empty() && self.vfs.nodes.contains(&self.fm_selected_id) {
            d_title = self.vfs.nodes.get(&self.fm_selected_id).name.clone()
        }
        d_dt := text.draw_text_truncated(&mut self.frame, &mut self.atlas, &self.fonts.body, &d_title, f64(det_r.x + 12), f64(det_r.y + 16), f64(det_w - 24), 0, text.body_style(12.5 * s, pal.text, true), tile)
    }

    // Items grid
    var items = self.fm_current_items()
    cols := (body_w - 24) / 118
    var c_cnt = cols
    if c_cnt < 1 { c_cnt = 1 }
    var ii: usize = 0
    for ii < items.len() && ii < 12 {
        col := i32(ii) % c_cnt
        row := i32(ii) / c_cnt
        ir := damage.rect(main_x + 14 + col * 118, r.y + 62 + row * 94, 108, 84)
        if ir.bottom() < r.bottom() - 10 && tile.intersects(&ir) {
            it := items.get(ii)
            is_sel := self.fm_selected_id.eq(&it.id)
            var fill = render.rgba(0, 0, 0, 0)
            var bcol = render.rgba(0, 0, 0, 0)
            if is_sel {
                fill = pal.accent_soft
                bcol = pal.accent
            }
            draw_solid(&mut self.frame, ir, fill, bcol, render.rgba(0, 0, 0, 0), 12.0, 1.5, tile)
            var ic = icons.ICON_BOX
            if it.is_folder { ic = icons.ICON_FOLDER }
            draw_solid(&mut self.frame, damage.rect(ir.x + 32, ir.y + 10, 44, 44), pal.card, pal.line, render.rgba(0, 0, 0, 0), 11.0, 1.0, tile)
            i_ic := icons.draw_icon(&mut self.frame, &mut self.atlas, ic, ir.x + 42, ir.y + 20, 24.0 * s, 2.0, pal.accent_text, tile)
            di := text.draw_text_truncated(&mut self.frame, &mut self.atlas, &self.fonts.body, &it.name, f64(ir.x + 6), f64(ir.y + 60), f64(ir.w - 12), 1, text.body_style(11.0 * s, pal.text, is_sel), tile)
        }
        ii = ii + 1
    }
}

fn SceneB6.fm_current_items(&self) Vec<b6_vfs.VfsNode> {
    if self.fm_view.eq(&"recent") { return self.vfs.recent_files() }
    if self.fm_view.eq(&"trash") { return self.vfs.trashed_items() }
    if self.fm_view.eq(&"tag:1") { return self.vfs.tagged_files(b6_vfs.TAG_IMPORTANTE) }
    return self.vfs.children_of(&self.fm_view)
}

fn SceneB6.draw_settings_window(&mut self, r damage.Rect, tile damage.Rect) {
    s := f64(self.scale)
    pal := self.th.palette
    side_w := 210
    draw_solid(&mut self.frame, damage.rect(r.x + 1, r.y + 1, side_w, r.h - 2), pal.side, render.rgba(0, 0, 0, 0), render.rgba(0, 0, 0, 0), 20.0, 0.0, tile)
    draw_solid(&mut self.frame, damage.rect(r.x + side_w, r.y + 1, 1, r.h - 2), pal.line, render.rgba(0, 0, 0, 0), render.rgba(0, 0, 0, 0), 0.0, 0.0, tile)
    draw_traffic_lights(&mut self.frame, r.x + 16, r.y + 16, &self.th, tile)

    secs := [9]string{"Tu cuenta", "Red y Wi-Fi", "Apariencia", "Idioma y región", "Aplicaciones", "Almacenamiento", "Privacidad", "Atajos", "Acerca de Cairn"}
    var si: i32 = 0
    for si < 9 {
        sr := damage.rect(r.x + 10, r.y + 52 + si * 34, side_w - 20, 28)
        if si == self.set_section {
            draw_solid(&mut self.frame, sr, pal.accent_soft, pal.line, render.rgba(0, 0, 0, 0), 9.0, 1.0, tile)
        }
        ds := text.draw_text_truncated(&mut self.frame, &mut self.atlas, &self.fonts.body, &secs[usize(si)], f64(sr.x + 10), f64(sr.y + 7), f64(sr.w - 16), 0, text.body_style(12.0 * s, pal.text, si == self.set_section), tile)
        si = si + 1
    }

    main_x := r.x + side_w + 24
    main_w := r.w - side_w - 48
    sec_title := secs[usize(self.set_section)].clone()
    d_h := text.draw_text_line(&mut self.frame, &mut self.atlas, &self.fonts.display, &sec_title, f64(main_x), f64(r.y + 24), f64(main_w), 0, text.display_style(22.0 * s, pal.text), tile)
    if self.set_section == 2 {
        // Apariencia
        d_m := text.draw_text_line(&mut self.frame, &mut self.atlas, &self.fonts.body, &"Modo y color de acento", f64(main_x), f64(r.y + 66), f64(main_w), 0, text.body_style(12.5 * s, pal.muted, false), tile)
        var ai: u32 = 0
        for ai < 6 {
            ar := damage.rect(main_x + i32(ai) * 40, r.y + 94, 30, 30)
            draw_solid(&mut self.frame, ar, render.hex_rgb(theme.accent_hex(ai)), pal.hi, pal.hi, 15.0, 2.0, tile)
            ai = ai + 1
        }
    } else if self.set_section == 5 {
        // Almacenamiento
        draw_solid(&mut self.frame, damage.rect(main_x, r.y + 72, main_w, 12), pal.track, render.rgba(0, 0, 0, 0), render.rgba(0, 0, 0, 0), 6.0, 0.0, tile)
        draw_solid(&mut self.frame, damage.rect(main_x, r.y + 72, main_w / 3, 12), pal.accent, render.rgba(0, 0, 0, 0), render.rgba(0, 0, 0, 0), 6.0, 0.0, tile)
        d_s := text.draw_text_line(&mut self.frame, &mut self.atlas, &self.fonts.body, &"9.4 GB usados de 256 GB", f64(main_x), f64(r.y + 96), f64(main_w), 0, text.body_style(13.0 * s, pal.text, true), tile)
    } else if self.set_section == 8 {
        // Acerca de Cairn
        icons.draw_cairn_mark(&mut self.frame, f64(main_x), f64(r.y + 72), 48.0, tile)
        d_a := text.draw_text_line(&mut self.frame, &mut self.atlas, &self.fonts.body, &"Cairn OS 0.1 · Pure-Tarn Desktop Shell (B6)", f64(main_x + 62), f64(r.y + 88), f64(main_w - 62), 0, text.body_style(13.0 * s, pal.text, true), tile)
    }
}

fn SceneB6.draw_panel(&mut self, tile damage.Rect) {
    s := f64(self.scale)
    pal := self.th.palette
    if self.panel == PANEL_SYS {
        pr := damage.rect(12, 48, 240, 140)
        if !tile.intersects(&pr) { return }
        draw_solid(&mut self.frame, pr, pal.pop, pal.edge, pal.hi, 18.0, 1.0, tile)
        opts := [3]string{"Ver bienvenida", "Ajustes del sistema", "Abrir Archivos"}
        var i: i32 = 0
        for i < 3 {
            ir := damage.rect(pr.x + 8, pr.y + 10 + i * 38, pr.w - 16, 32)
            draw_solid(&mut self.frame, ir, pal.card, pal.line, render.rgba(0, 0, 0, 0), 10.0, 1.0, tile)
            di := text.draw_text_line(&mut self.frame, &mut self.atlas, &self.fonts.body, &opts[usize(i)], f64(ir.x + 12), f64(ir.y + 8), f64(ir.w - 24), 0, text.body_style(12.5 * s, pal.text, false), tile)
            i = i + 1
        }
        return
    }
    if self.panel == PANEL_CAL {
        pr := damage.rect((self.width - 300) / 2, 48, 300, 290)
        if !tile.intersects(&pr) { return }
        draw_solid(&mut self.frame, pr, pal.pop, pal.edge, pal.hi, 20.0, 1.0, tile)
        dh := text.draw_text_line(&mut self.frame, &mut self.atlas, &self.fonts.display, &"Noviembre 2026", f64(pr.x + 16), f64(pr.y + 14), 180.0, 0, text.display_style(16.0 * s, pal.text), tile)
        // 7x5 day grid
        var day: i32 = 1
        for day <= 30 {
            col := (day - 1) % 7
            row := (day - 1) / 7
            dr := damage.rect(pr.x + 16 + col * 38, pr.y + 52 + row * 34, 32, 28)
            if day == 16 {
                draw_solid(&mut self.frame, dr, pal.accent, pal.hi, pal.hi, 8.0, 1.0, tile)
            } else if day == self.cal_selected_day {
                draw_solid(&mut self.frame, dr, pal.accent_soft, pal.accent, render.rgba(0, 0, 0, 0), 8.0, 1.5, tile)
            }
            var st_d = text.body_style(11.5 * s, pal.text, day == 16)
            st_d.tabular_nums = true
            dd := text.draw_text_line(&mut self.frame, &mut self.atlas, &self.fonts.body, &day.to_string(), f64(dr.x), f64(dr.y + 6), f64(dr.w), 1, st_d, tile)
            day = day + 1
        }
        df := text.draw_text_line(&mut self.frame, &mut self.atlas, &self.fonts.body, &"Hoy no tienes eventos.", f64(pr.x + 16), f64(pr.bottom() - 34), 268.0, 0, text.body_style(12.0 * s, pal.muted, false), tile)
        return
    }
    if self.panel == PANEL_CC {
        pr := damage.rect(self.width - 328, 48, 316, 250)
        if !tile.intersects(&pr) { return }
        draw_solid(&mut self.frame, pr, pal.pop, pal.edge, pal.hi, 20.0, 1.0, tile)
        // QuickTiles: Wi-Fi & Sonido
        w_r := damage.rect(pr.x + 14, pr.y + 14, 138, 52)
        s_r := damage.rect(pr.x + 164, pr.y + 14, 138, 52)
        draw_solid(&mut self.frame, w_r, if_col(self.wifi_on, pal.accent, pal.card), pal.line, pal.hi, 12.0, 1.0, tile)
        draw_solid(&mut self.frame, s_r, if_col(self.sound_on, pal.accent, pal.card), pal.line, pal.hi, 12.0, 1.0, tile)
        dw := text.draw_text_line(&mut self.frame, &mut self.atlas, &self.fonts.body, &"Wi-Fi", f64(w_r.x + 12), f64(w_r.y + 18), 114.0, 0, text.body_style(13.0 * s, pal.text, true), tile)
        ds := text.draw_text_line(&mut self.frame, &mut self.atlas, &self.fonts.body, &"Sonido", f64(s_r.x + 12), f64(s_r.y + 18), 114.0, 0, text.body_style(13.0 * s, pal.text, true), tile)
        // Mode segmented
        mr := damage.rect(pr.x + 14, pr.y + 80, pr.w - 28, 34)
        draw_solid(&mut self.frame, mr, pal.track, pal.line, render.rgba(0, 0, 0, 0), 10.0, 1.0, tile)
        mw := (mr.w - 6) / 3
        draw_solid(&mut self.frame, damage.rect(mr.x + 3 + self.mode_idx * mw, mr.y + 3, mw, mr.h - 6), pal.pill, render.rgba(0, 0, 0, 0), pal.hi, 8.0, 0.0, tile)
        modes := [3]string{"Claro", "Oscuro", "Auto"}
        var mi: i32 = 0
        for mi < 3 {
            dm := text.draw_text_line(&mut self.frame, &mut self.atlas, &self.fonts.body, &modes[usize(mi)], f64(mr.x + 3 + mi * mw), f64(mr.y + 8), f64(mw), 1, text.body_style(11.5 * s, pal.text, mi == self.mode_idx), tile)
            mi = mi + 1
        }
        // 6 Accents
        var ai: u32 = 0
        for ai < 6 {
            ar := damage.rect(pr.x + 16 + i32(ai) * 48, pr.y + 130, 32, 32)
            draw_solid(&mut self.frame, ar, render.hex_rgb(theme.accent_hex(ai)), pal.hi, pal.hi, 16.0, 2.0, tile)
            ai = ai + 1
        }
        // Transparency bar
        d_tr := text.draw_text_line(&mut self.frame, &mut self.atlas, &self.fonts.body, &("Transparencia: " + self.th.transparency.to_string() + "%"), f64(pr.x + 16), f64(pr.y + 180), 280.0, 0, text.body_style(12.0 * s, pal.muted, false), tile)
        draw_solid(&mut self.frame, damage.rect(pr.x + 16, pr.y + 206, pr.w - 32, 8), pal.track, render.rgba(0, 0, 0, 0), render.rgba(0, 0, 0, 0), 4.0, 0.0, tile)
        fw := ((pr.w - 32) * i32(self.th.transparency)) / 100
        draw_solid(&mut self.frame, damage.rect(pr.x + 16, pr.y + 206, fw, 8), pal.accent, render.rgba(0, 0, 0, 0), render.rgba(0, 0, 0, 0), 4.0, 0.0, tile)
        return
    }
    if self.panel == PANEL_SEARCH {
        pr := damage.rect((self.width - 480) / 2, self.height / 7, 480, 260)
        if !tile.intersects(&pr) { return }
        draw_solid(&mut self.frame, pr, pal.pop, pal.edge, pal.hi, 20.0, 1.0, tile)
        inp_r := damage.rect(pr.x + 14, pr.y + 14, pr.w - 28, 38)
        draw_solid(&mut self.frame, inp_r, pal.card, pal.accent, render.rgba(0, 0, 0, 0), 11.0, 1.5, tile)
        var q_shown = "Buscar aplicaciones y acciones..."
        if !self.search_query.is_empty() { q_shown = self.search_query.clone() }
        dq := text.draw_text_truncated(&mut self.frame, &mut self.atlas, &self.fonts.body, &q_shown, f64(inp_r.x + 12), f64(inp_r.y + 11), f64(inp_r.w - 24), 0, text.body_style(13.0 * s, pal.text, false), tile)
        items := [4]string{"Abrir Archivos", "Abrir Ajustes", "Activar modo claro", "Activar modo oscuro"}
        var i: i32 = 0
        for i < 4 {
            ir := damage.rect(pr.x + 14, pr.y + 64 + i * 44, pr.w - 28, 36)
            var fill = pal.card
            if i == self.search_sel { fill = pal.accent_soft }
            draw_solid(&mut self.frame, ir, fill, pal.line, render.rgba(0, 0, 0, 0), 10.0, 1.0, tile)
            di := text.draw_text_line(&mut self.frame, &mut self.atlas, &self.fonts.body, &items[usize(i)], f64(ir.x + 12), f64(ir.y + 10), f64(ir.w - 24), 0, text.body_style(12.5 * s, pal.text, i == self.search_sel), tile)
            i = i + 1
        }
    }
}

fn if_col(cond bool, a render.Color, b render.Color) render.Color {
    if cond { return a }
    return b
}

fn SceneB6.draw_quicklook(&mut self, tile damage.Rect) {
    if !self.vfs.nodes.contains(&self.fm_quicklook_id) { return }
    s := f64(self.scale)
    pal := self.th.palette
    mr := damage.rect((self.width - 460) / 2, (self.height - 300) / 2, 460, 300)
    if !tile.intersects(&mr) { return }
    draw_solid(&mut self.frame, mr, pal.pop, pal.edge, pal.hi, 18.0, 1.0, tile)
    node := self.vfs.nodes.get(&self.fm_quicklook_id).clone()
    d0 := text.draw_text_truncated(&mut self.frame, &mut self.atlas, &self.fonts.display, &node.name, f64(mr.x + 18), f64(mr.y + 16), 340.0, 0, text.display_style(16.0 * s, pal.text), tile)
    draw_solid(&mut self.frame, damage.rect(mr.x + 1, mr.y + 48, mr.w - 2, 1), pal.line, render.rgba(0, 0, 0, 0), render.rgba(0, 0, 0, 0), 0.0, 0.0, tile)
    if !node.content.is_empty() {
        para := text.layout_paragraph(&self.fonts.body, &node.content, f64(mr.w - 36), text.body_style(12.0 * s, pal.text, false))
        dp := text.draw_paragraph_layout(&mut self.frame, &mut self.atlas, &self.fonts.body, &para, f64(mr.x + 18), f64(mr.y + 64), f64(mr.w - 36), 0, text.body_style(12.0 * s, pal.text, false), tile)
    } else {
        meta := b6_vfs.kind_label(node.kind) + " · " + node.size_kb.to_string() + " KB · " + node.mtime
        dm := text.draw_text_line(&mut self.frame, &mut self.atlas, &self.fonts.body, &meta, f64(mr.x + 18), f64(mr.y + 130), f64(mr.w - 36), 1, text.body_style(13.0 * s, pal.muted, false), tile)
    }
}

pub fn SceneB6.render_damaged(&mut self) u32 {
    if self.damage.is_empty() { return 0 }
    n := self.damage.len()
    var i: usize = 0
    for i < n {
        r := self.damage.at(i)
        self.draw_tile(r)
        i = i + 1
    }
    self.frames_rendered = self.frames_rendered + 1
    self.tiles_rendered = self.tiles_rendered + u64(n)
    return u32(n)
}

// ---- Pointer & Keyboard Interaction ----

pub fn SceneB6.on_pointer_move(&mut self, x i32, y i32) bool {
    if self.drag_win >= 0 && usize(self.drag_win) < 4 {
        idx := usize(self.drag_win)
        old_r := self.wins[idx].rect
        nx := x - self.drag_off_x
        var ny = y - self.drag_off_y
        if ny < 46 { ny = 46 }
        self.wins[idx].rect = damage.rect(nx, ny, old_r.w, old_r.h)
        self.damage.add(old_r.union(&self.wins[idx].rect), self.width, self.height)
        return true
    }

    // Dock magnification target calculation
    var changed = false
    in_dock := y >= self.height - self.dock_base * 2 - 30
    if in_dock {
        self.dock_mouse_x = x
        self.dock_mouse_y = y
    } else if self.dock_mouse_x != -9999 {
        self.dock_mouse_x = -9999
        self.dock_mouse_y = -9999
    } else {
        return false
    }

    var cur_x = self.dock_capsule.x + 12
    var i: usize = 0
    for i < DOCK_COUNT {
        sz := i32(self.dock_sizes[i].pos + 0.5)
        center_x := cur_x + sz / 2
        var target = f64(self.dock_base)
        if in_dock {
            var d = i32(x - center_x)
            if d < 0 { d = 0 - d }
            if d < 120 {
                target = f64(self.dock_base) * (1.65 - 0.65 * (f64(d) / 120.0))
            }
        }
        if (self.dock_sizes[i].target - target).abs() > 0.1 {
            self.dock_sizes[i].set_target(target)
            changed = true
        }
        cur_x = cur_x + sz + 10
        i = i + 1
    }
    return changed
}

pub fn SceneB6.on_pointer_down(&mut self, x i32, y i32) bool {
    // Check top-most window header drag
    var top_idx: i32 = -1
    var best_z: u32 = 0
    var i: usize = 0
    for i < 4 {
        if self.wins[i].open && !self.wins[i].minimized && pt_in(self.wins[i].rect, x, y) {
            if self.wins[i].z >= best_z {
                best_z = self.wins[i].z
                top_idx = i32(i)
            }
        }
        i = i + 1
    }
    if top_idx >= 0 {
        self.z_counter = self.z_counter + 1
        self.wins[usize(top_idx)].z = self.z_counter
        self.focused_win = top_idx
        r := self.wins[usize(top_idx)].rect
        if y <= r.y + 42 && x > r.x + 68 {
            self.drag_win = top_idx
            self.drag_off_x = x - r.x
            self.drag_off_y = y - r.y
        }
        self.damage.add(r, self.width, self.height)
        return true
    }
    return false
}

pub fn SceneB6.on_pointer_up(&mut self, x i32, y i32) i32 {
    self.drag_win = -1
    if !self.fm_quicklook_id.is_empty() {
        self.fm_quicklook_id = ""
        self.damage.add_full(self.width, self.height)
        return 1
    }

    // Topbar pills
    if pt_in(topbar_left_rect(), x, y) {
        if self.panel == PANEL_SYS { self.panel = PANEL_NONE } else { self.panel = PANEL_SYS }
        self.damage.add_full(self.width, self.height)
        return 2
    }
    if pt_in(topbar_center_rect(self.width), x, y) {
        if self.panel == PANEL_CAL { self.panel = PANEL_NONE } else { self.panel = PANEL_CAL }
        self.damage.add_full(self.width, self.height)
        return 3
    }
    if pt_in(topbar_right_rect(self.width), x, y) {
        if x < self.width - 80 {
            if self.panel == PANEL_SEARCH { self.panel = PANEL_NONE } else { self.panel = PANEL_SEARCH }
        } else {
            if self.panel == PANEL_CC { self.panel = PANEL_NONE } else { self.panel = PANEL_CC }
        }
        self.damage.add_full(self.width, self.height)
        return 4
    }

    // Open Popover clicks
    if self.panel == PANEL_CC {
        pr := damage.rect(self.width - 328, 48, 316, 250)
        if pt_in(pr, x, y) {
            if pt_in(damage.rect(pr.x + 14, pr.y + 14, 138, 52), x, y) {
                self.wifi_on = !self.wifi_on
                self.damage.add(pr, self.width, self.height)
                return 10
            }
            if pt_in(damage.rect(pr.x + 164, pr.y + 14, 138, 52), x, y) {
                self.sound_on = !self.sound_on
                self.damage.add(pr, self.width, self.height)
                return 11
            }
            mr := damage.rect(pr.x + 14, pr.y + 80, pr.w - 28, 34)
            if pt_in(mr, x, y) {
                idx := (x - mr.x - 3) / ((mr.w - 6) / 3)
                if idx >= 0 && idx < 3 {
                    self.mode_idx = idx
                    self.apply_theme(idx != 0, self.th.accent_idx, self.th.transparency)
                }
                return 12
            }
            var ai: u32 = 0
            for ai < 6 {
                if pt_in(damage.rect(pr.x + 16 + i32(ai) * 48, pr.y + 130, 32, 32), x, y) {
                    self.apply_theme(self.th.dark, ai, self.th.transparency)
                    return 13
                }
                ai = ai + 1
            }
            return 14
        }
        self.panel = PANEL_NONE
        self.damage.add_full(self.width, self.height)
        return 0
    }
    if self.panel == PANEL_SYS {
        pr := damage.rect(12, 48, 240, 140)
        if pt_in(pr, x, y) {
            idx := (y - pr.y - 10) / 38
            if idx == 0 { self.open_app(0) } else if idx == 1 { self.open_app(2) } else if idx == 2 { self.open_app(1) }
            return 15
        }
        self.panel = PANEL_NONE
        self.damage.add_full(self.width, self.height)
        return 0
    }
    if self.panel != PANEL_NONE {
        self.panel = PANEL_NONE
        self.damage.add_full(self.width, self.height)
        return 0
    }

    // Dock click
    if pt_in(self.dock_capsule, x, y) {
        var cur_x = self.dock_capsule.x + 12
        var i: usize = 0
        for i < DOCK_COUNT {
            sz := i32(self.dock_sizes[i].pos + 0.5)
            if x >= cur_x && x < cur_x + sz {
                if i == 0 { self.open_app(1) } else if i == 2 { self.open_app(3) } else if i == 3 { self.open_app(2) } else if i == 4 { self.open_app(0) }
                return 20 + i32(i)
            }
            cur_x = cur_x + sz + 10
            i = i + 1
        }
    }

    // Window Traffic Lights & Internal Controls
    if self.focused_win >= 0 && self.wins[usize(self.focused_win)].open {
        idx := usize(self.focused_win)
        r := self.wins[idx].rect
        if pt_in(damage.rect(r.x + 12, r.y + 12, 18, 18), x, y) {
            self.close_win(i32(idx))
            return 30
        }
        if pt_in(damage.rect(r.x + 30, r.y + 12, 18, 18), x, y) {
            self.wins[idx].minimized = true
            self.damage.add(r, self.width, self.height)
            return 31
        }
        if pt_in(damage.rect(r.x + 48, r.y + 12, 18, 18), x, y) {
            self.toggle_maximize(i32(idx))
            return 32
        }
        if idx == 1 {
            // Archivos toolbar "+ Nueva" and "Detalles"
            btn_new := damage.rect(r.right() - 190, r.y + 10, 84, 28)
            btn_det := damage.rect(r.right() - 96, r.y + 10, 80, 28)
            if pt_in(btn_new, x, y) {
                created := self.vfs.create_folder(&self.fm_view, &"Nueva carpeta")
                self.fm_selected_id = created
                self.damage.add(r, self.width, self.height)
                return 40
            }
            if pt_in(btn_det, x, y) {
                self.fm_details_open = !self.fm_details_open
                if self.fm_details_open { self.fm_details_w.set_target(210.0) } else { self.fm_details_w.set_target(0.0) }
                return 41
            }
        }
    }

    // ClockWidget click toggles 24h/12h
    if self.width >= 1000 && pt_in(damage.rect(self.width - 216, 54, 200, 126), x, y) {
        self.time_24h = !self.time_24h
        self.damage.add(damage.rect(self.width - 216, 54, 200, 126), self.width, self.height)
        self.damage.add(topbar_center_rect(self.width), self.width, self.height)
        return 50
    }
    return 0
}

pub fn SceneB6.on_key_input(&mut self, keycode i64, chars &string) bool {
    // Space toggles QuickLook when Archivos is focused
    if keycode == 49 && self.focused_win == 1 && self.panel == PANEL_NONE {
        if !self.fm_quicklook_id.is_empty() {
            self.fm_quicklook_id = ""
        } else if !self.fm_selected_id.is_empty() {
            self.fm_quicklook_id = self.fm_selected_id.clone()
        } else {
            items := self.fm_current_items()
            if !items.is_empty() {
                self.fm_quicklook_id = items.get(0).id.clone()
            }
        }
        self.damage.add_full(self.width, self.height)
        return true
    }
    if self.panel == PANEL_SEARCH {
        if keycode == 125 {
            self.search_sel = (self.search_sel + 1) % 4
            self.damage.add_full(self.width, self.height)
            return true
        }
        if keycode == 126 {
            self.search_sel = (self.search_sel + 3) % 4
            self.damage.add_full(self.width, self.height)
            return true
        }
        if keycode == 36 || keycode == 76 {
            sel := self.search_sel
            self.panel = PANEL_NONE
            if sel == 0 { self.open_app(1) } else if sel == 1 { self.open_app(2) } else if sel == 2 {
                self.mode_idx = 0
                self.apply_theme(false, self.th.accent_idx, self.th.transparency)
            } else {
                self.mode_idx = 1
                self.apply_theme(true, self.th.accent_idx, self.th.transparency)
            }
            self.damage.add_full(self.width, self.height)
            return true
        }
    }
    return false
}

pub fn SceneB6.snapshot_png(&self, path &string) Result<string, i32> {
    return png.write_bgra_png(path, self.frame.pixels.as_slice(), u32(self.width), u32(self.height))
}
