// DamageRegion tracker (ADR 0009 §2, §8): coalesced axis-aligned bounding boxes
// (max 16 rects before merging) aligned to 32x32 tiles so only dirty tiles are
// rasterized and blitted. Zero heap allocations on the steady-state frame path.

pub const TILE_SIZE i32 = 32
pub const MAX_DAMAGE_RECTS usize = 16

pub copy struct Rect {
    pub x i32
    pub y i32
    pub w i32
    pub h i32
}

pub fn rect(x i32, y i32, w i32, h i32) Rect {
    if w <= 0 || h <= 0 {
        return Rect { x: 0, y: 0, w: 0, h: 0 }
    }
    return Rect { x: x, y: y, w: w, h: h }
}

pub fn Rect.is_empty(&self) bool {
    return self.w <= 0 || self.h <= 0
}

pub fn Rect.right(&self) i32 {
    return self.x + self.w
}

pub fn Rect.bottom(&self) i32 {
    return self.y + self.h
}

pub fn Rect.area(&self) i64 {
    if self.is_empty() { return 0 }
    return i64(self.w) * i64(self.h)
}

pub fn Rect.contains_point(&self, px i32, py i32) bool {
    return px >= self.x && px < self.x + self.w && py >= self.y && py < self.y + self.h
}

pub fn Rect.contains_rect(&self, other &Rect) bool {
    if other.is_empty() { return true }
    if self.is_empty() { return false }
    return other.x >= self.x && other.y >= self.y && other.right() <= self.right() && other.bottom() <= self.bottom()
}

pub fn Rect.intersects(&self, other &Rect) bool {
    if self.is_empty() || other.is_empty() { return false }
    return self.x < other.right() && self.right() > other.x && self.y < other.bottom() && self.bottom() > other.y
}

pub fn Rect.intersect(&self, other &Rect) Rect {
    if !self.intersects(other) {
        return Rect { x: 0, y: 0, w: 0, h: 0 }
    }
    var x0 = self.x
    if other.x > x0 { x0 = other.x }
    var y0 = self.y
    if other.y > y0 { y0 = other.y }
    var x1 = self.right()
    if other.right() < x1 { x1 = other.right() }
    var y1 = self.bottom()
    if other.bottom() < y1 { y1 = other.bottom() }
    return rect(x0, y0, x1 - x0, y1 - y0)
}

pub fn Rect.union(&self, other &Rect) Rect {
    if self.is_empty() { return *other }
    if other.is_empty() { return *self }
    var x0 = self.x
    if other.x < x0 { x0 = other.x }
    var y0 = self.y
    if other.y < y0 { y0 = other.y }
    var x1 = self.right()
    if other.right() > x1 { x1 = other.right() }
    var y1 = self.bottom()
    if other.bottom() > y1 { y1 = other.bottom() }
    return rect(x0, y0, x1 - x0, y1 - y0)
}

pub fn Rect.clamp(&self, max_w i32, max_h i32) Rect {
    return self.intersect(&rect(0, 0, max_w, max_h))
}

// Aligns a rectangle outward to 32x32 pixel tile boundaries and clamps to surface.
pub fn Rect.align_tiles(&self, max_w i32, max_h i32) Rect {
    clamped := self.clamp(max_w, max_h)
    if clamped.is_empty() { return clamped }
    x0 := (clamped.x / TILE_SIZE) * TILE_SIZE
    y0 := (clamped.y / TILE_SIZE) * TILE_SIZE
    var x1 = ((clamped.right() + TILE_SIZE - 1) / TILE_SIZE) * TILE_SIZE
    var y1 = ((clamped.bottom() + TILE_SIZE - 1) / TILE_SIZE) * TILE_SIZE
    if x1 > max_w { x1 = max_w }
    if y1 > max_h { y1 = max_h }
    return rect(x0, y0, x1 - x0, y1 - y0)
}

pub copy struct DamageRegion {
    rects [16]Rect
    count usize
}

pub fn DamageRegion.new() DamageRegion {
    empty := Rect { x: 0, y: 0, w: 0, h: 0 }
    return DamageRegion {
        rects: [16]Rect{
            empty, empty, empty, empty, empty, empty, empty, empty,
            empty, empty, empty, empty, empty, empty, empty, empty
        },
        count: 0,
    }
}

pub fn DamageRegion.is_empty(&self) bool {
    return self.count == 0
}

pub fn DamageRegion.len(&self) usize {
    return self.count
}

pub fn DamageRegion.at(&self, index usize) Rect {
    return self.rects[index]
}

pub fn DamageRegion.clear(&mut self) {
    self.count = 0
}

// Adds a dirty rectangle aligned to tile boundaries, coalescing overlapping or
// contained rects and keeping the list bounded to MAX_DAMAGE_RECTS (16).
pub fn DamageRegion.add(&mut self, dirty Rect, surface_w i32, surface_h i32) {
    aligned := dirty.align_tiles(surface_w, surface_h)
    if aligned.is_empty() { return }

    var candidate = aligned
    var i: usize = 0
    for i < self.count {
        existing := self.rects[i]
        if existing.contains_rect(&candidate) {
            return
        }
        if candidate.contains_rect(&existing) || existing.intersects(&candidate) {
            candidate = existing.union(&candidate)
            self.rects[i] = self.rects[self.count - 1]
            self.count = self.count - 1
        } else {
            i = i + 1
        }
    }

    if self.count < MAX_DAMAGE_RECTS {
        self.rects[self.count] = candidate
        self.count = self.count + 1
        return
    }

    // Region full: merge the pair with the smallest area increase.
    var best_i: usize = 0
    var best_value = self.rects[0].union(&candidate)
    var best_cost = best_value.area() - self.rects[0].area()
    var j: usize = 1
    for j < self.count {
        merged := self.rects[j].union(&candidate)
        cost := merged.area() - self.rects[j].area()
        if cost < best_cost {
            best_cost = cost
            best_i = j
            best_value = merged
        }
        j = j + 1
    }
    self.rects[best_i] = best_value
}

pub fn DamageRegion.add_full(&mut self, surface_w i32, surface_h i32) {
    self.clear()
    full := rect(0, 0, surface_w, surface_h)
    if !full.is_empty() {
        self.rects[0] = full
        self.count = 1
    }
}

pub fn DamageRegion.bounds(&self) Rect {
    if self.count == 0 {
        return Rect { x: 0, y: 0, w: 0, h: 0 }
    }
    var acc = self.rects[0]
    var i: usize = 1
    for i < self.count {
        acc = acc.union(&self.rects[i])
        i = i + 1
    }
    return acc
}
