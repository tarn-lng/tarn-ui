// Tests for Milestone B3 of the Cairn self-drawn backend (`b3_test.tarn`):
// 1. Interruptible second-order spring physics (under-damped, critically damped,
//    over-damped, zero-jump mid-flight retargeting, reduced-motion snap) and
//    cubic-bezier(`[0.22, 0.8, 0.3, 1]`) timeline evaluation.
// 2. Deterministic headless PNG snapshots at fixed animation times (`t=0ms`,
//    `t=110ms` mid-transition, `t=500ms` settled) with Dual-Kawase glass blur.
// 3. 1080p animation p99 frame time (< 4 ms / 4,000 us ADR 0009 budget) and
//    0-redraw idle invariant + live macOS host window refresh-paced check.
import "testing"
import "fs"
import "backend/anim"
import "backend/scene_b3"
import "backend/native"
import "backend/objc"

fn sort_u64(v &mut Vec<u64>) {
    s := v.as_mut_slice()
    n := s.len()
    var i: usize = 0
    for i < n {
        var j = i + 1
        for j < n {
            if s[j] < s[i] {
                tmp := s[i]
                s[i] = s[j]
                s[j] = tmp
            }
            j = j + 1
        }
        i = i + 1
    }
}

fn test_b3_spring_physics_retargeting_and_bezier(t &mut testing.T) {
    // 1. Under-damped spring (Sidebar 420/36) + zero-jump mid-flight retargeting
    var sp = anim.spring_sidebar(0.0)
    sp.set_target(100.0)
    t.require(sp.active, &"spring activates on target change")
    var k: i32 = 0
    for k < 5 {
        ch := sp.advance(0.016, false)
        k = k + 1
    }
    pos_before := sp.pos
    vel_before := sp.vel
    t.require(pos_before > 10.0 && pos_before < 100.0, &"spring moves smoothly toward target")
    t.require(vel_before > 0.0, &"spring builds positive velocity")

    // Interrupt mid-flight and retarget back to 0.0
    sp.set_target(0.0)
    t.require((sp.pos - pos_before).abs() < 1.0e-9, &"retargeting preserves position with zero jump")
    t.require((sp.vel - vel_before).abs() < 1.0e-9, &"retargeting preserves velocity with zero jump")
    // Immediately after 1 step, positive velocity carries it slightly forward before reversing
    ch1 := sp.advance(0.016, false)
    t.require(sp.vel < vel_before, &"spring decelerates toward new target")

    // Settle completely
    var s: i32 = 0
    for s < 120 {
        ch_s := sp.advance(0.016, false)
        s = s + 1
    }
    t.require(!sp.active && (sp.pos - 0.0).abs() < 0.05, &"spring settles at new target")

    // 2. Critically damped & over-damped regimes
    var crit = anim.Spring.new(0.0, 100.0, 20.0, 1.0, 0.001)
    crit.set_target(10.0)
    var over = anim.Spring.new(0.0, 100.0, 40.0, 1.0, 0.001)
    over.set_target(10.0)
    var step: i32 = 0
    for step < 240 {
        c0 := crit.advance(0.016, false)
        o0 := over.advance(0.016, false)
        step = step + 1
    }
    t.require(!crit.active && (crit.pos - 10.0).abs() < 0.01, &"critically damped settles")
    t.require(!over.active && (over.pos - 10.0).abs() < 0.01, &"over-damped settles")

    // 3. Reduced motion snaps in 1 step
    var rm = anim.spring_toggle(0.0)
    rm.set_target(1.0)
    ch_rm := rm.advance(0.016, true)
    t.require(ch_rm && !rm.active && rm.pos == 1.0, &"reduced_motion snaps immediately")

    // 4. Cubic-bezier [0.22, 0.8, 0.3, 1.0]
    e0 := anim.ease_cairn_step(0.0)
    em := anim.ease_cairn_step(0.5)
    e1 := anim.ease_cairn_step(1.0)
    t.require(e0 == 0.0 && e1 == 1.0 && em > 0.7 && em < 0.95, &"cairn step bezier curve shape")
}

fn render_fixed_times(prefix &string) [3]string {
    var scene = scene_b3.SceneB3.new(960, 600, 1)
    scene.damage.clear()
    p0 := prefix.clone() + "-t0.png"
    h0 := match scene.snapshot_png(&p0) {
        Ok(h) => h
        Err(c) => { panic("t0 snapshot failed: " + c.to_string()) }
    }

    scene.go_to_step(1)
    var i: i32 = 0
    for i < 7 {
        ch := scene.step_animations(0.016)
        rd := scene.render_damaged()
        scene.damage.clear()
        i = i + 1
    }
    p110 := prefix.clone() + "-t110.png"
    h110 := match scene.snapshot_png(&p110) {
        Ok(h) => h
        Err(c) => { panic("t110 snapshot failed: " + c.to_string()) }
    }

    var j: i32 = 0
    for j < 35 {
        ch := scene.step_animations(0.016)
        rd := scene.render_damaged()
        scene.damage.clear()
        j = j + 1
    }
    if scene.render_damaged() != 0 {
        panic("B3 scene not idle after 500ms")
    }
    p500 := prefix.clone() + "-t500.png"
    h500 := match scene.snapshot_png(&p500) {
        Ok(h) => h
        Err(c) => { panic("t500 snapshot failed: " + c.to_string()) }
    }
    rm0 := fs.remove_file(&p0)
    rm1 := fs.remove_file(&p110)
    rm2 := fs.remove_file(&p500)
    return [3]string{h0, h110, h500}
}

fn run_b3_bench_pass(s1080 &mut scene_b3.SceneB3) [3]u64 {
    s1080.go_to_step(0)
    var s_settle: i32 = 0
    for s_settle < 40 {
        ch_st := s1080.step_animations(0.016667)
        rd_st := s1080.render_damaged()
        s1080.damage.clear()
        s_settle = s_settle + 1
    }
    var frame_wall: Vec<u64> = Vec.with_capacity(64)
    var frame_cpu: Vec<u64> = Vec.with_capacity(64)
    s1080.go_to_step(1)
    var f: i32 = 0
    for f < 60 {
        if f == 6 {
            s1080.go_to_step(0) // mid-flight retarget
        } else if f == 12 {
            s1080.go_to_step(1)
        } else if f == 30 {
            s1080.time_24h = false
            s1080.seg_pill.set_target(1.0)
        } else if f == 42 {
            s1080.auto_tz = false
            s1080.toggle_knob.set_target(0.0)
        }
        c0 := objc.thread_cpu_ns()
        t0 := objc.monotonic_ns()
        ch := s1080.step_animations(0.016667)
        rd := s1080.render_damaged()
        s1080.damage.clear()
        t1 := objc.monotonic_ns()
        c1 := objc.thread_cpu_ns()
        if rd > 0 {
            frame_wall.push((t1 - t0) / 1000)
            frame_cpu.push((c1 - c0) / 1000)
        }
        f = f + 1
    }
    sort_u64(&mut frame_wall)
    sort_u64(&mut frame_cpu)
    cnt := frame_wall.len()
    var idx = (cnt * 99) / 100
    if idx >= cnt { idx = cnt - 1 }
    return [3]u64{u64(cnt), frame_wall.as_slice()[idx], frame_cpu.as_slice()[idx]}
}

fn test_b3_headless_snapshots_damage_and_1080p_budget(t &mut testing.T) {
    // 1. Deterministic fixed-time snapshots across independent runs
    a := render_fixed_times(&"/tmp/tarn-ui-cairn-b3-a")
    b := render_fixed_times(&"/tmp/tarn-ui-cairn-b3-b")
    t.require(a[0].eq(&b[0]), &"deterministic B3 t=0ms PNG SHA-256")
    t.require(a[1].eq(&b[1]), &"deterministic B3 t=110ms mid-transition PNG SHA-256")
    t.require(a[2].eq(&b[2]), &"deterministic B3 t=500ms settled PNG SHA-256")
    t.require(!a[0].eq(&a[1]) && !a[1].eq(&a[2]) && !a[0].eq(&a[2]), &"t=0ms, t=110ms, t=500ms frames are distinct")

    // 2. 1080p animation p99 frame time (< 4 ms / 4,000 us ADR 0009 budget)
    // Run 3 warm passes and take the median pass to avoid single-run OS preemption spikes under nice -n 10.
    var s1080 = scene_b3.SceneB3.new(1920, 1080, 1)
    s1080.damage.clear()
    var cpu_vec: Vec<u64> = Vec.with_capacity(3)
    var wall_vec: Vec<u64> = Vec.with_capacity(3)
    var pass_cnt: u64 = 0
    var pass: usize = 0
    for pass < 3 {
        res := run_b3_bench_pass(&mut s1080)
        pass_cnt = res[0]
        wall_vec.push(res[1])
        cpu_vec.push(res[2])
        pass = pass + 1
    }
    sort_u64(&mut cpu_vec)
    sort_u64(&mut wall_vec)
    med_cpu_p99 := cpu_vec.as_slice()[1]
    med_wall_p99 := wall_vec.as_slice()[1]
    print("B3 1080p anim frames=" + pass_cnt.to_string() + " median_cpu_p99_us=" + med_cpu_p99.to_string() + " median_wall_p99_us=" + med_wall_p99.to_string())
    t.require(pass_cnt > 20 && med_cpu_p99 < 4000, &"1080p animation median CPU p99 under 4 ms (4000 us) budget")
    t.require(med_wall_p99 < 6000, &"1080p animation median wall p99 within 1.5x host-load margin (< 6000 us)")
    t.require(s1080.render_damaged() == 0, &"1080p idle returns 0 redraws")

    // 3. Live macOS host window in B3 mode
    if native.display_available() {
        var ui = match native.create(&"Cairn B3 · Movimiento", &"Bienvenido a Cairn") {
            Ok(v) => v
            Err(code) => { panic("native.create B3 failed: " + code.to_string()) }
        }
        t.require(ui.surface.refresh_hz >= 30, &"queried display refresh rate")
        t.require(ui.next() == 1, &"opened event")
        cx := ui.scene_b3.get(0).btn_primary_bounds.x + 20
        cy := ui.scene_b3.get(0).btn_primary_bounds.y + 15
        clk := ui.inject_click_at(cx, cy)
        t.require(ui.scene_b3.get(0).step == 1 && ui.scene_b3.get(0).has_active_animations(), &"click triggers active B3 animations")
        t.require(ui.request_close() == 0, &"request_close")
        t.require(ui.next() == 2, &"closed")
        t.require(ui.release() == 0, &"release")
    }
}
