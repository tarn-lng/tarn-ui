// Cairn self-drawn B1 Scene (`scene_b1.tarn`):
// - Cached procedural `Wallpaper("lago")` background canvas
// - Precomputed 9-slice drop shadows (`.window`, `.card.is-on`, `.btn-primary`)
// - Centered `.glass.window` card with `26px` rounded corners, `1px` `--edge`
//   border, `1px` top inner specular `--hi` highlight, traffic lights,
//   Cairn 3-stone vector mark, interactive `.card` options with hover & active
//   (`.is-on`) states, and primary/soft action buttons
// - Damage-tracked rendering: only dirty 32x32 tiles intersecting `DamageRegion`
//   are re-composited from the cached wallpaper and redrawn. When `damage` is
//   empty, `render_damaged()` does zero work (`0%` CPU at idle).
import "backend/damage"
import "backend/render"
import "backend/png"

pub const CARD_NONE i32 = -1
pub const CARD_GLASS i32 = 0
pub const CARD_ACCENT i32 = 1
pub const CARD_BTN_PRIMARY i32 = 2
pub const CARD_BTN_SOFT i32 = 3

pub struct SceneB1 {
    pub width i32
    pub height i32
    pub scale i32
    pub palette render.ThemePalette
    pub wallpaper render.Canvas
    pub window_base render.Canvas
    pub window_base_valid bool
    pub frame render.Canvas
    pub damage damage.DamageRegion
    pub win_shadow render.NineSliceShadow
    pub active_card_shadow render.NineSliceShadow
    pub btn_shadow render.NineSliceShadow
    pub win_bounds damage.Rect
    pub card0_bounds damage.Rect
    pub card1_bounds damage.Rect
    pub btn_primary_bounds damage.Rect
    pub btn_soft_bounds damage.Rect
    pub hovered_id i32
    pub pressed_id i32
    pub selected_card i32
    pub accent_index u32
    pub frames_rendered u64
    pub tiles_rendered u64
}

fn accent_hex_by_index(idx u32) u32 {
    m := idx % 6
    if m == 0 { return 0x5457d6 } // indigo
    if m == 1 { return 0x7c4ddb } // violeta
    if m == 2 { return 0x2f6fe0 } // azul
    if m == 3 { return 0x0f8f8a } // turquesa
    if m == 4 { return 0xd1408a } // rosa
    return 0xc9601a               // cobre
}

pub fn SceneB1.new(width i32, height i32, scale i32) SceneB1 {
    var s = scale
    if s < 1 { s = 1 }
    pal := render.theme_palette(true, 0x5457d6, 45)
    var wp = render.Canvas.new(width, height, s)
    wp.render_wallpaper_lago()
    win_base := render.Canvas.new(width, height, s)
    frame := render.Canvas.new(width, height, s)

    // Precompute 9-slice drop shadows once at startup (ADR 0009 §9: 0 per-frame blur cost).
    // .window: 0 44px 90px -34px rgba(8, 10, 40, 0.7) -> net blur ~28px, offset_y 12px
    win_sh := render.NineSliceShadow.precompute(
        26.0 * f64(s),
        28.0 * f64(s),
        12 * s,
        0,
        render.rgba(8, 10, 40, 178)
    )
    // .card.is-on: 0 14px 30px -18px var(--accent)
    card_sh := render.NineSliceShadow.precompute(
        18.0 * f64(s),
        12.0 * f64(s),
        6 * s,
        0,
        pal.accent.with_alpha(110)
    )
    // .btn-primary: 0 10px 24px -10px var(--accent)
    btn_sh := render.NineSliceShadow.precompute(
        13.0 * f64(s),
        10.0 * f64(s),
        5 * s,
        0,
        pal.accent.with_alpha(140)
    )

    // Layout geometry scaled proportionally to target resolution (e.g. 960x600 or 1920x1080).
    win_w := (width * 62) / 100
    win_h := (height * 66) / 100
    win_x := (width - win_w) / 2
    win_y := (height - win_h) / 2
    win_rect := damage.rect(win_x, win_y, win_w, win_h)

    pad_x := (win_w * 6) / 100
    cards_y := win_y + (win_h * 34) / 100
    cards_h := (win_h * 36) / 100
    gap := (win_w * 3) / 100
    card_w := (win_w - pad_x * 2 - gap) / 2
    c0_rect := damage.rect(win_x + pad_x, cards_y, card_w, cards_h)
    c1_rect := damage.rect(win_x + pad_x + card_w + gap, cards_y, card_w, cards_h)

    btn_y := win_y + win_h - (win_h * 18) / 100
    btn_h := (win_h * 11) / 100
    btn_w := (win_w * 24) / 100
    bp_rect := damage.rect(win_x + win_w - pad_x - btn_w, btn_y, btn_w, btn_h)
    bs_rect := damage.rect(win_x + pad_x, btn_y, btn_w, btn_h)

    var dmg = damage.DamageRegion.new()
    dmg.add_full(width, height)

    var scene = SceneB1 {
        width: width,
        height: height,
        scale: s,
        palette: pal,
        wallpaper: wp,
        window_base: win_base,
        window_base_valid: false,
        frame: frame,
        damage: dmg,
        win_shadow: win_sh,
        active_card_shadow: card_sh,
        btn_shadow: btn_sh,
        win_bounds: win_rect,
        card0_bounds: c0_rect,
        card1_bounds: c1_rect,
        btn_primary_bounds: bp_rect,
        btn_soft_bounds: bs_rect,
        hovered_id: CARD_NONE,
        pressed_id: CARD_NONE,
        selected_card: CARD_GLASS,
        accent_index: 0,
        frames_rendered: 0,
        tiles_rendered: 0,
    }
    scene.render_damaged()
    return scene
}

// Returns the expanded bounding box (including 9-slice drop shadow halo) of an
// interactive item so damage tracking cleanly restores the background around it.
fn SceneB1.item_damage_bounds(&self, id i32) damage.Rect {
    pad := 24 * self.scale
    if id == CARD_GLASS {
        return damage.rect(self.card0_bounds.x - pad, self.card0_bounds.y - pad, self.card0_bounds.w + pad * 2, self.card0_bounds.h + pad * 2)
    }
    if id == CARD_ACCENT {
        return damage.rect(self.card1_bounds.x - pad, self.card1_bounds.y - pad, self.card1_bounds.w + pad * 2, self.card1_bounds.h + pad * 2)
    }
    if id == CARD_BTN_PRIMARY {
        return damage.rect(self.btn_primary_bounds.x - pad, self.btn_primary_bounds.y - pad, self.btn_primary_bounds.w + pad * 2, self.btn_primary_bounds.h + pad * 2)
    }
    if id == CARD_BTN_SOFT {
        return damage.rect(self.btn_soft_bounds.x - pad, self.btn_soft_bounds.y - pad, self.btn_soft_bounds.w + pad * 2, self.btn_soft_bounds.h + pad * 2)
    }
    return damage.rect(0, 0, 0, 0)
}

pub fn SceneB1.hit_test(&self, px i32, py i32) i32 {
    if self.card0_bounds.contains_point(px, py) { return CARD_GLASS }
    if self.card1_bounds.contains_point(px, py) { return CARD_ACCENT }
    if self.btn_primary_bounds.contains_point(px, py) { return CARD_BTN_PRIMARY }
    if self.btn_soft_bounds.contains_point(px, py) { return CARD_BTN_SOFT }
    return CARD_NONE
}

// Updates pointer hover position; marks ONLY the affected card(s) dirty.
// Returns true if damage was added, false if hovered item is unchanged (0 redraws).
pub fn SceneB1.on_pointer_move(&mut self, px i32, py i32) bool {
    hit := self.hit_test(px, py)
    if hit == self.hovered_id {
        return false
    }
    if self.hovered_id != CARD_NONE {
        self.damage.add(self.item_damage_bounds(self.hovered_id), self.width, self.height)
    }
    if hit != CARD_NONE {
        self.damage.add(self.item_damage_bounds(hit), self.width, self.height)
    }
    self.hovered_id = hit
    return true
}

pub fn SceneB1.on_pointer_down(&mut self, px i32, py i32) bool {
    self.on_pointer_move(px, py)
    hit := self.hit_test(px, py)
    if hit == self.pressed_id { return false }
    if self.pressed_id != CARD_NONE {
        self.damage.add(self.item_damage_bounds(self.pressed_id), self.width, self.height)
    }
    if hit != CARD_NONE {
        self.damage.add(self.item_damage_bounds(hit), self.width, self.height)
    }
    self.pressed_id = hit
    return true
}

// Releases pointer press; returns activated item ID (or CARD_NONE).
pub fn SceneB1.on_pointer_up(&mut self, px i32, py i32) i32 {
    hit := self.hit_test(px, py)
    prev_pressed := self.pressed_id
    self.pressed_id = CARD_NONE
    if prev_pressed != CARD_NONE {
        self.damage.add(self.item_damage_bounds(prev_pressed), self.width, self.height)
    }
    if hit != CARD_NONE && hit == prev_pressed {
        if hit == CARD_GLASS || hit == CARD_ACCENT {
            if self.selected_card != hit {
                old_sel := self.selected_card
                self.selected_card = hit
                self.damage.add(self.item_damage_bounds(old_sel), self.width, self.height)
                self.damage.add(self.item_damage_bounds(hit), self.width, self.height)
            }
        } else if hit == CARD_BTN_PRIMARY {
            // Cycle accent color token and damage the window card
            self.accent_index = (self.accent_index + 1) % 6
            hex := accent_hex_by_index(self.accent_index)
            self.palette = render.theme_palette(self.palette.dark, hex, self.palette.transparency)
            self.active_card_shadow.color = self.palette.accent.with_alpha(120)
            self.btn_shadow.color = self.palette.accent.with_alpha(140)
            self.window_base_valid = false
            self.damage.add(self.win_bounds, self.width, self.height)
        } else if hit == CARD_BTN_SOFT {
            // Toggle dark / light theme palette on the glass window
            self.palette = render.theme_palette(!self.palette.dark, accent_hex_by_index(self.accent_index), self.palette.transparency)
            self.window_base_valid = false
            self.damage.add(self.win_bounds, self.width, self.height)
        }
        return hit
    }
    return CARD_NONE
}

fn SceneB1.draw_card(&mut self, id i32, bounds damage.Rect, clip damage.Rect) {
    if !bounds.intersects(&clip) { return }
    s := f64(self.scale)
    is_selected := self.selected_card == id
    is_hovered := self.hovered_id == id
    is_pressed := self.pressed_id == id

    var card_bounds = bounds
    if is_pressed {
        // Subtle active inset (`transform: scale(.97)`)
        shrink_x := (bounds.w * 2) / 100
        shrink_y := (bounds.h * 2) / 100
        card_bounds = damage.rect(bounds.x + shrink_x, bounds.y + shrink_y, bounds.w - shrink_x * 2, bounds.h - shrink_y * 2)
    } else if is_hovered {
        // `button.card:hover { transform: translateY(-1px); }`
        card_bounds = damage.rect(bounds.x, bounds.y - self.scale, bounds.w, bounds.h)
    }

    if is_selected {
        self.frame.draw_shadow_9slice(card_bounds, &self.active_card_shadow, clip)
    }

    var fill = self.palette.card
    var border = self.palette.line
    if is_selected {
        fill = self.palette.accent_soft
        border = self.palette.accent
        if is_hovered {
            fill = render.color_mix(self.palette.accent, 32, self.palette.card_hover)
        }
    } else if is_hovered {
        fill = self.palette.card_hover
        border = self.palette.line_strong
    }

    var bw = 1.0
    if is_selected { bw = 1.5 }
    style := render.RRectStyle {
        radii: render.uniform_radii(18.0 * s),
        fill_top: fill,
        fill_bottom: fill,
        border_color: border,
        border_width: bw,
        inner_hi: self.palette.hi,
    }
    self.frame.draw_rrect(card_bounds, style, clip)

    // Draw inner preview art inside the card:
    // Left card (CARD_GLASS): Cairn 3-stone mark + glass layers preview
    // Right card (CARD_ACCENT): Accent swatch pills + segmented bar preview
    pad := (card_bounds.w * 8) / 100
    inner_x := card_bounds.x + pad
    inner_y := card_bounds.y + pad
    inner_w := card_bounds.w - pad * 2

    // Radio check circle at top-right of card (`.check` 24x24px)
    chk_sz := 22 * self.scale
    chk_rect := damage.rect(card_bounds.right() - pad - chk_sz, inner_y, chk_sz, chk_sz)
    var chk_fill = render.rgba(0, 0, 0, 0)
    var chk_border = self.palette.line_strong
    if is_selected {
        chk_fill = self.palette.accent
        chk_border = self.palette.accent
    }
    chk_style := render.RRectStyle {
        radii: render.uniform_radii(11.0 * s),
        fill_top: chk_fill,
        fill_bottom: chk_fill,
        border_color: chk_border,
        border_width: 1.5,
        inner_hi: render.rgba(0, 0, 0, 0),
    }
    self.frame.draw_rrect(chk_rect, chk_style, clip)
    if is_selected {
        dot_sz := 8 * self.scale
        dot_rect := damage.rect(chk_rect.x + (chk_sz - dot_sz) / 2, chk_rect.y + (chk_sz - dot_sz) / 2, dot_sz, dot_sz)
        self.frame.draw_rrect(dot_rect, render.solid_rrect(4.0 * s, render.rgb(255, 255, 255), render.rgba(0, 0, 0, 0), render.rgba(0, 0, 0, 0)), clip)
    }

    if id == CARD_GLASS {
        // Cairn 3-stone mark (`brand.mjs`: bottom, middle, top stones + sun dot)
        stone_hi := render.rgba(255, 255, 255, 180)
        // Top sun dot
        sun_sz := 10 * self.scale
        sun_rect := damage.rect(inner_x + 56 * self.scale, inner_y + 4 * self.scale, sun_sz, sun_sz)
        self.frame.draw_rrect(sun_rect, render.RRectStyle {
            radii: render.uniform_radii(5.0 * s),
            fill_top: render.hex_rgb(0xffe2b8),
            fill_bottom: render.hex_rgb(0xff9a55),
            border_color: render.rgba(0, 0, 0, 0),
            border_width: 0.0,
            inner_hi: render.rgba(0, 0, 0, 0),
        }, clip)
        // Top stone (c)
        sc_rect := damage.rect(inner_x + 22 * self.scale, inner_y + 10 * self.scale, 28 * self.scale, 14 * self.scale)
        self.frame.draw_rrect(sc_rect, render.RRectStyle {
            radii: render.uniform_radii(7.0 * s),
            fill_top: render.hex_rgb(0xd2d4ff),
            fill_bottom: render.hex_rgb(0x8a85f6),
            border_color: stone_hi,
            border_width: 1.0,
            inner_hi: stone_hi,
        }, clip)
        // Middle stone (b)
        sb_rect := damage.rect(inner_x + 10 * self.scale, inner_y + 27 * self.scale, 50 * self.scale, 17 * self.scale)
        self.frame.draw_rrect(sb_rect, render.RRectStyle {
            radii: render.uniform_radii(8.5 * s),
            fill_top: render.hex_rgb(0xb4b9ff),
            fill_bottom: render.hex_rgb(0x5f58ec),
            border_color: stone_hi,
            border_width: 1.0,
            inner_hi: stone_hi,
        }, clip)
        // Bottom stone (a)
        sa_rect := damage.rect(inner_x, inner_y + 47 * self.scale, 74 * self.scale, 22 * self.scale)
        self.frame.draw_rrect(sa_rect, render.RRectStyle {
            radii: render.uniform_radii(11.0 * s),
            fill_top: render.hex_rgb(0x9aa0ff),
            fill_bottom: render.hex_rgb(0x4a43df),
            border_color: stone_hi,
            border_width: 1.0,
            inner_hi: stone_hi,
        }, clip)
    } else {
        // 6 Accent color swatches row (`ACCENTS` from desktop-spec.md §1.2)
        sw_sz := 24 * self.scale
        sw_gap := 8 * self.scale
        var i: u32 = 0
        for i < 6 {
            c_hex := accent_hex_by_index(i)
            sw_x := inner_x + i32(i) * (sw_sz + sw_gap)
            sw_y := inner_y + 20 * self.scale
            if sw_x + sw_sz <= card_bounds.right() - pad {
                sw_rect := damage.rect(sw_x, sw_y, sw_sz, sw_sz)
                is_act := i == self.accent_index
                var sw_border = self.palette.edge
                var sw_bw = 1.0
                if is_act {
                    sw_border = render.rgb(255, 255, 255)
                    sw_bw = 2.0
                }
                self.frame.draw_rrect(sw_rect, render.RRectStyle {
                    radii: render.uniform_radii(12.0 * s),
                    fill_top: render.hex_rgb(c_hex),
                    fill_bottom: render.hex_rgb(c_hex),
                    border_color: sw_border,
                    border_width: sw_bw,
                    inner_hi: self.palette.hi,
                }, clip)
            }
            i = i + 1
        }
    }

    // Bottom caption bars inside the card
    bar1_y := card_bounds.bottom() - pad - 28 * self.scale
    bar1 := damage.rect(inner_x, bar1_y, (inner_w * 62) / 100, 10 * self.scale)
    self.frame.draw_rrect(bar1, render.solid_rrect(5.0 * s, self.palette.text.with_alpha(210), render.rgba(0, 0, 0, 0), render.rgba(0, 0, 0, 0)), clip)

    bar2_y := card_bounds.bottom() - pad - 10 * self.scale
    bar2 := damage.rect(inner_x, bar2_y, (inner_w * 42) / 100, 7 * self.scale)
    self.frame.draw_rrect(bar2, render.solid_rrect(3.5 * s, self.palette.muted, render.rgba(0, 0, 0, 0), render.rgba(0, 0, 0, 0)), clip)
}

fn SceneB1.ensure_window_base(&mut self) {
    if self.window_base_valid { return }
    full := damage.rect(0, 0, self.width, self.height)
    self.window_base.blit_from(&self.wallpaper, full)

    s := f64(self.scale)
    self.window_base.draw_shadow_9slice(self.win_bounds, &self.win_shadow, full)

    win_top := render.color_mix(self.palette.surface, 92, render.rgb(255, 255, 255).with_alpha(self.palette.surface.a))
    win_style := render.RRectStyle {
        radii: render.uniform_radii(26.0 * s),
        fill_top: win_top,
        fill_bottom: self.palette.surface,
        border_color: self.palette.edge,
        border_width: 1.0,
        inner_hi: self.palette.hi,
    }
    self.window_base.draw_rrect(self.win_bounds, win_style, full)

    // Window header traffic lights (`TL`: #ff5f57, #febc2e, #28c840, 13x13px)
    tl_y := self.win_bounds.y + 20 * self.scale
    tl_x := self.win_bounds.x + 22 * self.scale
    tl_sz := 13 * self.scale
    tl_gap := 21 * self.scale
    tl_border := render.rgba(0, 0, 0, 56)
    self.window_base.draw_rrect(damage.rect(tl_x, tl_y, tl_sz, tl_sz), render.solid_rrect(6.5 * s, render.hex_rgb(0xff5f57), tl_border, render.rgba(0, 0, 0, 0)), full)
    self.window_base.draw_rrect(damage.rect(tl_x + tl_gap, tl_y, tl_sz, tl_sz), render.solid_rrect(6.5 * s, render.hex_rgb(0xfebc2e), tl_border, render.rgba(0, 0, 0, 0)), full)
    self.window_base.draw_rrect(damage.rect(tl_x + tl_gap * 2, tl_y, tl_sz, tl_sz), render.solid_rrect(6.5 * s, render.hex_rgb(0x28c840), tl_border, render.rgba(0, 0, 0, 0)), full)

    pad_x := (self.win_bounds.w * 6) / 100
    head_y := self.win_bounds.y + (self.win_bounds.h * 15) / 100
    title_bar := damage.rect(self.win_bounds.x + pad_x, head_y, (self.win_bounds.w * 38) / 100, 16 * self.scale)
    self.window_base.draw_rrect(title_bar, render.solid_rrect(8.0 * s, self.palette.text, render.rgba(0, 0, 0, 0), render.rgba(0, 0, 0, 0)), full)
    sub_bar := damage.rect(self.win_bounds.x + pad_x, head_y + 24 * self.scale, (self.win_bounds.w * 54) / 100, 9 * self.scale)
    self.window_base.draw_rrect(sub_bar, render.solid_rrect(4.5 * s, self.palette.muted, render.rgba(0, 0, 0, 0), render.rgba(0, 0, 0, 0)), full)

    self.window_base_valid = true
}

fn SceneB1.draw_tile(&mut self, clip damage.Rect) {
    self.ensure_window_base()
    // 1. Restore cached wallpaper + `.glass.window` backdrop in the damaged region
    self.frame.blit_from(&self.window_base, clip)

    s := f64(self.scale)

    // 2. Interactive glass cards (`.card` / `.card.is-on`)
    self.draw_card(CARD_GLASS, self.card0_bounds, clip)
    self.draw_card(CARD_ACCENT, self.card1_bounds, clip)

    // 3. Footer soft button (`.btn.btn-soft`) and primary button (`.btn.btn-primary`)
    if self.btn_soft_bounds.intersects(&clip) {
        bs_hover := self.hovered_id == CARD_BTN_SOFT
        bs_press := self.pressed_id == CARD_BTN_SOFT
        var bs_rect = self.btn_soft_bounds
        if bs_press {
            bs_rect = damage.rect(bs_rect.x + 2 * self.scale, bs_rect.y + 1 * self.scale, bs_rect.w - 4 * self.scale, bs_rect.h - 2 * self.scale)
        }
        var bs_fill = self.palette.card
        if bs_hover { bs_fill = self.palette.card_hover }
        self.frame.draw_rrect(bs_rect, render.RRectStyle {
            radii: render.uniform_radii(13.0 * s),
            fill_top: bs_fill,
            fill_bottom: bs_fill,
            border_color: self.palette.line,
            border_width: 1.0,
            inner_hi: self.palette.hi,
        }, clip)
        bs_lbl := damage.rect(bs_rect.x + (bs_rect.w * 25) / 100, bs_rect.y + (bs_rect.h - 8 * self.scale) / 2, (bs_rect.w * 50) / 100, 8 * self.scale)
        self.frame.draw_rrect(bs_lbl, render.solid_rrect(4.0 * s, self.palette.text, render.rgba(0, 0, 0, 0), render.rgba(0, 0, 0, 0)), clip)
    }

    bp_pad := 20 * self.scale
    bp_outer := damage.rect(self.btn_primary_bounds.x - bp_pad, self.btn_primary_bounds.y - bp_pad, self.btn_primary_bounds.w + bp_pad * 2, self.btn_primary_bounds.h + bp_pad * 2)
    if bp_outer.intersects(&clip) {
        bp_hover := self.hovered_id == CARD_BTN_PRIMARY
        bp_press := self.pressed_id == CARD_BTN_PRIMARY
        var bp_rect = self.btn_primary_bounds
        if bp_press {
            bp_rect = damage.rect(bp_rect.x + 2 * self.scale, bp_rect.y + 1 * self.scale, bp_rect.w - 4 * self.scale, bp_rect.h - 2 * self.scale)
        }
        self.frame.draw_shadow_9slice(bp_rect, &self.btn_shadow, clip)
        var bp_fill = self.palette.accent
        if bp_hover {
            bp_fill = render.color_mix(self.palette.accent, 86, render.rgb(255, 255, 255))
        }
        self.frame.draw_rrect(bp_rect, render.RRectStyle {
            radii: render.uniform_radii(13.0 * s),
            fill_top: render.color_mix(bp_fill, 90, render.rgb(255, 255, 255)),
            fill_bottom: bp_fill,
            border_color: bp_fill,
            border_width: 1.0,
            inner_hi: render.rgba(255, 255, 255, 64),
        }, clip)
        bp_lbl := damage.rect(bp_rect.x + (bp_rect.w * 25) / 100, bp_rect.y + (bp_rect.h - 8 * self.scale) / 2, (bp_rect.w * 50) / 100, 8 * self.scale)
        self.frame.draw_rrect(bp_lbl, render.solid_rrect(4.0 * s, render.rgb(255, 255, 255), render.rgba(0, 0, 0, 0), render.rgba(0, 0, 0, 0)), clip)
    }
}

// Rasterizes ONLY the rectangles in `self.damage` and returns the number of
// dirty rects processed (0 when idle). Leaves `self.damage` populated until
// `clear_damage()` or `present` consumes it.
pub fn SceneB1.render_damaged(&mut self) u32 {
    if self.damage.is_empty() {
        return 0
    }
    n := self.damage.len()
    var i: usize = 0
    for i < n {
        r := self.damage.at(i)
        self.draw_tile(r)
        i = i + 1
    }
    self.frames_rendered = self.frames_rendered + 1
    self.tiles_rendered = self.tiles_rendered + u64(n)
    return u32(n)
}

pub fn SceneB1.snapshot_png(&self, path &string) Result<string, i32> {
    return png.write_bgra_png(path, self.frame.pixels.as_slice(), u32(self.width), u32(self.height))
}
