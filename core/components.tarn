// Owned descriptions: static pages plus scoped keyed dynamic list regions.
import "core/session"
import "string"

pub struct Label { pub key string
    pub text string }
pub struct Button { pub key string
    pub text string
    pub action u32 }
pub enum Node { Text(Label)
    Press(Button)
    Heading(Label)
    Value(Label)
    Primary(Button)
    Group(Container)
    Input(Button)
    Field(Field)
    Control(Control)
    Section(Section)
    Area(Area) }
// Multiline text; `lines` (2..20) sets the visible height.
pub struct Area { pub key string
    pub text string
    pub action u32
    pub lines u32 }
// The window's header bar: buttons at the start or end and a main menu.
pub struct HeaderButton { pub key string
    pub text string
    pub icon string
    pub action u32
    pub end bool }
pub struct MenuItem { pub key string
    pub text string
    pub action u32 }
pub struct Header { pub subtitle string
    pub buttons Vec<HeaderButton>
    pub menu Vec<MenuItem> }
// Container: kind frame=0, expander=1, tabs=2, tab=3. Expander value is 0/1
// (open); tabs value is the selected index and its children must be tabs.
// With action 0 the user's changes are not reported.
pub struct Section { pub key string
    pub kind u32
    pub title string
    pub action u32
    pub value i64
    pub children Vec<Node> }
// Form control: kind switch=0, check=1, scale=2, spin=3, dropdown=4; display-only
// indicators progress=5, level=6, spinner=7 use action 0. For a dropdown, `text` lists newline-separated options after the caption line.
pub struct Control { pub key string
    pub kind u32
    pub text string
    pub action u32
    pub value i64
    pub min i64
    pub max i64 }
pub struct Field { pub key string
    pub text string
    pub action u32
    pub label string
    pub description string }
pub struct Region { pub key string
    pub children Vec<Node> }
pub struct Container { pub key string
    pub horizontal bool
    pub spacing u32
    pub children Vec<Node> }
pub struct Page { pub key string
    pub children Vec<Node> }
pub struct Text { pub key string
    pub text string }
pub struct Enabled { pub key string
    pub value bool }
pub struct List { pub key string
    pub items Vec<Button> }
pub struct View { pub route string
    pub texts Vec<Text>
    pub enabled Vec<Enabled>
    pub inputs Vec<Text>
    pub lists Vec<List>
    pub regions Vec<Region> }

pub fn label(key string, text string) Node { return Node.Text(Label { key: key, text: text }) }
pub fn button(key string, text string, action u32) Node {
    return Node.Press(Button { key: key, text: text, action: action })
}
pub fn input(key string, text string, action u32) Node {
    return Node.Input(Button { key: key, text: text, action: action })
}
pub fn field(key string, text string, action u32, accessible_label string, description string) Node {
    return Node.Field(Field { key: key, text: text, action: action, label: accessible_label, description: description })
}
pub fn switch(key string, caption string, on bool, action u32) Node {
    var value: i64 = 0
    if on { value = 1 }
    return Node.Control(Control { key: key, kind: 0, text: caption, action: action, value: value, min: 0, max: 1 })
}
pub fn check(key string, caption string, on bool, action u32) Node {
    var value: i64 = 0
    if on { value = 1 }
    return Node.Control(Control { key: key, kind: 1, text: caption, action: action, value: value, min: 0, max: 1 })
}
pub fn slider(key string, caption string, value i64, min i64, max i64, action u32) Node {
    return Node.Control(Control { key: key, kind: 2, text: caption, action: action, value: value, min: min, max: max })
}
pub fn spin(key string, caption string, value i64, min i64, max i64, action u32) Node {
    return Node.Control(Control { key: key, kind: 3, text: caption, action: action, value: value, min: min, max: max })
}
// Caption and options are joined with newlines; the selected index is the value.
pub fn dropdown(key string, caption string, options &[]string, selected i64, action u32) Node {
    var text = caption
    for option in options { text = text + "\n" + option.clone() }
    return Node.Control(Control { key: key, kind: 4, text: text, action: action, value: selected, min: 0, max: 0 })
}
// Indicators: the model owns the value and updates it through View.inputs
// like any control; the user cannot change them.
pub fn progress(key string, caption string, value i64, min i64, max i64) Node {
    return Node.Control(Control { key: key, kind: 5, text: caption, action: 0, value: value, min: min, max: max })
}
pub fn level(key string, caption string, value i64, min i64, max i64) Node {
    return Node.Control(Control { key: key, kind: 6, text: caption, action: 0, value: value, min: min, max: max })
}
// A busy indicator; GTK draws nothing while it is stopped.
pub fn spinner(key string, caption string, spinning bool) Node {
    var value: i64 = 0
    if spinning { value = 1 }
    return Node.Control(Control { key: key, kind: 7, text: caption, action: 0, value: value, min: 0, max: 1 })
}
pub fn frame(key string, title string, children Vec<Node>) Node {
    return Node.Section(Section { key: key, kind: 0, title: title, action: 0, value: 0, children: children })
}
pub fn expander(key string, title string, open bool, action u32, children Vec<Node>) Node {
    var value: i64 = 0
    if open { value = 1 }
    return Node.Section(Section { key: key, kind: 1, title: title, action: action, value: value, children: children })
}
pub fn tabs(key string, selected i64, action u32, children Vec<Node>) Node {
    return Node.Section(Section { key: key, kind: 2, title: "", action: action, value: selected, children: children })
}
pub fn tab(key string, title string, children Vec<Node>) Node {
    return Node.Section(Section { key: key, kind: 3, title: title, action: 0, value: 0, children: children })
}
pub fn text_area(key string, text string, lines u32, action u32) Node {
    return Node.Area(Area { key: key, text: text, action: action, lines: lines })
}
pub fn header_button(key string, text string, icon string, action u32, end bool) HeaderButton {
    return HeaderButton { key: key, text: text, icon: icon, action: action, end: end }
}
pub fn menu_item(key string, text string, action u32) MenuItem {
    return MenuItem { key: key, text: text, action: action }
}
pub fn Header.mount(&self, ui &mut session.Session) Result<void, session.Error> {
    try ui.set_header(self.subtitle.clone())
    for item in self.buttons.as_slice() {
        try ui.add_header_button(item.key.clone(), item.text.clone(), item.icon.clone(), item.action, item.end)
    }
    for item in self.menu.as_slice() { try ui.add_menu_item(item.key.clone(), item.text.clone(), item.action) }
    return Ok(())
}
pub fn heading(key string, text string) Node { return Node.Heading(Label { key: key, text: text }) }
pub fn number(key string, text string) Node { return Node.Value(Label { key: key, text: text }) }
pub fn primary_button(key string, text string, action u32) Node {
    return Node.Primary(Button { key: key, text: text, action: action })
}
pub fn row(key string, spacing u32, children Vec<Node>) Node {
    return Node.Group(Container { key: key, horizontal: true, spacing: spacing, children: children })
}
pub fn column(key string, spacing u32, children Vec<Node>) Node {
    return Node.Group(Container { key: key, horizontal: false, spacing: spacing, children: children })
}

fn mount(ui &mut session.Session, parent &string, children &[]Node, depth u32) Result<void, session.Error> {
    for child in children {
        match child {
            Node.Field(value) => {
                try ui.add_entry(parent.clone(), value.key.clone(), value.text.clone(), value.action)
                try ui.set_accessible(value.key.clone(), value.label.clone(), value.description.clone())
            }
            Node.Input(value) => { try ui.add_entry(parent.clone(), value.key.clone(), value.text.clone(), value.action) }
            Node.Control(value) => {
                try ui.add_control(parent.clone(), value.key.clone(), value.kind, value.text.clone(), value.action,
                    value.value, value.min, value.max)
            }
            Node.Text(value) => { try ui.add_label(parent.clone(), value.key.clone(), value.text.clone()) }
            Node.Press(value) => { try ui.add_button(parent.clone(), value.key.clone(), value.text.clone(), value.action) }
            Node.Heading(value) => { try ui.add_text(parent.clone(), value.key.clone(), value.text.clone(), 1) }
            Node.Value(value) => { try ui.add_text(parent.clone(), value.key.clone(), value.text.clone(), 2) }
            Node.Primary(value) => {
                try ui.add_button(parent.clone(), value.key.clone(), value.text.clone(), value.action)
                try ui.set_primary(value.key.clone(), true)
            }
            Node.Group(value) => {
                if depth >= 12 { return Err(session.fail(1, "mount \"" + value.key + "\": groups nest at most 12 deep")) }
                try ui.add_box(parent.clone(), value.key.clone(), value.horizontal, value.spacing)
                try mount(ui, &value.key, value.children.as_slice(), depth + 1)
            }
            Node.Area(value) => {
                try ui.add_text_area(parent.clone(), value.key.clone(), value.text.clone(), value.action, value.lines)
            }
            Node.Section(value) => {
                if depth >= 12 { return Err(session.fail(1, "mount \"" + value.key + "\": containers nest at most 12 deep")) }
                try ui.add_container(parent.clone(), value.key.clone(), value.kind, value.title.clone(), value.action, value.value)
                try mount(ui, &value.key, value.children.as_slice(), depth + 1)
            }
        }
    }
    return Ok(())
}

pub fn Page.mount(&self, ui &mut session.Session) Result<void, session.Error> {
    try ui.add_page(self.key.clone())
    return mount(ui, &self.key, self.children.as_slice(), 0)
}

fn View.validate(&self) Result<void, session.Error> {
    if self.regions.len() > 256 { return Err(session.fail(1, "view: at most 256 regions")) }
    var region_keys: Vec<string> = Vec.new()
    for region in self.regions.as_slice() {
        try unique_key(&region.key, &mut region_keys)
        var keys: Vec<string> = Vec.new()
        try validate_nodes(region.children.as_slice(), 0, &mut keys)
    }
    if self.route.is_empty() || self.texts.len() > 256 { return Err(session.fail(1, "view: the route is empty or there are more than 256 texts")) }
    if self.enabled.len() > 256 { return Err(session.fail(1, "view: at most 256 enabled states")) }
    var enabled_index: usize = 0
    for value in self.enabled.as_slice() {
        if value.key.is_empty() { return Err(session.fail(1, "view: an enabled state has an empty key")) }
        var previous: usize = 0
        for previous < enabled_index {
            if self.enabled.as_slice()[previous].key.eq(&value.key) { return Err(session.fail(1, "view: duplicate enabled key \"" + value.key + "\"")) }
            previous = previous + 1
        }
        enabled_index = enabled_index + 1
    }
    if self.inputs.len() > 256 { return Err(session.fail(1, "view: at most 256 inputs")) }
    var input_index: usize = 0
    for value in self.inputs.as_slice() {
        if value.key.is_empty() { return Err(session.fail(1, "view: an input has an empty key")) }
        var previous: usize = 0
        for previous < input_index {
            if self.inputs.as_slice()[previous].key.eq(&value.key) { return Err(session.fail(1, "view: duplicate input key \"" + value.key + "\"")) }
            previous = previous + 1
        }
        input_index = input_index + 1
    }
    if self.lists.len() > 256 { return Err(session.fail(1, "view: at most 256 lists")) }
    var list_index: usize = 0
    for list in self.lists.as_slice() {
        if list.key.is_empty() || list.items.len() > 256 { return Err(session.fail(1, "list \"" + list.key + "\": empty key or more than 256 items")) }
        var previous: usize = 0
        for previous < list_index {
            if self.lists.as_slice()[previous].key.eq(&list.key) { return Err(session.fail(1, "view: duplicate list key \"" + list.key + "\"")) }
            previous = previous + 1
        }
        var item_index: usize = 0
        for item in list.items.as_slice() {
            if item.key.is_empty() || item.action < 1 || item.action > 1024 { return Err(session.fail(1, "list \"" + list.key + "\": an item has an empty key or an action outside 1..1024")) }
            var before: usize = 0
            for before < item_index {
                if list.items.as_slice()[before].key.eq(&item.key) { return Err(session.fail(1, "list \"" + list.key + "\": duplicate item key \"" + item.key + "\"")) }
                before = before + 1
            }
            item_index = item_index + 1
        }
        list_index = list_index + 1
    }
    var index: usize = 0
    for value in self.texts.as_slice() {
        if value.key.is_empty() { return Err(session.fail(1, "view: a text has an empty key")) }
        var previous: usize = 0
        for previous < index {
            if self.texts.as_slice()[previous].key.eq(&value.key) { return Err(session.fail(1, "view: duplicate text key \"" + value.key + "\"")) }
            previous = previous + 1
        }
        index = index + 1
    }
    return Ok(())
}

fn View.apply(&self, ui &mut session.Session) Result<void, session.Error> {
    try self.validate()
    try self.reconcile_regions(ui)
    try self.reconcile_lists(ui)
    for value in self.texts.as_slice() { try ui.set_text(value.key.clone(), value.text.clone()) }
    for value in self.inputs.as_slice() { try ui.set_input(value.key.clone(), value.text.clone()) }
    for value in self.enabled.as_slice() { try ui.set_enabled(value.key.clone(), value.value) }
    try ui.show_page(self.route.clone())
    return Ok(())
}

fn View.update(&self, previous &View, ui &mut session.Session) Result<void, session.Error> {
    try self.validate()
    try self.reconcile_regions(ui)
    for list in self.lists.as_slice() {
        var equal = false
        for before in previous.lists.as_slice() {
            if before.key.eq(&list.key) && list.same(before) { equal = true }
        }
        if !equal { try list.apply(ui) }
    }
    for value in self.texts.as_slice() {
        var equal = false
        for before in previous.texts.as_slice() {
            if before.key.eq(&value.key) && before.text.eq(&value.text) { equal = true }
        }
        if !equal { try ui.set_text(value.key.clone(), value.text.clone()) }
    }
    for value in self.enabled.as_slice() {
        var equal = false
        for before in previous.enabled.as_slice() {
            if before.key.eq(&value.key) && before.value == value.value { equal = true }
        }
        if !equal { try ui.set_enabled(value.key.clone(), value.value) }
    }
    for value in self.inputs.as_slice() {
        var equal = false
        for before in previous.inputs.as_slice() {
            if before.key.eq(&value.key) && before.text.eq(&value.text) { equal = true }
        }
        if !equal { try ui.set_input(value.key.clone(), value.text.clone()) }
    }
    if !self.route.eq(&previous.route) { try ui.show_page(self.route.clone()) }
    return Ok(())
}

// Pages stay mounted; actions return owned property, route and list descriptions.
// The application callback owns its model and never receives native authority.
pub fn drive(ui &mut session.Session, initial View,
    update mut fn(u32) Result<View, session.Error>) Result<void, session.Error> {
    var shown = initial
    try shown.apply(ui)
    for {
        event := try ui.next_action()
        match event {
            session.Action.Closed => { return Ok(()) }
            session.Action.Opened => {}
            session.Action.Hidden => {}
            session.Action.Wake => {}
            session.Action.Activate(action) => {
                next := try update(action)
                try next.update(&shown, ui)
                shown = next
                try ui.complete_event()
            }
        }
    }
}

// Entry changes carry an owned snapshot; button activations carry an empty string.
pub fn drive_input(ui &mut session.Session, initial View,
    update mut fn(u32, string) Result<View, session.Error>) Result<void, session.Error> {
    var shown = initial
    try shown.apply(ui)
    for {
        event := try ui.next_action()
        match event {
            session.Action.Closed => { return Ok(()) }
            session.Action.Opened => {}
            session.Action.Hidden => {}
            session.Action.Wake => {}
            session.Action.Activate(action) => {
                text := try ui.event_text()
                next := try update(action, text)
                try next.update(&shown, ui)
                shown = next
                try ui.complete_event()
            }
        }
    }
}

fn List.same(&self, other &List) bool {
    if self.items.len() != other.items.len() { return false }
    var index: usize = 0
    for item in self.items.as_slice() {
        before := &other.items.as_slice()[index]
        if !item.key.eq(&before.key) || !item.text.eq(&before.text) || item.action != before.action { return false }
        index = index + 1
    }
    return true
}
fn List.apply(&self, ui &mut session.Session) Result<void, session.Error> {
    try ui.list_begin(self.key.clone(), u32(self.items.len()))
    for item in self.items.as_slice() { try ui.list_item(item.key.clone(), item.text.clone(), item.action) }
    return ui.list_end()
}
fn View.reconcile_lists(&self, ui &mut session.Session) Result<void, session.Error> {
    for list in self.lists.as_slice() { try list.apply(ui) }
    return Ok(())
}

fn unique_key(key &string, keys &mut Vec<string>) Result<void, session.Error> {
    if key.is_empty() || keys.len() >= 256 { return Err(session.fail(1, "region: empty key, or more than 256 nodes")) }
    for previous in keys.as_slice() { if previous.eq(key) { return Err(session.fail(1, "region: duplicate key \"" + key + "\"")) } }
    keys.push(key.clone())
    return Ok(())
}
fn validate_action(action u32) Result<void, session.Error> {
    if action < 1 || action > 1024 { return Err(session.fail(1, "region: action " + string.from_u64(u64(action)) + " is outside 1..1024")) }
    return Ok(())
}
fn validate_nodes(children &[]Node, depth u32, keys &mut Vec<string>) Result<void, session.Error> {
    for child in children {
        match child {
            Node.Text(value) => { try unique_key(&value.key, keys) }
            Node.Heading(value) => { try unique_key(&value.key, keys) }
            Node.Value(value) => { try unique_key(&value.key, keys) }
            Node.Press(value) => { try unique_key(&value.key, keys)
                try validate_action(value.action) }
            Node.Primary(value) => { try unique_key(&value.key, keys)
                try validate_action(value.action) }
            Node.Input(value) => { try unique_key(&value.key, keys)
                try validate_action(value.action) }
            Node.Field(value) => { try unique_key(&value.key, keys)
                try validate_action(value.action)
                if value.label.is_empty() { return Err(session.fail(1, "region: field \"" + value.key + "\" needs an accessible label")) } }
            Node.Control(value) => { try unique_key(&value.key, keys)
                // Indicators (5..7) carry no action.
                if value.kind > 7 { return Err(session.fail(1, "region: control \"" + value.key + "\" has an unknown kind")) }
                if value.kind <= 4 { try validate_action(value.action) } }
            // Tabs stay static-only; frames and expanders reconcile like groups.
            Node.Section(value) => {
                if depth >= 12 || value.kind > 1 { return Err(session.fail(1, "region: \"" + value.key + "\" nests too deep, or tabs (only static pages have tabs)")) }
                try unique_key(&value.key, keys)
                try validate_nodes(value.children.as_slice(), depth + 1, keys)
            }
            Node.Area(value) => { try unique_key(&value.key, keys)
                try validate_action(value.action) }
            Node.Group(value) => {
                if depth >= 12 || value.spacing > 64 { return Err(session.fail(1, "region: group \"" + value.key + "\" nests too deep or has spacing over 64")) }
                try unique_key(&value.key, keys)
                try validate_nodes(value.children.as_slice(), depth + 1, keys)
            }
        }
    }
    return Ok(())
}
fn tree_nodes(ui &mut session.Session, parent &string, children &[]Node) Result<void, session.Error> {
    for child in children {
        match child {
            Node.Text(value) => { try ui.tree_node(parent.clone(), value.key.clone(), 0, value.text.clone(), 0, 0) }
            Node.Heading(value) => { try ui.tree_node(parent.clone(), value.key.clone(), 1, value.text.clone(), 0, 0) }
            Node.Value(value) => { try ui.tree_node(parent.clone(), value.key.clone(), 2, value.text.clone(), 0, 0) }
            Node.Press(value) => { try ui.tree_node(parent.clone(), value.key.clone(), 3, value.text.clone(), value.action, 0) }
            Node.Primary(value) => { try ui.tree_node(parent.clone(), value.key.clone(), 4, value.text.clone(), value.action, 0) }
            Node.Input(value) => { try ui.tree_node(parent.clone(), value.key.clone(), 5, value.text.clone(), value.action, 0) }
            // Form controls mount only in static pages for now.
            Node.Control(value) => {
                try ui.tree_control(parent.clone(), value.key.clone(), value.kind, value.text.clone(), value.action,
                    value.value, value.min, value.max)
            }
            Node.Section(value) => {
                try ui.tree_container(parent.clone(), value.key.clone(), value.kind, value.title.clone(), value.action, value.value)
                try tree_nodes(ui, &value.key, value.children.as_slice())
            }
            Node.Area(value) => { try ui.tree_text_area(parent.clone(), value.key.clone(), value.text.clone(), value.action, value.lines) }
            Node.Field(value) => {
                try ui.tree_node(parent.clone(), value.key.clone(), 5, value.text.clone(), value.action, 0)
                try ui.set_accessible(value.key.clone(), value.label.clone(), value.description.clone())
            }
            Node.Group(value) => {
                var kind: u32 = 6
                if value.horizontal { kind = 7 }
                try ui.tree_node(parent.clone(), value.key.clone(), kind, "", 0, value.spacing)
                try tree_nodes(ui, &value.key, value.children.as_slice())
            }
        }
    }
    return Ok(())
}
fn View.reconcile_regions(&self, ui &mut session.Session) Result<void, session.Error> {
    for region in self.regions.as_slice() {
        var keys: Vec<string> = Vec.new()
        try validate_nodes(region.children.as_slice(), 0, &mut keys)
        try ui.tree_begin(region.key.clone(), u32(keys.len()))
        try tree_nodes(ui, &region.key, region.children.as_slice())
        try ui.tree_end()
    }
    return Ok(())
}
