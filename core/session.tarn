extern "C" fn tarn_ui_gtk_add_entry(raw *mut NativeSession, parent *u8, key *u8, text *u8, action u32) i32
extern "C" fn tarn_ui_gtk_event_text(raw *mut NativeSession) *u8

pub fn Session.add_entry(&mut self, parent string, key string, text string, action u32) Result<void, Error> {
    c_parent := try c_string(&parent)
    c_key := try c_string(&key)
    c_text := try c_string(&text)
    unsafe { return checked(tarn_ui_gtk_add_entry(self.native, c_parent.as_ptr(), c_key.as_ptr(), c_text.as_ptr(), action)) }
}

pub fn Session.event_text(&self) Result<string, Error> {
    unsafe {
        pointer := tarn_ui_gtk_event_text(self.native)
        if ffi.is_null(pointer) { return Err(Error { code: 6 }) }
        match ffi.string_from_c(pointer) {
            Some(text) => { return Ok(text) }
            None => { return Err(Error { code: 1 }) }
        }
    }
}

