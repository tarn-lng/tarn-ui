pub fn Session.tree_text_area(&mut self, parent string, key string, text string, action u32, lines u32) Result<void, Error> {
    c_parent := try c_string(&parent)
    c_key := try c_string(&key)
    c_text := try c_string(&text)
    unsafe { return checked_at(tarn_ui_gtk_tree_text_area(self.native, c_parent.as_ptr(), c_key.as_ptr(), c_text.as_ptr(), action, lines), &"tree_text_area", &key) }
}
