import "ffi"

struct NativeSession {}
extern "C" fn tarn_ui_gtk_abi() u32
extern "C" fn tarn_ui_gtk_create(title *u8, heading *u8, out *mut *mut NativeSession) i32
extern "C" fn tarn_ui_gtk_next(raw *mut NativeSession) i32
extern "C" fn tarn_ui_gtk_request_close(raw *mut NativeSession) i32
extern "C" fn tarn_ui_gtk_release(raw *mut NativeSession) i32
extern "C" fn tarn_ui_gtk_finish(raw *mut NativeSession, application_error i32) i32
extern "C" fn tarn_ui_gtk_enable_counter(raw *mut NativeSession, value i64) i32
extern "C" fn tarn_ui_gtk_set_counter(raw *mut NativeSession, value i64) i32
extern "C" fn tarn_ui_gtk_set_heading(raw *mut NativeSession, text *u8) i32
extern "C" fn tarn_ui_gtk_complete_event(raw *mut NativeSession, status i32) i32
extern "C" fn tarn_ui_gtk_add_page(raw *mut NativeSession, key *u8) i32
extern "C" fn tarn_ui_gtk_add_label(raw *mut NativeSession, page *u8, key *u8, text *u8) i32
extern "C" fn tarn_ui_gtk_add_button(raw *mut NativeSession, page *u8, key *u8, text *u8, action u32) i32
extern "C" fn tarn_ui_gtk_set_text(raw *mut NativeSession, key *u8, text *u8) i32
