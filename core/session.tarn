/// A failed UI operation. `code` is the bridge status (bridge.h); `context`
/// names the operation and key, e.g. `add_label "details-text"`.
pub struct Error { pub code i32
    pub context string }

/// An error with context; apps use it for their own failures too.
pub fn fail(code i32, context string) Error { return Error { code: code, context: context } }

/// What the bridge status means.
pub fn Error.reason(&self) string {
    if self.code == 1 { return "invalid input (unknown key, duplicate key, bad parent or value out of range)" }
    if self.code == 2 { return "called off the main thread" }
    if self.code == 3 { return "another UI session is already active" }
    if self.code == 4 { return "no display available" }
    if self.code == 5 { return "native allocation or creation failed" }
    if self.code == 6 { return "the window is closed" }
    if self.code == 7 { return "the native bridge has a different ABI version; rebuild the bridge and the app together" }
    if self.code == 8 { return "the event queue is full" }
    if self.code == 10 { return "limit reached" }
    return "application error " + string.from_i64(i64(self.code))
}

/// `context: reason`, or the reason alone.
pub fn Error.message(&self) string {
    if self.context.is_empty() { return self.reason() }
    return self.context.clone() + ": " + self.reason()
}
pub enum Event {
    Opened
    Closed
    Increment
}
pub enum Action { Opened
    Closed
    Activate(u32)
    /// Background mode only: the user closed the window and it was hidden.
    Hidden
    /// A watched descriptor became ready (coalesced); see watch_fd.
    Wake }
pub struct Session { native *mut NativeSession
    watches Vec<u32> }

fn c_string(text &string) Result<ffi.CString, Error> {
    match ffi.CString.new(text) {
        Some(value) => { return Ok(value) }
        None => { return Err(fail(1, "text contains a NUL byte")) }
    }
}

// Requires the process main thread and no nested UI session. Native allocation
// failure, ordinary return and body errors all clean up. Abort/exit do not unwind.
pub unsafe fn run(title string, heading string,
    body mut fn(&mut Session) Result<void, Error>) Result<void, Error> {
    unsafe {
        if tarn_ui_gtk_abi() != 14 { return Err(fail(7, "bridge ABI " + string.from_u64(u64(tarn_ui_gtk_abi())) + ", expected 14")) }
    }
    c_title := try c_string(&title)
    c_heading := try c_string(&heading)
    var raw: *mut NativeSession = ffi.null()
    var status: i32 = 0
    unsafe {
        status = tarn_ui_gtk_create(c_title.as_ptr(), c_heading.as_ptr(), ffi.of_mut(&mut raw))
    }
    if status != 0 { return Err(fail(status, "create window")) }
    var session = Session { native: raw, watches: Vec.new() }
    result := body(&mut session)
    // Watches carry the native pointer; remove them before it is released.
    session.unwatch_all()
    // Store the result before cleanup; never `try` past this release.
    match result {
        Ok(_) => {
            unsafe { status = tarn_ui_gtk_finish(session.native, 0) }
            if status != 0 { return Err(fail(status, "finish")) }
            return Ok(())
        }
        Err(error) => {
            unsafe { status = tarn_ui_gtk_finish(session.native, error.code) }
            if status != 0 { return Err(fail(status, "finish")) }
            return Err(error)
        }
    }
}

pub fn Session.next_event(&mut self) Result<Event, Error> {
    var event: i32 = 0
    unsafe { event = tarn_ui_gtk_next(self.native) }
    // Hidden and Wake only exist for apps that opt in through Action.
    for event == 4 || event == 5 {
        unsafe { event = tarn_ui_gtk_next(self.native) }
    }
    if event == 1 { return Ok(Event.Opened) }
    if event == 2 { return Ok(Event.Closed) }
    if event == 3 { return Ok(Event.Increment) }
    if event > 0 { return Err(fail(1, "next_event")) }
    return Err(fail(-event, "next_event"))
}

pub fn Session.next_action(&mut self) Result<Action, Error> {
    var event: i32 = 0
    unsafe { event = tarn_ui_gtk_next(self.native) }
    if event == 1 { return Ok(Action.Opened) }
    if event == 2 { return Ok(Action.Closed) }
    if event == 4 { return Ok(Action.Hidden) }
    if event == 5 { return Ok(Action.Wake) }
    if event >= 1001 && event <= 2024 { return Ok(Action.Activate(u32(event - 1000))) }
    if event > 0 { return Err(fail(1, "next_action")) }
    return Err(fail(-event, "next_action"))
}

// Names the failed operation and its key in the error (`set_text "summary"`).
fn checked_at(status i32, op &string, key &string) Result<void, Error> {
    if status == 0 { return Ok(()) }
    if key.is_empty() { return Err(fail(status, op.clone())) }
    return Err(fail(status, op.clone() + " \"" + key + "\""))
}

pub fn Session.add_page(&mut self, key string) Result<void, Error> {
    name := try c_string(&key)
    unsafe { return checked_at(tarn_ui_gtk_add_page(self.native, name.as_ptr()), &"add_page", &key) }
}

