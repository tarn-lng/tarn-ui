/// Multiline text: each edit arrives as the action with the full text.
pub fn Session.add_text_area(&mut self, parent string, key string, text string, action u32, lines u32) Result<void, Error> {
    c_parent := try c_string(&parent)
    c_key := try c_string(&key)
    c_text := try c_string(&text)
    var status: i32 = 0
    unsafe { status = tarn_ui_gtk_add_text_area(self.native, c_parent.as_ptr(), c_key.as_ptr(), c_text.as_ptr(), action, lines) }
    return checked(status)
}

/// Replaces the title bar with a header bar; an empty subtitle shows only the title.
pub fn Session.set_header(&mut self, subtitle string) Result<void, Error> {
    c_subtitle := try c_string(&subtitle)
    var status: i32 = 0
    unsafe { status = tarn_ui_gtk_set_header(self.native, c_subtitle.as_ptr()) }
    return checked(status)
}

/// A header button; with an icon name the text becomes its tooltip and accessible name.
pub fn Session.add_header_button(&mut self, key string, text string, icon string, action u32, end bool) Result<void, Error> {
    c_key := try c_string(&key)
    c_text := try c_string(&text)
    c_icon := try c_string(&icon)
    var side: u32 = 0
    if end { side = 1 }
    var status: i32 = 0
    unsafe { status = tarn_ui_gtk_add_header_button(self.native, c_key.as_ptr(), c_text.as_ptr(), c_icon.as_ptr(), action, side) }
    return checked(status)
}

/// An entry in the header's main menu. Keys use ASCII letters, digits and '-'.
pub fn Session.add_menu_item(&mut self, key string, text string, action u32) Result<void, Error> {
    c_key := try c_string(&key)
    c_text := try c_string(&text)
    var status: i32 = 0
    unsafe { status = tarn_ui_gtk_add_menu_item(self.native, c_key.as_ptr(), c_text.as_ptr(), action) }
    return checked(status)
}

