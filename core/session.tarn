pub fn Session.event_text(&self) Result<string, Error> {
    unsafe {
        pointer := tarn_ui_gtk_event_text(self.native)
        if ffi.is_null(pointer) { return Err(fail(6, "event_text")) }
        match ffi.string_from_c(pointer) {
            Some(text) => { return Ok(text) }
            None => { return Err(fail(1, "event_text: not UTF-8")) }
        }
    }
}

