// Route state belongs to Tarn. Hidden pages remain mounted until session teardown.
import "core/session"

pub struct Navigator { routes Vec<string>
    history Vec<string> }

pub fn Navigator.new(routes Vec<string>, initial string) Result<Navigator, session.Error> {
    if routes.is_empty() || routes.len() > 32 { return Err(session.fail(1, "navigation: between 1 and 32 routes are needed")) }
    var found = false
    var index: usize = 0
    for route in routes.as_slice() {
        if route.is_empty() { return Err(session.fail(1, "navigation: a route name is empty")) }
        if route.eq(&initial) { found = true }
        var other: usize = 0
        for other < index {
            if route.eq(&routes.as_slice()[other]) { return Err(session.fail(1, "navigation: duplicate route \"" + route + "\"")) }
            other = other + 1
        }
        index = index + 1
    }
    if !found { return Err(session.fail(1, "navigation: the initial route \"" + initial + "\" is not a route")) }
    var history: Vec<string> = Vec.new()
    history.push(initial)
    return Ok(Navigator{routes: routes, history: history})
}

pub fn Navigator.current(&self) &string { return &self.history.as_slice()[self.history.len() - 1] }
pub fn Navigator.depth(&self) usize { return self.history.len() }
pub fn Navigator.push(&mut self, route string) Result<bool, session.Error> {
    if self.current().eq(&route) { return Ok(false) }
    var found = false
    for allowed in self.routes.as_slice() { if allowed.eq(&route) { found = true } }
    if !found { return Err(session.fail(1, "navigation: unknown route \"" + route + "\"")) }
    if self.history.len() >= 64 { return Err(session.fail(10, "navigation: history is limited to 64 entries")) }
    self.history.push(route)
    return Ok(true)
}
pub fn Navigator.back(&mut self) bool {
    if self.history.len() == 1 { return false }
    self.history.pop()
    return true
}
