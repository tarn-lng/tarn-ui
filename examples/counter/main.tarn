import "core/session"
import "core/reactive"
import "os"
import "counter"

fn main() {
    var state: reactive.State<i64> = reactive.State.new(0)
    unsafe {
        match session.run("Tarn UI", "Hola desde Tarn", fn(ui &mut session.Session) Result<void, session.Error> {
            return reactive.drive_counter(ui, &mut state,
                fn(value i64, event session.Event) Result<i64, session.Error> { return counter.reduce(value, event) },
                fn(value i64) reactive.CounterView { return counter.view(value) })
        }) {
            Ok(_) => { print("closed") }
            Err(error) => {
                print(error.code)
                os.exit(1)
            }
        }
    }
}
