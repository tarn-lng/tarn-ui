import "core/session"
import "core/reactive"

// Pure reducer and derived view; neither receives native authority.
pub fn reduce(value i64, event session.Event) Result<i64, session.Error> {
    match event {
        session.Event.Increment => {
            if value == 9223372036854775807 { return Err(session.fail(9, "the counter is at its maximum")) }
            return Ok(value + 1)
        }
        _ => { return Ok(value) }
    }
}

pub fn view(value i64) reactive.CounterView {
    if value % 2 == 0 { return reactive.CounterView{value: value, heading: "Contador · par"} }
    return reactive.CounterView{value: value, heading: "Contador · impar"}
}

// Application logic: no native state, aborting arithmetic or C-side increment.
pub fn increment(ui &mut session.Session, value &mut i64) Result<void, session.Error> {
    if *value == 9223372036854775807 { return Err(session.fail(9, "the counter is at its maximum")) }
    next := *value + 1
    try ui.set_counter(next)
    *value = next
    return Ok(())
}
