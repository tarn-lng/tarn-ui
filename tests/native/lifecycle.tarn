// G1 smoke for the Tarn GTK backend: lifecycle, events, counter, background.
import "gtk/gtk"
import "gtk/native"

extern "C" fn gtk_widget_activate(widget *mut gtk.Widget) i32

fn check(value bool, what string) { if !value { panic("lifecycle: " + what) } }

fn open(title string) native.Native {
    match native.create(&title, &"Hola desde Tarn") {
        Ok(value) => { return value }
        Err(code) => { panic("create failed: " + code.to_string()) }
    }
}

fn test_lifecycle() {
    var ui = open("Tarn backend")
    check(native.create(&"Second", &"Second").is_err(), "second session must be refused")
    check(ui.next() == 1, "opened")
    check(ui.enable_counter(41) == 0, "enable_counter")
    check(ui.enable_counter(0) == 1, "counter enabled twice")
    unsafe { check(gtk_widget_activate(ui.counter_button()) == 1, "activate") }
    check(ui.next() == 3, "increment")
    check(ui.set_counter(42) == 0, "set_counter")
    native.wake(ui.wake_data())
    native.wake(ui.wake_data())
    check(ui.next() == 5, "wake")
    check(ui.set_background(true) == 0, "background")
    unsafe { gtk.gtk_window_close(ui.native_window()) }
    check(ui.next() == 4, "hidden")
    check(ui.is_visible() == 0, "hidden window")
    check(ui.present() == 0, "present")
    check(ui.request_close() == 0, "request_close")
    check(ui.next() == 2, "closed")
    check(ui.next() == -6, "closed twice")
    check(ui.set_counter(1) == 6, "closed session refuses writes")
    check(ui.release() == 0, "release")
    // The slot is free again.
    var again = open("Again")
    check(again.next() == 1, "opened again")
    check(again.set_heading(&"Cambiado") == 0, "set_heading")
    check(again.release() == 0, "release again")
    print("lifecycle ok")
}
