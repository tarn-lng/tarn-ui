// G2 smoke for the Tarn GTK backend: pages, components, entries, focus,
// accessibility, and that release finalizes every widget it created.
import "ffi"
import "gtk/gtk"
import "gtk/native"

extern "C" fn gtk_widget_activate(widget *mut gtk.Widget) i32
extern "C" fn gtk_editable_set_text(editable *mut gtk.Widget, text *u8) void
extern "C" fn g_object_weak_ref(object *mut gtk.Widget, notify *u8, data *mut i32) void

fn check(value bool, what string) { if !value { panic("components: " + what) } }
fn finalized(data *mut i32, object *mut gtk.Widget) void {
    unsafe { ffi.write(data, ffi.read(data) + 1) }
}

fn main() {
    var gone: i32 = 0
    var ui = match_open()
    check(ui.next() == 1, "opened")
    check(ui.add_page(&"home") == 0, "page")
    check(ui.add_page(&"home") == 1, "duplicate key")
    check(ui.add_page(&"main") == 1, "reserved key")
    check(ui.add_page(&"bad key") == 1, "invalid key")
    check(ui.add_box(&"home", &"row", true, 8) == 0, "box")
    check(ui.add_box(&"home", &"wide", false, 65) == 1, "spacing limit")
    check(ui.add_text(&"row", &"title", &"Título", 1) == 0, "heading text")
    check(ui.add_text(&"row", &"value", &"42", 2) == 0, "value text")
    check(ui.add_text(&"row", &"odd", &"x", 3) == 1, "style range")
    check(ui.add_label(&"home", &"note", &"Nota") == 0, "label")
    check(ui.add_label(&"note", &"inside", &"x") == 1, "a label is not a parent")
    check(ui.add_button(&"home", &"go", &"Ir", 7) == 0, "button")
    check(ui.add_button(&"home", &"zero", &"x", 0) == 1, "action range")
    check(ui.add_entry(&"home", &"name", &"Ana", 9) == 0, "entry")
    check(ui.add_page(&"other") == 0, "second page")
    check(ui.add_button(&"other", &"back", &"Volver", 8) == 0, "second button")
    check(ui.enable_counter(0) == 1, "counter after pages")
    check(ui.show_page(&"home") == 0, "show")
    check(ui.add_label(&"home", &"late", &"x") == 1, "no new static widgets once shown")
    check(ui.show_page(&"nowhere") == 1, "unknown page")

    check(ui.set_text(&"note", &"Nota nueva") == 0, "set_text label")
    check(ui.set_text(&"go", &"Ir ya") == 0, "set_text button")
    check(ui.set_text(&"name", &"x") == 1, "set_text entry")
    check(ui.set_text(&"missing", &"x") == 1, "set_text missing")
    check(ui.set_primary(&"go", true) == 0, "primary")
    check(ui.set_primary(&"note", true) == 1, "primary label")
    check(ui.set_accessible(&"go", &"Ir", &"Abre la otra página") == 0, "accessible")
    check(ui.set_accessible(&"go", &"Ir", &"Abre la otra página") == 0, "accessible again")
    check(ui.set_accessible(&"go", &"", &"x") == 1, "empty accessible label")
    check(ui.focus(&"name") == 0, "focus entry")
    check(ui.focus(&"back") == 1, "focus outside visible page")

    unsafe {
        go := ui.widget(&"go")
        name := ui.widget(&"name")
        g_object_weak_ref(go, ffi.callback(finalized), ffi.of_mut(&mut gone))
        g_object_weak_ref(name, ffi.callback(finalized), ffi.of_mut(&mut gone))
        g_object_weak_ref(ui.native_window(), ffi.callback(finalized), ffi.of_mut(&mut gone))
        check(gtk_widget_activate(go) == 1, "activate")
        click := ui.next()
        check(click == 1007, "click event " + click.to_string() + " text " + ui.event_text().unwrap_or("?"))
        check(text_of(&ui).is_empty(), "click carries no text")
        typed := cstring(&"Ana María")
        gtk_editable_set_text(name, typed.as_ptr())
        // GTK reports the replacement as a deletion, then an insertion.
        check(ui.next() == 1009, "entry event")
        print(text_of(&ui))
        check(ui.next() == 1009, "entry event")
        check(text_of(&ui).eq(&"Ana María"), "entry snapshot")
    }
    check(ui.set_input(&"name", &"Modelo") == 0, "set_input")
    check(ui.set_input(&"note", &"x") == 1, "set_input label")
    check(ui.set_enabled(&"go", false) == 0, "disable")
    check(ui.show_page(&"other") == 0, "navigate")
    check(ui.show_page(&"home") == 0, "navigate back")
    check(ui.request_close() == 0, "close")
    // set_input queued nothing: the next event is the close.
    check(ui.next() == 2, "closed without model echoes")
    check(ui.release() == 0, "release")
    unsafe {
        for gtk.g_main_context_iteration(ffi.null(), 0) != 0 {}
        check(ffi.read(ffi.of(&gone)) == 3, "widgets finalized: " + gone.to_string())
    }
    print("components ok")
}

fn match_open() native.Native {
    match native.create(&"Componentes", &"Componentes en Tarn") {
        Ok(value) => { return value }
        Err(code) => { panic("create failed: " + code.to_string()) }
    }
}

fn text_of(ui &native.Native) string { return ui.event_text().expect("no event text") }
fn cstring(text &string) ffi.CString { return ffi.CString.new(text).expect("NUL") }
