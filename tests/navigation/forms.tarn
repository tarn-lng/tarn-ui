import "core/forms"
fn check(value bool) { if !value { panic("form assertion failed") } }
fn main() {
    var form = forms.NameForm.new()
    check(!form.can_submit() && !form.submit())
    form.edit(&"   ")
    check(!form.can_submit() && !form.submit())
    form.edit(&"  Ana María  ")
    check(form.can_submit() && form.name().is_empty())
    check(form.submit() && form.name().eq(&"Ana María"))
    check(!form.can_submit() && !form.submit())
    form.edit(&"Luis")
    check(form.can_submit() && form.name().eq(&"Ana María"))
    form.edit(&"")
    check(!form.can_submit() && !form.submit() && form.name().eq(&"Ana María"))
    form.edit(&" Ana María ")
    check(!form.can_submit())
    check(form.can_reset())
    form.reset()
    check(!form.can_reset() && form.value().eq(&"Ana María"))
    form.edit(&"Luis")
    form.reset()
    check(form.value().eq(&"Ana María") && !form.can_submit())
    var empty = forms.NameForm.new()
    empty.edit(&"texto sin guardar")
    empty.reset()
    check(empty.value().is_empty() && empty.name().is_empty() && !empty.can_reset())
    print("PASS validation, draft/commit, Unicode, duplicate submission and invalid draft")
}
