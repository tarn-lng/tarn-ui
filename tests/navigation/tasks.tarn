import "tasks"
fn check(value bool) { if !value { panic("keyed list model assertion failed") } }
fn main() {
    var model = tasks.Model.new()
    model.reduce(9, &"")
    check(model.count() == 0)
    model.reduce(8, &"Primero")
    model.reduce(9, &"")
    model.reduce(8, &"Segundo")
    model.reduce(9, &"")
    check(model.count() == 2)
    initial := model.items()
    check(initial.as_slice()[0].key.eq(&"task-1") && initial.as_slice()[1].key.eq(&"task-2"))
    model.reduce(102, &"")
    model.reduce(11, &"")
    moved := model.items()
    check(moved.as_slice()[0].key.eq(&"task-2") && moved.as_slice()[1].key.eq(&"task-1"))
    model.reduce(8, &"Editado")
    model.reduce(12, &"")
    edited := model.items()
    check(edited.as_slice()[0].key.eq(&"task-2") && edited.as_slice()[0].text.eq(&"✓ Editado"))
    model.reduce(10, &"")
    model.reduce(102, &"")
    check(model.count() == 1 && model.selected_id() == 0)
    model.reduce(8, &"Tercero")
    model.reduce(9, &"")
    final_items := model.items()
    check(final_items.as_slice()[1].key.eq(&"task-3"))
    for model.count() < 32 { model.reduce(8, &"Elemento")
        model.reduce(9, &"") }
    model.reduce(9, &"")
    check(model.count() == 32 && !model.can_add())
    model.reduce(14, &"")
    opened := model.region()
    check(opened.children.len() == 2)
    model.reduce(15, &"Nota persistente")
    model.reduce(17, &"")
    closed := model.region()
    check(closed.children.len() == 1)
    model.reduce(14, &"")
    reopened := model.region()
    check(reopened.children.len() == 2)
    print("PASS stable IDs, reorder, edit, removal, stale action and bounded model")
}
