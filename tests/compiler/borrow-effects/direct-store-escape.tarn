fn store(out &mut Option<&i64>, value &i64) {
    *out = Some(value)
}
fn scoped(out &mut Option<&i64>) {
    local: i64 := 42
    // Compile-fail: helper attempts to retain a reference to this scoped local.
    store(out, &local)
}
fn main() {
    var saved: Option<&i64> = None
    scoped(&mut saved)
    match saved {
        Some(value) => { print(value) }
        None => {}
    }
}
